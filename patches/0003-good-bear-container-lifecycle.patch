+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+const {
+  GOOD_BEAR_RUSSIAN_PKI_CONTAINER_PURPOSE,
+  GoodBearRussianPKIContainerManager,
+} = ChromeUtils.importESModule(
+  "resource:///modules/GoodBearRussianPKIContainer.sys.mjs"
+);
+
+const TEST_STORE_FILE_PATH = PathUtils.join(
+  PathUtils.tempDir,
+  `goodbear-container-${Services.uuid.generateUUID()}.json`
+);
+
+add_task(
+  async function test_managed_russian_pki_container_uses_native_identity() {
+    await SpecialPowers.pushPrefEnv({
+      set: [["privacy.userContext.enabled", true]],
+    });
+
+    const identityService =
+      ContextualIdentityService.createNewInstanceForTesting(
+        TEST_STORE_FILE_PATH
+      );
+    const manager = new GoodBearRussianPKIContainerManager(identityService);
+    registerCleanupFunction(async () => {
+      manager.stop();
+      for (const identity of identityService.getPublicIdentities()) {
+        if (
+          identity.managedPurpose === GOOD_BEAR_RUSSIAN_PKI_CONTAINER_PURPOSE
+        ) {
+          identityService.remove(identity.userContextId);
+        }
+      }
+      await IOUtils.remove(TEST_STORE_FILE_PATH, { ignoreAbsent: true });
+    });
+
+    const container = manager.start();
+    ok(container, "managed container is created");
+    is(
+      container.managedPurpose,
+      GOOD_BEAR_RUSSIAN_PKI_CONTAINER_PURPOSE,
+      "stable technical purpose is stored with the native identity"
+    );
+    Assert.greater(
+      container.userContextId,
+      0,
+      "a real non-default userContextId is used"
+    );
+    const localizedName = new Localization(
+      ["browser/browser.ftl"],
+      true
+    ).formatValueSync("urlbar-goodbear-russian-pki-container-label");
+    is(
+      container.name,
+      localizedName,
+      "visible name comes from the active Fluent locale"
+    );
+
+    const scopeAuthority = Cc["@mozilla.org/psm;1"].getService(
+      Ci.nsINSSComponent
+    );
+    is(
+      typeof scopeAuthority.setGoodBearRussianPKIContainerId,
+      "function",
+      "the native Russian PKI scope publication API is exposed to JavaScript"
+    );
+    ok(
+      scopeAuthority.isGoodBearRussianPKIContainer(
+        container.userContextId,
+        false
+      ),
+      "the native scope authority recognizes the published managed container"
+    );
+
+    const tab = BrowserTestUtils.addTab(gBrowser, "about:blank", {
+      userContextId: container.userContextId,
+    });
+    const browser = gBrowser.getBrowserForTab(tab);
+    is(
+      browser.contentPrincipal.userContextId,
+      container.userContextId,
+      "tab origin attributes carry the managed container userContextId"
+    );
+    BrowserTestUtils.removeTab(tab);
+
+    identityService.update(
+      container.userContextId,
+      "ordinary-looking name",
+      "cart",
+      "red"
+    );
+    const repaired = manager.ensureContainer();
+    is(repaired.userContextId, container.userContextId, "repair keeps the ID");
+    is(
+      repaired.name,
+      localizedName,
+      "managed localized presentation is repaired"
+    );
+    is(repaired.icon, "fence", "managed icon is repaired");
+    is(repaired.color, "gray", "neutral managed color is repaired");
+
+    ok(
+      identityService.remove(container.userContextId),
+      "simulated user-visible removal succeeds"
+    );
+    const replacement = manager.ensureContainer();
+    ok(replacement, "the manager recreates a removed managed container");
+    isnot(
+      replacement.userContextId,
+      container.userContextId,
+      "replacement gets a new real userContextId"
+    );
+    ok(
+      !identityService.getPublicIdentityFromId(container.userContextId),
+      "stale ID no longer names a container"
+    );
+    is(
+      manager.getScopeSnapshot().userContextId,
+      replacement.userContextId,
+      "the authoritative snapshot publishes only the replacement ID"
+    );
+  }
+);
+
+add_task(async function test_ambiguous_managed_purpose_fails_closed() {
+  const identityService = ContextualIdentityService.createNewInstanceForTesting(
+    `${TEST_STORE_FILE_PATH}.ambiguous`
+  );
+  const manager = new GoodBearRussianPKIContainerManager(identityService);
+  registerCleanupFunction(async () => {
+    manager.stop();
+    await IOUtils.remove(`${TEST_STORE_FILE_PATH}.ambiguous`, {
+      ignoreAbsent: true,
+    });
+  });
+
+  identityService.createManagedIdentity(
+    "Российская PKI",
+    "fence",
+    "gray",
+    GOOD_BEAR_RUSSIAN_PKI_CONTAINER_PURPOSE
+  );
+  identityService.createManagedIdentity(
+    "Российская PKI",
+    "fence",
+    "gray",
+    GOOD_BEAR_RUSSIAN_PKI_CONTAINER_PURPOSE
+  );
+
+  is(manager.start(), null, "ambiguous purpose is not selected");
+  is(
+    manager.getScopeSnapshot(),
+    null,
+    "ambiguous state supplies no authorization snapshot"
+  );
+});
+
+// Prepared native restore regressions. These use only the mochitest profile and
+// public test URLs; actual restart/crash acceptance is a separate release gate.
+add_task(async function test_session_restore_preserves_real_container_ids() {
+  const { SessionStore } = ChromeUtils.importESModule(
+    "moz-src:///browser/components/sessionstore/SessionStore.sys.mjs"
+  );
+  const { TabStateFlusher } = ChromeUtils.importESModule(
+    "moz-src:///browser/components/sessionstore/TabStateFlusher.sys.mjs"
+  );
+  const { GoodBearRussianPKIContainer } = ChromeUtils.importESModule(
+    "resource:///modules/GoodBearRussianPKIContainer.sys.mjs"
+  );
+  const { GoodBearRussianPKIStartup } = ChromeUtils.importESModule(
+    "resource:///modules/BrowserGlue.sys.mjs"
+  );
+  await SpecialPowers.pushPrefEnv({
+    set: [
+      ["privacy.userContext.enabled", true],
+      ["security.goodbear.russian_pki.enabled", true],
