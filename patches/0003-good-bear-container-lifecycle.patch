+async function withTransitionManager(callback) {
+  const basePath = PathUtils.join(
+    PathUtils.tempDir,
+    `goodbear-trust-change-${Services.uuid.generateUUID()}`
+  );
+  const assignmentPath = `${basePath}.assignments`;
+  const identityPath = `${basePath}.identities`;
+  const historyPath = `${basePath}.history`;
+  const assignments = new GoodBearRussianPKIAssignmentStore(assignmentPath);
+  const history = new GoodBearRussianPKITrustHistoryStore(historyPath);
+  const identityService =
+    ContextualIdentityService.createNewInstanceForTesting(identityPath);
+  const manager = new GoodBearRussianPKIContainerManager(
+    identityService,
+    new FakeScopeAuthority(),
+    assignments,
+    history
+  );
+  await manager.initialize();
+  try {
+    await callback({ assignments, history, manager });
+  } finally {
+    manager.stop();
+    await Promise.all(
+      [assignmentPath, identityPath, historyPath].map(path =>
+        IOUtils.remove(path, { ignoreAbsent: true })
+      )
+    );
+  }
+}
