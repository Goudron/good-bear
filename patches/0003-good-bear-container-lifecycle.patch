+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+const {
+  GoodBearRussianPKIAssignmentStore,
+  GoodBearRussianPKIContainerManager,
+  GoodBearRussianPKITrustDomain,
+  GoodBearRussianPKITrustHistoryStore,
+  GoodBearRussianPKITrustTransition,
+} = ChromeUtils.importESModule(
+  "resource:///modules/GoodBearRussianPKIContainer.sys.mjs"
+);
+
+const TEST_STORE_FILE_PATH = PathUtils.join(
+  PathUtils.tempDir,
+  `goodbear-trust-history-${Services.uuid.generateUUID()}.json`
+);
+
+/**
+ * Provides the container-manager publication boundary without PSM state.
+ */
+class FakeScopeAuthority {
+  setGoodBearRussianPKIContainerId() {
+    return true;
+  }
+
+  clearGoodBearRussianPKIContainerId() {}
+}
+
+add_task(async function test_minimal_trust_history_survives_restart() {
+  registerCleanupFunction(() =>
+    IOUtils.remove(TEST_STORE_FILE_PATH, { ignoreAbsent: true })
+  );
+
+  const history = new GoodBearRussianPKITrustHistoryStore(TEST_STORE_FILE_PATH);
+  ok(
+    await history.recordConfirmed(
+      "https://Example.TEST/path?must=not-persist",
+      GoodBearRussianPKITrustDomain.Standard
+    ),
+    "a STANDARD observation is stored"
+  );
+  ok(
+    await history.recordConfirmed(
+      "https://example.test/next",
+      GoodBearRussianPKITrustDomain.RussianPKI
+    ),
+    "a later Russian PKI observation is stored"
+  );
+
+  const reloaded = new GoodBearRussianPKITrustHistoryStore(
+    TEST_STORE_FILE_PATH
+  );
+  ok(await reloaded.load(), "trust history survives a new store instance");
+  const entry = reloaded.get("https://example.test:443/another-path");
+  is(entry.scheme, "https", "only the canonical scheme is retained");
+  is(entry.host, "example.test", "only the canonical host is retained");
+  is(entry.port, 443, "only the effective port is retained");
+  is(
+    entry.lastConfirmedDomain,
+    GoodBearRussianPKITrustDomain.RussianPKI,
+    "the final confirmed trust domain is retained"
+  );
+  is(
+    entry.lastTransition,
+    GoodBearRussianPKITrustTransition.StandardToRussianPKI,
+    "only the domain transition metadata is retained"
+  );
+  is(reloaded.entries().length, 1, "one exact origin is retained");
+  ok(
+    await reloaded.clear("https://example.test/"),
+    "one exact history entry can be cleared"
+  );
+  is(
+    reloaded.get("https://example.test/"),
+    null,
+    "the cleared entry is absent"
+  );
+});
+
+add_task(async function test_corrupt_or_extra_trust_history_fails_closed() {
+  registerCleanupFunction(() =>
+    IOUtils.remove(TEST_STORE_FILE_PATH, { ignoreAbsent: true })
+  );
+  await IOUtils.writeJSON(
+    TEST_STORE_FILE_PATH,
+    {
+      version: 1,
+      history: [
+        {
+          scheme: "https",
+          host: "example.test",
+          port: 443,
+          lastConfirmedDomain: "RUSSIAN_PKI",
+          lastTransition: "INITIAL_RUSSIAN_PKI",
+          leafFingerprint: "must-not-be-accepted",
+        },
+      ],
+    },
+    { tmpPath: `${TEST_STORE_FILE_PATH}.tmp` }
+  );
+
+  const history = new GoodBearRussianPKITrustHistoryStore(TEST_STORE_FILE_PATH);
+  ok(!(await history.load()), "an extra certificate field rejects all history");
+  is(history.entries().length, 0, "corrupt history exposes no entry");
+  const nonTlsOrigin = new URL("https://example.test/");
+  nonTlsOrigin.protocol = "http:";
+  ok(
+    !(await history.recordConfirmed(
+      nonTlsOrigin.href,
+      GoodBearRussianPKITrustDomain.Standard
+    )),
+    "a non-HTTPS origin cannot be recorded"
+  );
+  ok(
+    !(await history.recordConfirmed("https://example.test/", "INVALID")),
+    "INVALID never becomes a confirmed trust-domain record"
+  );
+});
+
+add_task(async function test_history_has_no_routing_or_trust_authority() {
+  const assignmentPath = `${TEST_STORE_FILE_PATH}.assignments`;
+  const identityPath = `${TEST_STORE_FILE_PATH}.identities`;
+  registerCleanupFunction(async () => {
+    await IOUtils.remove(TEST_STORE_FILE_PATH, { ignoreAbsent: true });
+    await IOUtils.remove(assignmentPath, { ignoreAbsent: true });
+    await IOUtils.remove(identityPath, { ignoreAbsent: true });
+  });
+
+  const history = new GoodBearRussianPKITrustHistoryStore(TEST_STORE_FILE_PATH);
+  ok(
+    await history.recordConfirmed(
+      "https://history-only.example.test/",
+      GoodBearRussianPKITrustDomain.RussianPKI
+    ),
+    "a Russian PKI history observation exists"
+  );
+  const assignments = new GoodBearRussianPKIAssignmentStore(assignmentPath);
+  const identityService =
+    ContextualIdentityService.createNewInstanceForTesting(identityPath);
+  const manager = new GoodBearRussianPKIContainerManager(
+    identityService,
+    new FakeScopeAuthority(),
+    assignments,
+    history
+  );
+  registerCleanupFunction(() => manager.stop());
+  await manager.initialize();
+
+  is(
+    manager.trustHistoryStore.get("https://history-only.example.test/")
+      .lastConfirmedDomain,
+    GoodBearRussianPKITrustDomain.RussianPKI,
+    "the manager restores local history without treating it as a grant"
+  );
+
+  is(
+    manager.resolveUserContextIdForLoad(
+      "https://history-only.example.test/",
+      0
+    ),
+    0,
+    "history alone never creates a container assignment"
+  );
+  ok(
+    !assignments.isAssigned("https://history-only.example.test/"),
+    "history alone never grants routing authority"
+  );
+});
