+    const previous = this._assignments;
+    this._assignments = new Map();
+    try {
+      await this._write();
+      return true;
+    } catch (error) {
+      this._assignments = previous;
+      console.error("Could not clear Good Bear Russian PKI assignments", error);
+      return false;
+    }
+  }
+
+  _write() {
+    const serialized = {
+      version: ASSIGNMENTS_SCHEMA_VERSION,
+      assignments: [...this._assignments.values()]
+        .map(assignment => ({ ...assignment }))
+        .sort((left, right) =>
+          assignmentKey(left).localeCompare(assignmentKey(right))
+        ),
+    };
+
+    this._writeQueue = this._writeQueue
+      .catch(() => {})
+      .then(() =>
+        IOUtils.writeJSON(this._filePath, serialized, {
+          tmpPath: `${this._filePath}.tmp`,
+        })
+      )
+      .then(() => this._publishRuntimeAssignments());
+    return this._writeQueue;
+  }
+
+  _publishRuntimeAssignments() {
+    const origins = [...this._assignments.values()]
+      .map(({ host, port }) => `${host}:${port}`)
+      .sort();
+    const originKeys = origins.join("\n");
+    Services.prefs.setStringPref(ASSIGNMENTS_RUNTIME_PREF, originKeys);
+    getScopeAuthority()?.setGoodBearRussianPKIAssignedOrigins(originKeys);
+  }
+}
+
+/**
+ * Maintains the native contextual identity that scopes Russian PKI trust.
+ */
+export class GoodBearRussianPKIContainerManager {
+  constructor(
+    identityService = ContextualIdentityService,
+    scopeAuthority = getScopeAuthority(),
+    assignmentStore = new GoodBearRussianPKIAssignmentStore(),
+    trustHistoryStore = new GoodBearRussianPKITrustHistoryStore()
+  ) {
+    this._identityService = identityService;
+    this._scopeAuthority = scopeAuthority;
+    this._assignmentStore = assignmentStore;
+    this._trustHistoryStore = trustHistoryStore;
+    this._dedicatedUserContextId = null;
+    this._started = false;
+    // Every operation that changes the paired local routing state uses this
+    // queue. It prevents a reset from racing a completed TLS observation into
+    // a state where history and assignment refer to different decisions.
+    this._routingTransactionQueue = Promise.resolve();
+  }
+
+  start() {
+    if (!this._started) {
+      Services.obs.addObserver(this, CONTAINER_DELETED_TOPIC);
+      Services.prefs.addObserver(ENABLED_PREF, this);
+      this._started = true;
+    }
+    return this.ensureContainer();
+  }
+
+  async initialize() {
+    const container = this.start();
+    await Promise.all([
+      this._assignmentStore.load(),
+      this._trustHistoryStore.load(),
+    ]);
+    return container;
+  }
+
+  stop() {
+    // Revoke first: observer teardown failure must not retain a partial startup
+    // publication or let a restored request capture that obsolete authority.
+    this._dedicatedUserContextId = null;
+    this._clearPublishedContainer();
+    if (this._started) {
+      this._started = false;
+      Services.obs.removeObserver(this, CONTAINER_DELETED_TOPIC);
+      Services.prefs.removeObserver(ENABLED_PREF, this);
+    }
+  }
+
+  observe(subject, topic, data) {
+    // A queued notification or failed observer teardown cannot restart a stopped
+    // manager after partial initialization or shutdown.
+    if (!this._started) {
+      return;
+    }
+    if (topic === PREF_CHANGED_TOPIC && data === ENABLED_PREF) {
+      if (!this._isEnabled()) {
+        this._dedicatedUserContextId = null;
+        this._clearPublishedContainer();
+        return;
+      }
+      this.ensureContainer();
+      return;
+    }
+
+    if (topic !== CONTAINER_DELETED_TOPIC) {
+      return;
+    }
+    const deletedId = subject?.wrappedJSObject?.userContextId;
+    if (deletedId === this._dedicatedUserContextId) {
+      // `remove` has already cleared state for the deleted OriginAttributes.
+      // The replacement necessarily gets a different userContextId, making
+      // stale in-flight IDs fail closed when the scope authority rechecks it.
+      this._dedicatedUserContextId = null;
+      this._clearPublishedContainer();
+      this.ensureContainer();
+    }
+  }
+
+  get dedicatedUserContextId() {
+    return this._dedicatedUserContextId;
+  }
+
+  get assignmentStore() {
+    return this._assignmentStore;
+  }
+
+  get trustHistoryStore() {
+    return this._trustHistoryStore;
+  }
+
+  get routingStateLoaded() {
+    return this._assignmentStore.isLoaded && this._trustHistoryStore.isLoaded;
+  }
+
+  /**
+   * Records a successful ordinary native STANDARD response as metadata.
+   *
+   * @param {string|nsIURI} origin - Exact successfully loaded HTTPS origin.
+   * @param {string} domain - Immutable successful native trust-domain value.
+   */
+  async recordOrdinaryStandardObservation(origin, domain) {
+    return this._runRoutingTransaction(() =>
+      this._recordOrdinaryStandardObservation(origin, domain)
+    );
+  }
+
+  async _recordOrdinaryStandardObservation(origin, domain) {
+    if (
+      domain !== GoodBearRussianPKITrustDomain.Standard ||
+      !this._isEnabled()
+    ) {
+      return false;
+    }
+    await Promise.all([
+      this._assignmentStore.load(),
+      this._trustHistoryStore.load(),
+    ]);
+    const previous = this._trustHistoryStore.get(origin);
+    if (
+      this._assignmentStore.isAssigned(origin) ||
+      (previous &&
+        previous.lastConfirmedDomain !== GoodBearRussianPKITrustDomain.Standard)
+    ) {
+      return false;
+    }
+    return this._trustHistoryStore.recordConfirmed(origin, domain);
+  }
+
+  /**
+   * Commits the first completed Russian PKI visit as one routing decision.
+   *
+   * The caller must have obtained `domain` directly from a successful native
+   * TLS result in the managed container.  Neither existing history nor an
+   * assignment authorizes this operation: the method is only for an unknown
+   * origin, and storage failures leave no usable assignment behind.
+   *
+   * @param {string|nsIURI} origin - Candidate exact HTTPS origin.
+   * @param {string} domain - Immutable successful native trust-domain value.
+   */
+  async completeFirstVisitRussianPKIAssignment(origin, domain) {
+    return this._runRoutingTransaction(() =>
+      this._completeFirstVisitRussianPKIAssignment(origin, domain)
+    );
+  }
+
+  async _completeFirstVisitRussianPKIAssignment(origin, domain) {
+    if (
+      domain !== GoodBearRussianPKITrustDomain.RussianPKI ||
+      !this._isEnabled() ||
+      !this._dedicatedUserContextId
+    ) {
+      return false;
+    }
+
+    await Promise.all([
+      this._assignmentStore.load(),
+      this._trustHistoryStore.load(),
+    ]);
+    if (
+      this._assignmentStore.isAssigned(origin) ||
+      this._trustHistoryStore.get(origin)
+    ) {
+      return false;
+    }
+
+    // Persist the observation first. It has no routing or trust authority, so
+    // a write failure cannot leave an origin isolated. If the following
+    // assignment write fails, best-effort rollback returns this exact origin
+    // to its prior unknown state; regardless of rollback outcome it never
+    // becomes a usable assignment.
+    if (!(await this._trustHistoryStore.recordConfirmed(origin, domain))) {
+      return false;
+    }
+    if (await this._assignmentStore.assign(origin)) {
+      return true;
+    }
+
+    await this._trustHistoryStore.clear(origin);
+    return false;
+  }
+
+  /**
+   * Commits a user-confirmed STANDARD -> RUSSIAN_PKI transition.
+   *
+   * The caller must pair explicit consent with a successful native Russian
+   * PKI result from the newly-created managed browsing context. History is
+   * only a precondition here: it never authorizes trust or routing by itself.
+   * If either profile write fails, no usable assignment is retained.
+   *
+   * @param {string|nsIURI} origin - Exact HTTPS origin that was confirmed.
+   * @param {string} domain - Immutable successful native trust-domain value.
+   */
+  async completeConfirmedStandardToRussianPKIAssignment(origin, domain) {
+    return this._runRoutingTransaction(() =>
+      this._completeConfirmedStandardToRussianPKIAssignment(origin, domain)
+    );
+  }
+
+  async _completeConfirmedStandardToRussianPKIAssignment(origin, domain) {
+    if (
+      domain !== GoodBearRussianPKITrustDomain.RussianPKI ||
+      !this._isEnabled() ||
+      !this._dedicatedUserContextId
+    ) {
+      return false;
+    }
+
+    await Promise.all([
+      this._assignmentStore.load(),
+      this._trustHistoryStore.load(),
+    ]);
+    const previous = this._trustHistoryStore.get(origin);
+    if (
+      this._assignmentStore.isAssigned(origin) ||
+      previous?.lastConfirmedDomain !== GoodBearRussianPKITrustDomain.Standard
+    ) {
+      return false;
+    }
+
+    // History has no routing authority, so persist the transition first. The
+    // authoritative assignment is published only after history succeeds; a
+    // failed assignment restores the exact prior STANDARD entry.
+    if (
+      !(await this._trustHistoryStore.recordConfirmed(
+        origin,
+        GoodBearRussianPKITrustDomain.RussianPKI
+      ))
+    ) {
+      return false;
+    }
+    if (await this._assignmentStore.assign(origin)) {
+      return true;
+    }
+
+    await this._trustHistoryStore._restoreForFailedTransaction(
+      origin,
+      previous
+    );
+    return false;
+  }
+
+  /**
+   * Removes one exact-origin routing assignment and its non-authoritative
+   * history together. The next visit must be classified as a new visit, so
+   * stale STANDARD or RUSSIAN_PKI history cannot affect it.
+   *
+   * The stores are separate profile files. History is cleared first because
+   * it never grants routing; if the authoritative assignment write fails,
+   * the exact history entry is restored before reporting failure.
+   *
+   * @param {string|nsIURI} origin - Exact HTTPS origin being reset.
+   */
+  async resetAssignment(origin) {
+    return this._runRoutingTransaction(async () => {
+      await Promise.all([
+        this._assignmentStore.load(),
+        this._trustHistoryStore.load(),
+      ]);
+      const previousHistory = this._trustHistoryStore.get(origin);
+      const hadAssignment = this._assignmentStore.isAssigned(origin);
+      if (!previousHistory && !hadAssignment) {
+        return false;
+      }
+
+      if (previousHistory && !(await this._trustHistoryStore.clear(origin))) {
+        return false;
+      }
+      if (!hadAssignment || (await this._assignmentStore.clear(origin))) {
+        return true;
+      }
+
+      if (
+        !(await this._trustHistoryStore._restoreForFailedTransaction(
+          origin,
+          previousHistory
+        ))
+      ) {
+        console.error(
+          "Could not restore Good Bear Russian PKI history after assignment reset failure"
+        );
+      }
+      return false;
+    });
+  }
+
+  /**
+   * Removes all routing assignments and all routing observations as one
+   * logical reset. A failed assignment persistence step restores the complete
+   * history snapshot, leaving every origin on its pre-reset routing path.
+   */
+  async resetAllAssignments() {
+    return this._runRoutingTransaction(async () => {
+      await Promise.all([
+        this._assignmentStore.load(),
+        this._trustHistoryStore.load(),
+      ]);
+      const previousHistory = this._trustHistoryStore.entries();
+      const hasAssignments = !!this._assignmentStore.assignments().length;
+      if (!previousHistory.length && !hasAssignments) {
+        return true;
+      }
+
+      if (
+        previousHistory.length &&
+        !(await this._trustHistoryStore.clearAll())
+      ) {
+        return false;
+      }
+      if (!hasAssignments || (await this._assignmentStore.clearAll())) {
+        return true;
+      }
+
+      if (
+        previousHistory.length &&
+        !(await this._trustHistoryStore._restoreAllForFailedTransaction(
+          previousHistory
+        ))
+      ) {
+        console.error(
+          "Could not restore Good Bear Russian PKI history after full assignment reset failure"
+        );
+      }
+      return false;
+    });
+  }
+
+  _runRoutingTransaction(operation) {
+    const result = this._routingTransactionQueue.then(operation, operation);
+    this._routingTransactionQueue = result.catch(() => {});
+    return result;
+  }
+
+  resolveUserContextIdForLoad(
+    origin,
+    currentUserContextId = 0,
+    isPrivateBrowsing = false
+  ) {
+    if (
+      isPrivateBrowsing ||
+      currentUserContextId !== 0 ||
+      !this._isEnabled() ||
+      !this._dedicatedUserContextId ||
+      !this._assignmentStore.isAssigned(origin)
+    ) {
+      return currentUserContextId;
+    }
+    return this._dedicatedUserContextId;
+  }
+
+  getLoadDecision(
+    origin,
+    currentUserContextId = 0,
+    { isPrivateBrowsing = false, hasRequestBody = false } = {}
+  ) {
+    const userContextId = this.resolveUserContextIdForLoad(
+      origin,
+      currentUserContextId,
+      isPrivateBrowsing
+    );
+    if (userContextId === currentUserContextId) {
+      return Object.freeze({
+        type: GoodBearRussianPKILoadDecision.Ordinary,
+        userContextId,
+      });
+    }
+
+    return Object.freeze({
+      type: hasRequestBody
+        ? GoodBearRussianPKILoadDecision.BodyBlocked
+        : GoodBearRussianPKILoadDecision.Isolated,
+      userContextId,
+    });
+  }
+
+  getScopeSnapshot() {
+    return this._dedicatedUserContextId === null
+      ? null
+      : Object.freeze({
+          purpose: GOOD_BEAR_RUSSIAN_PKI_CONTAINER_PURPOSE,
+          userContextId: this._dedicatedUserContextId,
+        });
+  }
+
+  ensureContainer() {
+    // Never leave a previous runtime ID authorized while validating profile
+    // state. Any failure below therefore remains fail-closed.
+    this._dedicatedUserContextId = null;
+    this._clearPublishedContainer();
+
+    if (!this._isEnabled()) {
+      return null;
+    }
+
+    let name;
+    try {
+      name = new Localization(["browser/browser.ftl"], true).formatValueSync(
+        "urlbar-goodbear-russian-pki-container-label"
+      );
+    } catch {
+      return null;
+    }
+    if (typeof name !== "string" || !name.trim()) {
+      return null;
+    }
+
+    const matches = this._identityService
+      .getPublicIdentities()
+      .filter(isUsableManagedIdentity);
+
+    // A corrupt profile that claims the managed purpose twice is ambiguous.
+    // Do not select one, do not erase a possibly user-owned identity, and do
+    // not fall back to the ordinary context.
+    if (matches.length > 1) {
+      return null;
+    }
+
+    if (matches.length === 1) {
+      const identity = matches[0];
+      this._repairPresentation(identity, name);
+      const repairedIdentity = this._identityService.getPublicIdentityFromId(
+        identity.userContextId
+      );
+      return this._publishValidatedContainer(repairedIdentity);
+    }
+
+    const identity = this._identityService.createManagedIdentity(
+      name,
+      CONTAINER_ICON,
+      CONTAINER_COLOR,
+      GOOD_BEAR_RUSSIAN_PKI_CONTAINER_PURPOSE
+    );
+    return this._publishValidatedContainer(identity);
+  }
+
+  _repairPresentation(identity, name) {
+    if (
+      identity.name !== name ||
+      identity.icon !== CONTAINER_ICON ||
+      identity.color !== CONTAINER_COLOR
+    ) {
+      this._identityService.update(
+        identity.userContextId,
+        name,
+        CONTAINER_ICON,
+        CONTAINER_COLOR
+      );
+    }
+  }
+
+  _isEnabled() {
+    return Services.prefs.getBoolPref(ENABLED_PREF, true);
+  }
+
+  _clearPublishedContainer() {
+    try {
+      this._scopeAuthority?.clearGoodBearRussianPKIContainerId();
+    } catch (error) {
+      console.error("Could not clear Good Bear Russian PKI scope", error);
+    }
+  }
+
+  _publishValidatedContainer(identity) {
+    if (!isUsableManagedIdentity(identity)) {
+      return null;
+    }
+    try {
+      if (
+        !this._scopeAuthority?.setGoodBearRussianPKIContainerId(
+          identity.userContextId
+        )
+      ) {
+        return null;
+      }
+    } catch (error) {
+      console.error("Could not publish Good Bear Russian PKI scope", error);
+      return null;
+    }
+    this._dedicatedUserContextId = identity.userContextId;
+    return identity;
+  }
+}
+
+export const GoodBearRussianPKIContainer =
+  new GoodBearRussianPKIContainerManager();
