+        "https://expired.example.com/"
+      );
+      await errorLoaded;
+      const certificates = await SpecialPowers.spawn(browser, [], () =>
+        content.docShell.failedChannel.securityInfo.handshakeCertificates.map(
+          cert => cert.getBase64DERString()
+        )
+      );
+      ok(
+        certificates.length,
+        "the native failed TLS channel has actual handshake certificates"
+      );
+      const windowGlobal = browser.browsingContext.currentWindowGlobal;
+      const surface = await openGoodBearInterstitial(browser, {
+        viewCertificate: async isCurrent => {
+          ok(isCurrent(), "the original document is current before viewing");
+          windowGlobal.getActor("NetError").viewCertificate(certificates);
+        },
+      });
+      const newTab = BrowserTestUtils.waitForNewTab(gBrowser, null, true);
+      EventUtils.synthesizeMouseAtCenter(
+        surface.doc.getElementById("goodbear-interstitial-certificate"),
+        {},
+        surface.doc.defaultView
+      );
+      certificateTab = await newTab;
+      ok(
+        certificateTab.linkedBrowser.currentURI.spec.startsWith(
+          "about:certificate?"
+        ),
+        "the existing native certificate viewer is shown"
+      );
+      await surface.pending;
+      Assert.deepEqual(
+        surface.calls,
+        [],
+        "viewing a real handshake chain creates no site consent"
+      );
+      await BrowserTestUtils.switchTab(gBrowser, tab);
+      Assert.deepEqual(
+        surface.calls,
+        [],
+        "returning to the stopped source does not revive consent"
+      );
+    } finally {
+      if (certificateTab) {
+        BrowserTestUtils.removeTab(certificateTab);
+      }
+      BrowserTestUtils.removeTab(tab);
+      await SpecialPowers.popPrefEnv();
+    }
+  }
+);
