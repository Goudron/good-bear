+async function openGoodBearInterstitial(browser, options = {}) {
+  const calls = [];
+  const pending = GoodBearRussianPKIInterstitial.open(browser, {
+    userContextId: GoodBearRussianPKIContainer.dedicatedUserContextId,
+    hasRequestBody: true,
+    trustSourceChanged: true,
+    onChoice(choice, isCurrent) {
+      ok(isCurrent(), "consent is current at the actual action boundary");
+      calls.push(choice);
+    },
+    ...options,
+  });
+  const manager = gBrowser.getTabDialogBox(browser).getTabDialogManager();
+  await TestUtils.waitForCondition(
+    () =>
+      manager._dialogs
+        .at(-1)
+        ?._frame?.contentDocument?.getElementById("goodbear-interstitial-back")
+        ?.disabled === false,
+    "the actual tab-scoped chrome interstitial is localized and ready"
+  );
+  const dialog = manager._dialogs.at(-1);
+  return { pending, dialog, doc: dialog._frame.contentDocument, calls };
+}
