+add_task(async function test_actual_address_transfer_rechecks_native_revocation() {
+  const pref = "security.goodbear.russian_pki.enabled";
+  const hadUserValue = Services.prefs.prefHasUserValue(pref);
+  const previous = Services.prefs.getBoolPref(pref);
+  Services.prefs.setBoolPref(pref, true);
+  const manager = GoodBearRussianPKIContainer;
+  await manager.initialize();
+  const id = manager.ensureContainer()?.userContextId;
+  ok(id, "real managed identity is available");
+  const authority = Cc["@mozilla.org/psm;1"].getService(Ci.nsINSSComponent);
+  const policy = GoodBearRussianPKINavigationPolicy;
+  const original = policy._openLinkIn;
+  let opened = 0;
+  policy._openLinkIn = () => opened++;
+  try {
+    ok(authority.isGoodBearRussianPKIContainer(id, false));
+    authority.clearGoodBearRussianPKIContainerId();
+    policy._openAddressOnlyInContainer(window, gBrowser.selectedBrowser,
+      "https://revoked.example.test/", id, false);
+    is(opened, 0, "queued transfer cannot use a revoked native scope");
+    ok(authority.setGoodBearRussianPKIContainerId(id));
+    policy._openAddressOnlyInContainer(window, gBrowser.selectedBrowser,
+      "https://revoked.example.test/", id, false);
+    is(opened, 1, "fresh current authority permits address-only navigation");
+    Services.prefs.setBoolPref("security.goodbear.russian_pki.enabled", false);
+    policy._openAddressOnlyInContainer(window, gBrowser.selectedBrowser,
+      "https://revoked.example.test/", id, false);
+    is(opened, 1, "disablement prevents further transfer");
+    ok(!authority.isGoodBearRussianPKIContainer(id, false));
+  } finally {
+    policy._openLinkIn = original;
+    if (hadUserValue) {
+      Services.prefs.setBoolPref(pref, previous);
+    } else {
+      Services.prefs.clearUserPref(pref);
+    }
+    manager.ensureContainer();
+  }
+});
