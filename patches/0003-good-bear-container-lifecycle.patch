+// Session restoration can load its selected tab before idle startup. Resolve
+// profile identities and routing state first, without changing the saved tab ID.
+// The later idle-category call shares this promise and cannot revoke live leases.
+export const GoodBearRussianPKIStartup = {
+  _promise: null,
+
+  start() {
+    return (this._promise ??= this._initialize());
+  },
+
+  async _initialize() {
+    try {
+      await lazy.ContextualIdentityService.load();
+      if (Services.startup.shuttingDown) {
+        return;
+      }
+      await lazy.GoodBearRussianPKIContainer.initialize();
+      if (Services.startup.shuttingDown) {
+        lazy.GoodBearRussianPKIContainer.stop();
+        return;
+      }
+      GoodBearRussianPKINavigationPolicy.start();
+    } catch (error) {
+      // Initialization may have published an ID before a routing-store failure.
+      // Revoke that partial startup state; ordinary session restore still runs.
+      try {
+        lazy.GoodBearRussianPKIContainer.stop();
+      } catch (cleanupError) {
+        console.error("Could not stop Good Bear container startup", cleanupError);
+      }
+      throw error;
+    }
+  },
+};
