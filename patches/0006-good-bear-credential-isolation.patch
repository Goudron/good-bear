+  captureChannel(channel, authInfo, requestor) {
+    this.initialize();
+    const snapshot = this.#channelSnapshot(channel, authInfo, requestor);
+    const capability = Object.freeze({
+      kind: snapshot?.kind ?? GoodBearPasswordStoreKind.DENY,
