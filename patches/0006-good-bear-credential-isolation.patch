+/**
+ * Fixed-purpose vault persistence. General LoginStore/JSONFile recovery remains
+ * unchanged. A corrupt or orphaned vault is never renamed, restored into a
+ * different store, or overwritten with an empty database.
+ */
+export class GoodBearLoginStore extends LoginStore {
+  #loading = null;
+  #backup;
+
+  constructor() {
+    const profile = Services.dirsvc.get("ProfD", Ci.nsIFile).path;
+    const backup = PathUtils.join(profile, "goodbear-russian-pki-logins-backup.json");
+    super(
+      PathUtils.join(profile, "goodbear-russian-pki-logins.json"),
+      Services.prefs.getBoolPref("signon.backup.enabled") ? backup : ""
+    );
+    this.#backup = backup;
+  }
+
+  load() {
+    return (this.#loading ??= this.#load());
+  }
+
+  async #load() {
+    let data;
+    try {
+      data = await IOUtils.readJSON(this.path);
+    } catch (error) {
+      if (error.name !== "NotFoundError" || await IOUtils.exists(this.#backup)) {
+        throw new Error("Good Bear password vault cannot be loaded");
+      }
+      data = {
+        goodBearPurpose: "goodbear-russian-pki",
+        version: 3, nextId: 1, logins: [], potentiallyVulnerablePasswords: [],
+        goodBearDisabledHosts: [],
+      };
+    }
+    if (
+      data?.goodBearPurpose !== "goodbear-russian-pki" || data.version !== 3 ||
+      !Number.isSafeInteger(data.nextId) || data.nextId < 1 ||
+      !Array.isArray(data.logins) || !Array.isArray(data.potentiallyVulnerablePasswords) ||
+      !Array.isArray(data.goodBearDisabledHosts) ||
+      data.goodBearDisabledHosts.some(origin => typeof origin !== "string") ||
+      data.potentiallyVulnerablePasswords.some(item => typeof item?.encryptedPassword !== "string")
+    ) {
+      throw new Error("Invalid Good Bear password vault data");
+    }
+    const guids = new Set();
+    const ids = new Set();
+    for (const login of data.logins) {
+      if (
+        !login || login.deleted || login.everSynced || typeof login.guid !== "string" || !login.guid ||
+        guids.has(login.guid) || !Number.isSafeInteger(login.id) || login.id < 1 ||
+        ids.has(login.id) || login.id >= data.nextId ||
+        typeof login.hostname !== "string" ||
+        typeof login.encryptedUsername !== "string" ||
+        typeof login.encryptedPassword !== "string"
+      ) {
+        throw new Error("Invalid Good Bear password vault record");
+      }
+      guids.add(login.guid);
+      ids.add(login.id);
+    }
+    this._processLoadedData(data);
+    this.ensureDataReady();
+  }
+
+  ensureDataReady() {
+    if (!this.dataReady || this._finalizePromise) {
+      throw new Error("Good Bear password vault is not ready");
+    }
+  }
+
+  async _save() {
+    this.ensureDataReady();
+    // Use upstream atomic JSON writing and only this vault's backup path, but
+    // propagate failure instead of JSONFile's general recovery/logging path.
+    await IOUtils.writeJSON(this.path, this._data, {
+      ...this._options, tmpPath: this.path + ".tmp",
+    });
+    if (!this._data.logins.length) {
+      await IOUtils.remove(this.#backup, { ignoreAbsent: true });
+    }
+    Services.obs.notifyObservers(null, "goodbear-password-vault-written");
+  }
+}
