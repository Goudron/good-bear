@@ -0,0 +1,162 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Prepared Ubuntu browser test. Only harness tabs/profile and invented records.
+// No native execution was performed during source preparation.
+const { AppConstants } = ChromeUtils.importESModule(
+  "resource://gre/modules/AppConstants.sys.mjs"
+);
+const { GoodBearPasswordStores } = ChromeUtils.importESModule(
+  "resource://gre/modules/GoodBearPasswordStores.sys.mjs"
+);
+const { GoodBearRussianPKIContainer } = ChromeUtils.importESModule(
+  "resource:///modules/GoodBearRussianPKIContainer.sys.mjs"
+);
+const { ContextualIdentityService: VaultIdentityService } = ChromeUtils.importESModule(
+  "moz-src:///toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs"
+);
+const VAULT_ENABLED = "security.goodbear.russian_pki.enabled";
+const VAULT_ORIGIN = "https://example.com";
+const VAULT_FORM = VAULT_ORIGIN + "/browser/browser/components/aboutlogins/tests/browser/file_goodbear_password_vault.html";
+const PUBLIC_GUID = "{11111111-2222-4333-8444-555555555555}";
+
+function publicLogin(username, password) {
+  const login = new nsLoginInfo(VAULT_ORIGIN, VAULT_ORIGIN, null, username, password, "username", "password");
+  login.QueryInterface(Ci.nsILoginMetaInfo).guid = PUBLIC_GUID;
+  return login;
+}
+
+add_task(async function actual_actor_ui_autofill_and_disabled_management() {
+  Assert.ok(!AppConstants.MOZ_SERVICES_SYNC, "Good Bear build excludes hosted Sync");
+  Assert.deepEqual(await _AboutLogins.getSyncState(), {
+    loggedIn: false,
+    email: "",
+    avatarURL: "",
+    fxAccountsEnabled: false,
+    passwordSyncEnabled: false,
+    accountURL: null,
+  }, "about:logins supplies local-only state without loading Sync");
+  await SpecialPowers.pushPrefEnv({ set: [
+    ["privacy.userContext.enabled", true], [VAULT_ENABLED, true],
+    ["signon.autofillForms", true], ["signon.rememberSignons", true],
+  ] });
+  await VaultIdentityService.load();
+  await GoodBearRussianPKIContainer.initialize();
+  const managed = GoodBearRussianPKIContainer.ensureContainer();
+  Assert.ok(managed, "canonical managed identity exists");
+  const ordinary = VaultIdentityService.create("PUBLIC TEST vault compatibility", "circle", "blue");
+  const tabs = [];
+  let admin;
+  const open = async (url, userContextId) => {
+    let tab;
+    await BrowserTestUtils.openNewForegroundTab({
+      gBrowser,
+      opening() {
+        tab = BrowserTestUtils.addTab(gBrowser, url, { userContextId });
+        gBrowser.selectedTab = tab;
+      },
+    });
+    tabs.push(tab);
+    return tab.linkedBrowser;
+  };
+  registerCleanupFunction(async () => {
+    if (admin) {
+      await admin.removeAllUserFacingLoginsAsync();
+    }
+    for (const tab of tabs) {
+      if (tab.parentNode) { BrowserTestUtils.removeTab(tab); }
+    }
+    await Services.logins.removeAllUserFacingLoginsAsync();
+    VaultIdentityService.remove(ordinary.userContextId);
+  });
+  await Services.logins.addLoginAsync(publicLogin("PUBLIC_TEST_GENERAL", "PUBLIC_TEST_GENERAL_PASSWORD"));
+  const waitForSelectedStoreSetup = async (browser, expectedLabel) => {
+    const state = await SpecialPowers.spawn(browser, [expectedLabel], async label => {
+      for (let attempt = 0; attempt < 50; attempt++) {
+        const section = content.document.querySelector("#goodbear-password-store");
+        const heading = section?.querySelector("h2");
+        const headingL10nId = heading?.getAttribute("data-l10n-id") ?? null;
+        if (headingL10nId === label) {
+          return { headingL10nId };
+        }
+        await new content.Promise(resolve => content.setTimeout(resolve, 100));
+      }
+      const section = content.document.querySelector("#goodbear-password-store");
+      const heading = section?.querySelector("h2");
+      return {
+        initialized: content.document.documentElement.classList.contains("initialized"),
+        hasSection: !!section,
+        headingL10nId: heading?.getAttribute("data-l10n-id") ?? null,
+      };
+    });
+    Assert.equal(state.headingL10nId, expectedLabel,
+      `about:logins selected-store Setup state: ${JSON.stringify(state)}`);
+  };
+  const vaultBrowser = await open("about:logins", managed.userContextId);
+  const actor = vaultBrowser.browsingContext.currentWindowGlobal.getActor("AboutLogins");
+  Assert.equal(
+    GoodBearPasswordStores.forActor(actor).kind,
+    "goodbear-russian-pki",
+    "about:logins management follows the managed browsing-context identity"
+  );
+  await waitForSelectedStoreSetup(vaultBrowser, "goodbear-password-vault-title");
+  admin = GoodBearPasswordStores.forActor(actor);
+  const vaultChanged = TestUtils.topicObserved("goodbear-password-vault-changed",
+    (_subject, method) => method === "addLoginsAsync");
+  const addedVaultLogin = await admin.addLoginAsync(publicLogin("PUBLIC_TEST_VAULT", "PUBLIC_TEST_VAULT_PASSWORD"));
+  await vaultChanged;
+  Assert.equal(addedVaultLogin.QueryInterface(Ci.nsILoginMetaInfo).guid, PUBLIC_GUID,
+    "isolated vault preserves the caller-assigned test GUID");
+  const directVaultLogins = await admin.getAllLogins();
+  Assert.deepEqual(directVaultLogins.map(login => [
+    login.QueryInterface(Ci.nsILoginMetaInfo).guid, login.username,
+  ]), [[PUBLIC_GUID, "PUBLIC_TEST_VAULT"]],
+  "isolated vault write is immediately available through its selected store");
+  const generalBrowser = await open("about:logins", 0);
+  await waitForSelectedStoreSetup(generalBrowser, "goodbear-password-general-title");
+  for (const [browser, username, label] of [
+    [vaultBrowser, "PUBLIC_TEST_VAULT", "goodbear-password-vault-title"],
+    [generalBrowser, "PUBLIC_TEST_GENERAL", "goodbear-password-general-title"],
+  ]) {
+    await SpecialPowers.spawn(browser, [PUBLIC_GUID, username, label], async (guid, expectedUsername, expectedLabel) => {
+      const list = Cu.waiveXrays(content.document.querySelector("login-list"));
+      await ContentTaskUtils.waitForCondition(() => list._loginGuidsSortedOrder.includes(guid));
+      const row = list.shadowRoot.querySelector(`login-list-item[data-guid="${guid}"]`);
+      row.click();
+      const item = Cu.waiveXrays(content.document.querySelector("login-item"));
+      await ContentTaskUtils.waitForCondition(() => item._login.guid === guid);
+      Assert.equal(item._login.username, expectedUsername, "same GUID resolves within selected store");
+      const heading = content.document.querySelector("#goodbear-password-store h2");
+      Assert.equal(content.document.l10n.getAttributes(heading).id, expectedLabel);
+    });
+  }
+  let managedWebStore;
+  for (const [id, username] of [[0, "PUBLIC_TEST_GENERAL"], [ordinary.userContextId, "PUBLIC_TEST_GENERAL"], [managed.userContextId, "PUBLIC_TEST_VAULT"]]) {
+    const browser = await open(VAULT_FORM, id);
+    const webActor = browser.browsingContext.currentWindowGlobal.getActor("LoginManager");
+    const store = GoodBearPasswordStores.forActor(webActor);
+    Assert.equal((await store.searchLoginsAsync({ origin: VAULT_ORIGIN }))[0].username, username);
+    await SpecialPowers.spawn(browser, [username], async expected => {
+      await ContentTaskUtils.waitForCondition(() => content.document.getElementById("username").value === expected,
+        "actual child autofill selects the matching store");
+    });
+    if (id === managed.userContextId) { managedWebStore = store; }
+  }
+  Services.prefs.setBoolPref(VAULT_ENABLED, false);
+  await Assert.rejects(managedWebStore.searchLoginsAsync({ origin: VAULT_ORIGIN }), /denied/);
+  Assert.equal((await admin.getAllLogins())[0].username, "PUBLIC_TEST_VAULT", "disabled feature retains local management");
+  Services.prefs.setBoolPref(VAULT_ENABLED, true);
+  await Assert.rejects(managedWebStore.searchLoginsAsync({ origin: VAULT_ORIGIN }), /denied/, "old web capability does not resurrect");
+
+  // Actual content event -> privileged actor -> selected-store deletion.
+  const removed = TestUtils.topicObserved("goodbear-password-vault-changed", (_subject, method) => method === "removeLoginAsync");
+  await SpecialPowers.spawn(vaultBrowser, [PUBLIC_GUID], guid => {
+    content.document.dispatchEvent(new content.CustomEvent("AboutLoginsDeleteLogin", {
+      bubbles: true, detail: { guid },
+    }));
+  });
+  await removed;
+  Assert.equal((await admin.getAllLogins()).length, 0);
+  Assert.equal((await Services.logins.searchLoginsAsync({ guid: PUBLIC_GUID }))[0].username, "PUBLIC_TEST_GENERAL");
+});
