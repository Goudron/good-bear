+  }
+
+  // A capture prompt can intentionally survive navigation after a submission.
+  // Derive this authority while the web/channel caller is still valid; it is
+  // never returned to content and cannot authorize a new web operation.
+  createPrompt(store, browser, login) {
+    const source = this.#validated(this.#facades.get(store));
+    if (source.management || source.prompt ||
+        source.context?.top !== browser?.browsingContext ||
+        source.context.top.embedderElement !== browser ||
+        login.origin !== source.origin ||
+        (source.channel && login.httpRealm !== source.realm)) {
+      throw denied();
+    }
+    const context = browser.browsingContext;
+    const attributes = Object.freeze({ ...context.originAttributes });
+    const state = { notification: null, removed: false, pending: false, finished: false };
+    const captured = {
+      prompt: state, browser, context, attributes, kind: source.kind,
+      origin: source.origin, realm: source.realm, channelAuth: !!source.channel,
+      suffix: ChromeUtils.originAttributesToSuffix(attributes), management: false,
+      identityEpoch: attributes.userContextId ? this.#identityEpoch : 0,
+      featureEpoch: source.kind === PURPOSE ? this.#featureEpoch : 0,
+    };
