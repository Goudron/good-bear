diff --git a/toolkit/components/passwordmgr/GoodBearCredentialIsolation.sys.mjs b/toolkit/components/passwordmgr/GoodBearCredentialIsolation.sys.mjs
new file mode 100644
--- /dev/null
+++ b/toolkit/components/passwordmgr/GoodBearCredentialIsolation.sys.mjs
@@ -0,0 +1,66 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  ContextualIdentityService:
+    "moz-src:///toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs",
+});
+
+// Isolation identity survives disabling TLS authority and loaded documents.
+// This only restricts profile-global credentials; it grants no network trust.
+export const GoodBearCredentialIsolation = {
+  isIsolated(originAttributes) {
+    const id = originAttributes?.userContextId;
+    if (!Number.isInteger(id) || id < 0) {
+      return true;
+    }
+    if (id === 0) {
+      return false;
+    }
+    try {
+      const identity = lazy.ContextualIdentityService.getPublicIdentityFromId(id);
+      return (
+        !identity ||
+        identity.managedPurpose === "goodbear-russian-pki" ||
+        Cc["@mozilla.org/psm;1"]
+          .getService(Ci.nsINSSComponent)
+          .isGoodBearRussianPKIContainer(
+            id,
+            originAttributes.privateBrowsingId !== 0
+          )
+      );
+    } catch {
+      return true;
+    }
+  },
+
+  channelSnapshot(channel) {
+    try {
+      const loadInfo = channel.loadInfo;
+      const attrs = loadInfo.originAttributes;
+      if (!Number.isInteger(attrs.userContextId) || attrs.userContextId < 0) {
+        return null;
+      }
+      return {
+        loadInfo,
+        suffix: ChromeUtils.originAttributesToSuffix(attrs),
+        isolated: this.isIsolated(attrs),
+      };
+    } catch {
+      return null;
+    }
+  },
+
+  channelMatches(channel, snapshot) {
+    const current = this.channelSnapshot(channel);
+    return (
+      !!current &&
+      !!snapshot &&
+      current.loadInfo === snapshot.loadInfo &&
+      current.suffix === snapshot.suffix &&
+      current.isolated === snapshot.isolated
+    );
+  },
+};
