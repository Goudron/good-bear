+      const channel = { loadInfo: { originAttributes: { userContextId: 17 } },
+        URI: Services.io.newURI("https://public-test.invalid/") };
+      const info = { flags: 0, realm: "PUBLIC_TEST", username: "", password: "PUBLIC_TEST_STALE" };
+      const prompter = new LoginManagerAuthPrompter();
+      // Real public method, invented channel and prompt adapter. Native
+      // loopback nsIAuthPrompt2 delivery remains a separate acceptance gate.
+      Assert.ok(await prompter.promptAuthInternal(channel, 0, info));
+      Assert.equal(info.password, "PUBLIC_TEST_MANUAL");
+    }
+    Assert.equal(prompt.callCount, 2);
+    Assert.equal(saved.callCount, 0);
+    Assert.equal(usage.callCount, 0);
+    Assert.equal(await LoginManagerContextMenu.addLoginsToMenu(null, {}, "https://public-test.invalid"), null);
+    Assert.ok(!GoodBearCredentialIsolation.isIsolated({ userContextId: 0 }));
+    Assert.ok(GoodBearCredentialIsolation.isIsolated(undefined));
+  } finally {
+    sandbox.restore();
+  }
+});
diff --git a/toolkit/components/passwordmgr/test/unit/test_goodbear_password_vault.js b/toolkit/components/passwordmgr/test/unit/test_goodbear_password_vault.js
new file mode 100644
--- /dev/null
+++ b/toolkit/components/passwordmgr/test/unit/test_goodbear_password_vault.js
@@ -0,0 +1,100 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Prepared Ubuntu xpcshell test. Uses only the harness's fresh profile and
+// invented values. This file has not been executed by source-only validation.
+const { LoginManagerStorage_json } = ChromeUtils.importESModule(
+  "resource://gre/modules/storage-json.sys.mjs"
+);
+const { LoginHelper } = ChromeUtils.importESModule(
+  "resource://gre/modules/LoginHelper.sys.mjs"
+);
+const PURPOSE = "goodbear-russian-pki";
+const ORIGIN = "https://public-test.invalid";
+let vault;
+let vaultPath;
+
+function run_test() {
+  do_get_profile();
+  run_next_test();
+}
+function inventedLogin(user, password) {
+  const login = Cc["@mozilla.org/login-manager/loginInfo;1"].createInstance(Ci.nsILoginInfo);
+  login.init(ORIGIN, ORIGIN, null, user, password, "username", "password");
+  login.QueryInterface(Ci.nsILoginMetaInfo).guid = "{11111111-2222-4333-8444-555555555555}";
+  return login;
+}
+const operate = (method, args = [], checkpoint = () => {}) =>
+  vault.goodBearTransaction(method, args, checkpoint);
+
+add_setup(async function fresh_public_test_profile() {
+  Services.prefs.setBoolPref("signon.backup.enabled", true);
+  registerCleanupFunction(() => Services.prefs.clearUserPref("signon.backup.enabled"));
+  await Services.logins.initializationPromise;
+  vaultPath = PathUtils.join(PathUtils.profileDir, "goodbear-russian-pki-logins.json");
+  Assert.ok(!(await IOUtils.exists(vaultPath)), "fresh harness profile has no vault");
+  vault = new LoginManagerStorage_json(PURPOSE);
+  await vault.initialize();
+  registerCleanupFunction(async () => {
+    await vault.finalizeGoodBearVault();
+    await Services.logins.removeAllUserFacingLoginsAsync();
+    for (const leaf of ["goodbear-russian-pki-logins.json", "goodbear-russian-pki-logins-backup.json", "goodbear-russian-pki-logins.json.tmp"]) {
+      await IOUtils.remove(PathUtils.join(PathUtils.profileDir, leaf), { ignoreAbsent: true });
+    }
+  });
+});
+
+add_task(async function same_origin_guid_encrypted_reload_and_general_unchanged() {
+  const general = await Services.logins.addLoginAsync(inventedLogin("PUBLIC_TEST_GENERAL", "PUBLIC_TEST_GENERAL_PASSWORD"));
+  await operate("addLoginsAsync", [[inventedLogin("PUBLIC_TEST_VAULT", "PUBLIC_TEST_VAULT_PASSWORD")]]);
+  const before = await IOUtils.readUTF8(vaultPath);
+  Assert.ok(!before.includes("PUBLIC_TEST_VAULT_PASSWORD"), "real SDR password ciphertext at rest");
+  Assert.ok(!before.includes("PUBLIC_TEST_VAULT"), "real SDR username ciphertext at rest");
+  Assert.ok(!before.includes("PUBLIC_TEST_GENERAL"), "no General copy into vault");
+  const original = (await operate("getAllLogins"))[0];
+  Assert.equal(original.guid, general.guid, "GUID namespace is independent");
+  await vault.finalizeGoodBearVault();
+  vault = new LoginManagerStorage_json(PURPOSE);
+  await vault.initialize();
+  const reloaded = (await operate("getAllLogins"))[0];
+  Assert.equal(reloaded.password, "PUBLIC_TEST_VAULT_PASSWORD", "same-profile real SDR reload");
+  Assert.equal((await Services.logins.searchLoginsAsync({ guid: general.guid }))[0].password,
+    "PUBLIC_TEST_GENERAL_PASSWORD", "General remains independent");
+  // This is module reload, not whole-browser restart acceptance.
+});
+
+add_task(async function final_checkpoint_and_vault_metadata_are_scoped() {
+  const before = await IOUtils.readUTF8(vaultPath);
+  const login = (await operate("getAllLogins"))[0];
+  let checks = 0;
+  await Assert.rejects(operate("modifyLoginAsync", [login,
+    LoginHelper.newPropertyBag({ password: "PUBLIC_TEST_REJECTED" })], () => {
+      if (++checks > 1) { throw new Error("PUBLIC_TEST_REVOKED"); }
+    }), /PUBLIC_TEST_REVOKED/, "revocation after encryption rejects publication");
+  Assert.equal(await IOUtils.readUTF8(vaultPath), before, "ciphertext bytes remain unchanged");
+  await operate("setGoodBearLoginSavingEnabled", [ORIGIN, false]);
+  Assert.deepEqual(await operate("getGoodBearDisabledHosts"), [ORIGIN]);
+  Assert.ok(Services.logins.getLoginSavingEnabled(ORIGIN), "General saving policy remains enabled");
+  await operate("reencryptAllLogins");
+  Assert.equal((await operate("getAllLogins"))[0].password, "PUBLIC_TEST_VAULT_PASSWORD");
+});
+
+add_task(async function corrupt_vault_is_preserved_without_general_fallback() {
+  await vault.finalizeGoodBearVault();
+  const original = await IOUtils.readUTF8(vaultPath);
+  try {
+    await IOUtils.writeUTF8(vaultPath, "PUBLIC_TEST_CORRUPT_JSON");
+    const broken = new LoginManagerStorage_json(PURPOSE);
+    await Assert.rejects(broken.initialize(), /vault cannot be loaded/);
+    Assert.equal(await IOUtils.readUTF8(vaultPath), "PUBLIC_TEST_CORRUPT_JSON");
+    Assert.equal((await Services.logins.getAllLogins()).length, 1, "General preserved");
+  } finally {
+    await IOUtils.writeUTF8(vaultPath, original);
+    vault = new LoginManagerStorage_json(PURPOSE);
+    await vault.initialize();
+  }
+  await operate("removeAllUserFacingLoginsAsync");
+  Assert.equal((await operate("getAllLogins")).length, 0);
+  Assert.equal((await Services.logins.getAllLogins()).length, 1);
+});
