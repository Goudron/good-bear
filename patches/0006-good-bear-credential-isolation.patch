@@ -0,0 +1,604 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  AsyncShutdown: "resource://gre/modules/AsyncShutdown.sys.mjs",
+  ContextualIdentityService: "moz-src:///toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs",
+  E10SUtils: "resource://gre/modules/E10SUtils.sys.mjs",
+  GoodBearCredentialIsolation: "resource://gre/modules/GoodBearCredentialIsolation.sys.mjs",
+  LoginHelper: "resource://gre/modules/LoginHelper.sys.mjs",
+  PromptUtils: "resource://gre/modules/PromptUtils.sys.mjs",
+  LoginManagerStorage_json: "resource://gre/modules/storage-json.sys.mjs",
+});
+
+if (Services.appinfo.processType !== Services.appinfo.PROCESS_TYPE_DEFAULT) {
+  throw new Error("Good Bear password stores require the parent process");
+}
+
+export const GoodBearPasswordStoreKind = Object.freeze({
+  GENERAL: "general",
+  RUSSIAN_PKI_VAULT: "goodbear-russian-pki",
+  DENY: "deny",
+});
+const PURPOSE = GoodBearPasswordStoreKind.RUSSIAN_PKI_VAULT;
+const ENABLED = "security.goodbear.russian_pki.enabled";
+const MIGRATION = "goodbear.passwordVault.reencryptionNeeded";
+const IDENTITY_TOPICS = [
+  "contextual-identity-created",
+  "contextual-identity-updated",
+  "contextual-identity-deleted",
+];
+const WEB_OPERATIONS = new Set([
+  "searchLoginsAsync", "countLoginsAsync", "addLoginAsync", "addLogins",
+  "modifyLoginAsync", "removeLoginAsync", "recordPasswordUseAsync",
+  "getLoginSavingEnabled", "setLoginSavingEnabled",
+]);
+const SAVING_OPERATIONS = new Set(["addLoginAsync", "addLogins", "modifyLoginAsync"]);
+const OPERATIONS = [
+  ...WEB_OPERATIONS, "getAllLogins", "getAllDisabledHosts",
+  "removeAllUserFacingLoginsAsync", "removeAllLoginsAsync",
+  "recordBreachAlertDismissal", "getBreachAlertDismissalsByLoginGUID",
+  "addPotentiallyVulnerablePassword", "isPotentiallyVulnerablePassword",
+  "arePotentiallyVulnerablePasswords", "clearAllPotentiallyVulnerablePasswords",
+];
+
+function denied() {
+  return new Error("Good Bear password operation denied");
+}
+
+function cloneLogin(login) {
+  const copy = login.clone();
+  copy.QueryInterface(Ci.nsILoginMetaInfo);
+  return copy;
+}
+
+class PasswordStores {
+  #initialized = false;
+  #closed = false;
+  #failure = null;
+  #identityEpoch = 0;
+  #featureEpoch = 0;
+  #migrationEpoch = 0;
+  #capabilities = new WeakMap();
+  #facades = new WeakMap();
+  #ready = null;
+  #backend = null;
+  #queue = Promise.resolve();
+
+  initialize() {
+    if (this.#initialized) {
+      return;
+    }
+    this.#initialized = true;
+    try {
+      for (const topic of IDENTITY_TOPICS) {
+        Services.obs.addObserver(this, topic);
+      }
+      Services.obs.addObserver(this, "passwordmgr-crypto-login");
+      Services.prefs.addObserver(ENABLED, this);
+      Services.prefs.addObserver("signon.reencryptionNeeded", this);
+      this.#rememberMigration();
+      lazy.AsyncShutdown.profileChangeTeardown.addBlocker(
+        "Good Bear password vault", () => this.#shutdown()
+      );
+    } catch (error) {
+      // An unavailable vault must never prevent ordinary LoginManager startup.
+      this.#failure = error;
+    }
+  }
+
+  observe(_subject, topic, data) {
+    if (this.#closed) {
+      return;
+    }
+    if (IDENTITY_TOPICS.includes(topic)) {
+      this.#identityEpoch++;
+    } else if (topic === "nsPref:changed" && data === ENABLED) {
+      this.#featureEpoch++;
+    } else if (topic === "nsPref:changed" && data === "signon.reencryptionNeeded") {
+      try {
+        this.#rememberMigration();
+      } catch (error) {
+        this.#failure = error;
+      }
+    }
+    if (topic === "passwordmgr-crypto-login" && this.#backend) {
+      void this.#enqueue(() => this.#reencrypt()).catch(() => {
+        // The persistent obligation is retained. No credentials are logged.
+      });
+    }
+  }
+
+  #rememberMigration() {
+    if (Services.prefs.getBoolPref("signon.reencryptionNeeded", false)) {
+      this.#migrationEpoch++;
+      Services.prefs.setBoolPref(MIGRATION, true);
+    }
+  }
+
+  #kindForAttributes(oa, management) {
+  let kind = GoodBearPasswordStoreKind.GENERAL;
+  if (oa.userContextId !== 0) {
+    if (this.#failure) {
+      throw denied();
+    }
+    const identities = lazy.ContextualIdentityService.getPublicIdentities();
+    const matches = identities.filter(item => item.public === true && item.userContextId === oa.userContextId);
+    if (matches.length !== 1) {
+      throw denied();
+    }
+    const identity = matches[0];
+    if (identity.managedPurpose === PURPOSE) {
+      const managed = identities.filter(item => item.public === true && item.managedPurpose === PURPOSE);
+      if (
+    managed.length !== 1 || oa.privateBrowsingId !== 0 || this.#failure ||
+    (!management && !Services.prefs.getBoolPref(ENABLED, true))
+      ) {
+    throw denied();
+      }
+      kind = PURPOSE;
+    } else if (identity.managedPurpose || lazy.GoodBearCredentialIsolation.isIsolated(oa)) {
+      throw denied();
+    }
+  }
+    return kind;
+  }
