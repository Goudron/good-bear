+      const context = actor.browsingContext;
+      const principal = manager?.documentPrincipal;
+      // Privileged about: principals can omit the tab's container suffix.
+      // Management selection must follow the owning browsing context.
+      const oa = context?.originAttributes;
+      if (
+        this.#closed || Services.startup.shuttingDown || !manager || manager.isClosed ||
+        !context || manager.browsingContext !== context ||
+        context.currentWindowGlobal !== manager || !context.top.embedderElement ||
+        !Number.isInteger(oa?.userContextId) || oa.userContextId < 0 ||
+        !Number.isInteger(oa.privateBrowsingId) || oa.privateBrowsingId < 0
+      ) {
+        return null;
+      }
+      const document = manager.documentURI?.spec?.split(/[?#]/)[0];
+      const management = document === "about:logins";
+      if (management && (context.top !== context ||
+          manager.remoteType !== lazy.E10SUtils.PRIVILEGEDABOUT_REMOTE_TYPE ||
+          manager.getActor("AboutLogins") !== actor)) {
+        return null;
+      }
+      const origin = lazy.LoginHelper.getLoginOrigin(principal.originNoSuffix);
+      if (!management && !origin) {
+        return null;
+      }
+      const kind = this.#kindForAttributes(oa, management);
+      return {
+        actor, manager, context, principal, origin, kind, management,
+        suffix: ChromeUtils.originAttributesToSuffix(oa),
+        identityEpoch: oa.userContextId ? this.#identityEpoch : 0,
+        featureEpoch: kind === PURPOSE && !management ? this.#featureEpoch : 0,
+      };
+    } catch {
+      return null;
+    }
+  }
+
+  capture(actor) {
+    this.initialize();
+    const snapshot = this.#snapshot(actor);
+    const capability = Object.freeze({
+      kind: snapshot?.kind ?? GoodBearPasswordStoreKind.DENY,
+      operationClass: snapshot?.management ? "PRIVILEGED_MANAGEMENT" : "WEB_FORM",
+    });
+    if (snapshot) {
+      this.#capabilities.set(capability, snapshot);
+    }
+    return capability;
+  }
+
+  #channelSnapshot(channel, authInfo, requestor) {
+    try {
+      channel.QueryInterface(Ci.nsIChannel);
+      const loadInfo = channel.loadInfo;
+      const oa = loadInfo.originAttributes;
+      if (this.#closed || Services.startup.shuttingDown ||
+          !Number.isInteger(oa.userContextId) || oa.userContextId < 0 ||
+          !Number.isInteger(oa.privateBrowsingId) || oa.privateBrowsingId < 0) {
+        return null;
+      }
+      const kind = this.#kindForAttributes(oa, false);
+      const context = loadInfo.targetBrowsingContext;
+      const manager = context?.currentWindowGlobal;
+      const suffix = ChromeUtils.originAttributesToSuffix(oa);
+      if (kind === PURPOSE && (
+          !context || !manager || manager.isClosed ||
+          context.top.embedderElement !== requestor ||
+          requestor.browsingContext !== context.top ||
+          ChromeUtils.originAttributesToSuffix(context.originAttributes) !== suffix)) {
+        return null;
+      }
+      const { displayHost: origin, realm } = lazy.PromptUtils.getAuthTarget(channel, authInfo);
+      if (!origin || typeof realm !== "string") {
+        return null;
+      }
+      return {
+        channel, authInfo, requestor, loadInfo, context, manager, kind, suffix,
+        uri: channel.URI.spec, origin, realm,
+        proxy: !!(authInfo.flags & Ci.nsIAuthInformation.AUTH_PROXY),
+        management: false,
+        identityEpoch: oa.userContextId ? this.#identityEpoch : 0,
+        featureEpoch: kind === PURPOSE ? this.#featureEpoch : 0,
+      };
+    } catch {
+      return null;
+    }
+  }
