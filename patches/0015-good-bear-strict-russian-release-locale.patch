+                formatter.add(p, f)
+    else:
+        for p, f in l10n_finder.find(f"**/localization/{l10n_locale}"):
+            if not formatter.contains(p):
+                formatter.add(p, f)
 
     # Transplant jar preloading information.
     for path, log in app_finder.jarlogs.items():
