# Good Bear M10-03 follow-up: do not ship en-US locale resources in RU releases
#
# Firefox normally preserves en-US as a runtime l10n fallback. Good Bear's
# declared release contract is stricter: its RU artifact ships only Russian
# resources. The opt-out is unavailable unless the host wrapper explicitly
# sets GOODBEAR_RUSSIAN_ONLY=1 for an installers-ru repack.

diff --git a/toolkit/locales/gen_multilocale.py b/toolkit/locales/gen_multilocale.py
index 1d151b6..5b78b13 100644
--- a/toolkit/locales/gen_multilocale.py
+++ b/toolkit/locales/gen_multilocale.py
@@ -2,12 +2,13 @@
 # License, v. 2.0. If a copy of the MPL was not distributed with this
 # file, You can obtain one at http://mozilla.org/MPL/2.0/.
 
+import os
 import sys
 
 
 def main(output, *locales):
     locales = list(locales)
-    if "en-US" not in locales:
+    if "en-US" not in locales and os.environ.get("GOODBEAR_RUSSIAN_ONLY") != "1":
         locales.append("en-US")
 
     print(",".join(locales), file=output)
diff --git a/toolkit/locales/l10n.mk b/toolkit/locales/l10n.mk
index c207eb1..5f9c62b 100644
--- a/toolkit/locales/l10n.mk
+++ b/toolkit/locales/l10n.mk
@@ -91,6 +91,7 @@ MOZDEPTH ?= $(DEPTH)
 repackage-zip:
 	$(PYTHON3) $(MOZILLA_DIR)/toolkit/mozapps/installer/l10n-repack.py '$(STAGEDIST)' $(ABS_DIST)/xpi-stage/locale-$(AB_CD) \
 		$(MOZ_PKG_EXTRAL10N) \
+		$(if $(filter 1,$(GOODBEAR_RUSSIAN_ONLY)),--without-source-l10n-fallback) \
 		$(if $(MOZ_PACKAGER_MINIFY),--minify) \
 		$(if $(filter omni,$(MOZ_PACKAGER_FORMAT)),$(if $(NON_OMNIJAR_FILES),--non-resource $(NON_OMNIJAR_FILES)))
 
diff --git a/toolkit/mozapps/installer/packager.mk b/toolkit/mozapps/installer/packager.mk
index 2322886..8c8e3ce 100644
--- a/toolkit/mozapps/installer/packager.mk
+++ b/toolkit/mozapps/installer/packager.mk
@@ -180,5 +180,9 @@
 
+ifeq ($(GOODBEAR_RUSSIAN_ONLY),1)
+ALL_LOCALES = $(LOCALES)
+else
 ALL_LOCALES = $(if $(filter en-US,$(LOCALES)),$(LOCALES),$(LOCALES) en-US)
+endif
 
 # Firefox uses @RESPATH@.
 # Fennec uses @BINPATH@ and doesn't have the @RESPATH@ variable defined.
diff --git a/toolkit/mozapps/installer/l10n-repack.py b/toolkit/mozapps/installer/l10n-repack.py
index 063e8de..65804df 100644
--- a/toolkit/mozapps/installer/l10n-repack.py
+++ b/toolkit/mozapps/installer/l10n-repack.py
@@ -60,6 +60,11 @@ def main():
         default=False,
         help="Make some files more compact while packaging",
     )
+    parser.add_argument(
+        "--without-source-l10n-fallback",
+        action="store_true",
+        help="do not retain the source locale under localization/",
+    )
     args = parser.parse_args()
 
     buildconfig.substs["USE_ELF_HACK"] = False
@@ -71,6 +76,7 @@ def main():
         non_resources=args.non_resource,
         non_chrome=NON_CHROME,
         minify=args.minify,
+        source_locale_fallback=not args.without_source_l10n_fallback,
     )
 
 
