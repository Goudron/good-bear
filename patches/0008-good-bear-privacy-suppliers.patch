+add_task(async function test_native_notice_rejects_accept_before_load_handler() {
+  await SpecialPowers.pushPrefEnv({ set: [[NOTICE_PREF, 0]] });
+  let intercepted = false;
+  const observer = {
+    observe(win, topic) {
+      if (topic !== "domwindowopened") {
+        return;
+      }
+      win.addEventListener("load", () => {
+        if (win.document.documentURI !== NOTICE_URI) {
+          return;
+        }
+        // Capture precedes the dialog's load handler and its l10n/paint gate.
+        // Dispatch the real cancelable event without requiring initialized
+        // dialog buttons, reproducing the premature-accept lifecycle boundary.
+        intercepted = true;
+        const event = new win.Event("dialogaccept", { cancelable: true });
+        win.document.dispatchEvent(event);
+        Assert.ok(event.defaultPrevented, "Premature native accept is denied");
+        Assert.equal(Services.prefs.getIntPref(NOTICE_PREF), 0);
+        win.close();
+      }, { once: true, capture: true });
+    },
+  };
+  Services.ww.registerNotification(observer);
