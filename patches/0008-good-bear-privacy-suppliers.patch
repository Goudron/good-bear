new file mode 100644
--- /dev/null
+++ b/toolkit/components/url-classifier/GoodBearGoogleVerdictFreshness.h
@@ -0,0 +1,57 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+#ifndef GoodBearGoogleVerdictFreshness_h
+#define GoodBearGoogleVerdictFreshness_h
+
+#include "mozilla/TimeStamp.h"
+#include "nsReadableUtils.h"
+#include "nsString.h"
+#include "prtime.h"
+
+namespace mozilla::safebrowsing {
+
+inline bool GoodBearRequiresFreshGoogleVerdict(const nsACString& aTable,
+                                               const nsACString& aProvider) {
+  // Retain the Google boundary before the list manager registers a completer
+  // or when provider prefs no longer name an on-disk Google table.
+  return aProvider.EqualsLiteral("google") ||
+         aProvider.EqualsLiteral("google4") ||
+         aProvider.EqualsLiteral("google5") ||
+         StringBeginsWith(aTable, "goog-"_ns) ||
+         StringBeginsWith(aTable, "googpub-"_ns);
+}
+
+struct GoodBearGoogleVerdictFreshness {
+  TimeStamp mStartedAt;
+  int64_t mStartedWallUsec = 0;
+
+  static GoodBearGoogleVerdictFreshness BeforeRequest() {
+    return {TimeStamp::Now(), PR_Now()};
+  }
+
+  bool IsFreshAt(const TimeStamp& aNow, int64_t aWallUsec) const {
+    // The current completion interface has no transport receipt timestamp.
+    // Start before the lookup/request instead: network and dispatch delays can
+    // only shorten the enforcement window, never make a response younger.
+    // Wall time accounts for sleep; monotonic time prevents clock rollback
+    // from extending the window. Unknown/old metadata cannot enforce.
+    constexpr int64_t kMaximumAgeUsec = 30 * 60 * PR_USEC_PER_SEC;
+    return !mStartedAt.IsNull() && !aNow.IsNull() && mStartedWallUsec > 0 &&
+           aWallUsec >= mStartedWallUsec && aNow >= mStartedAt &&
+           aWallUsec - mStartedWallUsec <= kMaximumAgeUsec &&
+           (aNow - mStartedAt) <= TimeDuration::FromSeconds(30 * 60);
+  }
+
+  bool IsFresh() const { return IsFreshAt(TimeStamp::Now(), PR_Now()); }
+
+  bool operator==(const GoodBearGoogleVerdictFreshness& aOther) const {
+    return mStartedAt == aOther.mStartedAt &&
+           mStartedWallUsec == aOther.mStartedWallUsec;
+  }
+};
+
+}  // namespace mozilla::safebrowsing
+
+#endif  // GoodBearGoogleVerdictFreshness_h
