diff --git a/browser/components/tests/browser/browser_goodbear_safebrowsing_notice.js b/browser/components/tests/browser/browser_goodbear_safebrowsing_notice.js
new file mode 100644
--- /dev/null
+++ b/browser/components/tests/browser/browser_goodbear_safebrowsing_notice.js
@@ -0,0 +1,191 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+const {
+  GoodBearSafeBrowsingNotice: SupplierNotice,
+  GOOD_BEAR_SAFEBROWSING_NOTICE_PREF: NOTICE_PREF,
+  GOOD_BEAR_SAFEBROWSING_NOTICE_VERSION: NOTICE_VERSION,
+} = ChromeUtils.importESModule(
+  "resource:///modules/GoodBearSafeBrowsingNotice.sys.mjs"
+);
+
+const NOTICE_URI = "chrome://browser/content/goodbearSafeBrowsingNotice.xhtml";
+
+async function exerciseNotice({ continued, existingProfile }) {
+  await SpecialPowers.pushPrefEnv({
+    set: [
+      [NOTICE_PREF, 0],
+      ["trailhead.firstrun.didSeeAboutWelcome", existingProfile],
+      ["browser.aboutwelcome.enabled", false],
+      ["browser.preonboarding.enabled", false],
+    ],
+  });
+  const opened = BrowserTestUtils.domWindowOpenedAndLoaded(
+    null,
+    win => win.document.documentURI === NOTICE_URI
+  );
+  const handled = opened.then(async win => {
+    const dialog = win.document.getElementById("goodbearSafeBrowsingNotice");
+    await TestUtils.waitForCondition(
+      () => !dialog.getButton("accept").disabled,
+      "The translated disclosure must be rendered before Continue"
+    );
+    Assert.equal(Services.prefs.getIntPref(NOTICE_PREF), 0);
+    Assert.ok(!win.document.hidden, "The actual disclosure window is visible");
+    Assert.ok(win.document.querySelector("main").textContent.trim());
+    const closed = BrowserTestUtils.windowClosed(win);
+    if (continued) {
+      dialog.acceptDialog();
+    } else {
+      win.close();
+    }
+    await closed;
+  });
+  const result = await SupplierNotice.ensureShown();
+  await handled;
+  Assert.equal(result, continued);
+  Assert.equal(
+    Services.prefs.getIntPref(NOTICE_PREF),
+    continued ? NOTICE_VERSION : 0
+  );
+  if (continued) {
+    Assert.ok(
+      Services.prefs.prefHasUserValue(NOTICE_PREF),
+      "Only a persisted profile acknowledgement satisfies the gate"
+    );
+    Assert.ok(
+      !Services.prefs.prefIsLocked(NOTICE_PREF),
+      "A locked policy value is not a rendered user acknowledgement"
+    );
+  }
+  await SpecialPowers.popPrefEnv();
+}
+
+add_task(async function test_supplier_notice_new_and_existing_profiles() {
+  await exerciseNotice({ continued: true, existingProfile: false });
+  await exerciseNotice({ continued: true, existingProfile: true });
+});
+
+add_task(async function test_supplier_notice_close_does_not_enable_service() {
+  await exerciseNotice({ continued: false, existingProfile: true });
+});
+
+add_task(async function test_supplier_notice_failure_is_not_acknowledgement() {
+  await SpecialPowers.pushPrefEnv({ set: [[NOTICE_PREF, 0]] });
