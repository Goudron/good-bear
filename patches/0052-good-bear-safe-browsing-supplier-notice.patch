diff --git a/browser/components/GoodBearSafeBrowsingNotice.sys.mjs b/browser/components/GoodBearSafeBrowsingNotice.sys.mjs
new file mode 100644
index 0000000..5bcb58c
--- /dev/null
+++ b/browser/components/GoodBearSafeBrowsingNotice.sys.mjs
@@ -0,0 +1,108 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Copyright 2026 Valery Ledovskoy.
+
+export const GOOD_BEAR_SAFEBROWSING_NOTICE_VERSION = 1;
+export const GOOD_BEAR_SAFEBROWSING_NOTICE_PREF =
+  "goodbear.safebrowsing.notice.version";
+const NOTICE_URI = "chrome://browser/content/goodbearSafeBrowsingNotice.xhtml";
+
+export const GoodBearSafeBrowsingNotice = {
+  // The disclosure is modal, but its native window opens asynchronously.
+  // Safe Browsing remains disabled until its returned promise records a real
+  // user acknowledgement.
+  Policy: {
+    openNotice(result) {
+      Services.ww.openWindow(
+        null,
+        NOTICE_URI,
+        "_blank",
+        "chrome,centerscreen,modal,resizable=no",
+        result
+      );
+    },
+    savePrefs() {
+      Services.prefs.savePrefFile(null);
+    },
+  },
+
+  get wasShown() {
+    return (
+      Services.prefs.prefHasUserValue(GOOD_BEAR_SAFEBROWSING_NOTICE_PREF) &&
+      !Services.prefs.prefIsLocked(GOOD_BEAR_SAFEBROWSING_NOTICE_PREF) &&
+      Services.prefs.getIntPref(GOOD_BEAR_SAFEBROWSING_NOTICE_PREF, 0) ===
+      GOOD_BEAR_SAFEBROWSING_NOTICE_VERSION
+    );
+  },
+
+  async ensureShown() {
+    if (this.wasShown) {
+      return true;
+    }
+
+    const result = Cc["@mozilla.org/hash-property-bag;1"].createInstance(
+      Ci.nsIWritablePropertyBag2
+    );
+    result.setPropertyAsBool("rendered", false);
+    result.setPropertyAsBool("continued", false);
+    let observer;
+    try {
+      await new Promise(resolve => {
+        let notice;
+        observer = {
+          observe(subject, topic) {
+            if (topic === "domwindowopened") {
+              const win = subject;
+              win.addEventListener(
+                "load",
+                () => {
+                  if (win.document.documentURI === NOTICE_URI) {
+                    notice = win;
+                  }
+                },
+                { once: true }
+              );
+              return;
+            }
+            if (
+              topic === "domwindowclosed" &&
+              notice &&
+              subject.location == NOTICE_URI
+            ) {
+              resolve();
+            }
+          },
+        };
+        Services.ww.registerNotification(observer);
+        this.Policy.openNotice(result);
+      });
+      if (
+        !result.getPropertyAsBool("rendered") ||
+        !result.getPropertyAsBool("continued")
+      ) {
+        return false;
+      }
+      Services.prefs.setIntPref(
+        GOOD_BEAR_SAFEBROWSING_NOTICE_PREF,
+        GOOD_BEAR_SAFEBROWSING_NOTICE_VERSION
+      );
+      this.Policy.savePrefs();
+      return this.wasShown;
+    } catch {
+      // A failed render, locked preference or failed persistence never counts
+      // as a completed notice, including for an existing profile.
+      try {
+        Services.prefs.clearUserPref(GOOD_BEAR_SAFEBROWSING_NOTICE_PREF);
+      } catch {
+        // A locked preference is left locked; the caller stops startup.
+      }
+      return false;
+    } finally {
+      if (observer) {
+        Services.ww.unregisterNotification(observer);
+      }
+    }
+  },
+};
