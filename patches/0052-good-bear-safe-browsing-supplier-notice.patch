diff --git a/browser/base/content/goodbearSafeBrowsingNotice.js b/browser/base/content/goodbearSafeBrowsingNotice.js
new file mode 100644
index 0000000..70fddde
--- /dev/null
+++ b/browser/base/content/goodbearSafeBrowsingNotice.js
@@ -0,0 +1,62 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Copyright 2026 Valery Ledovskoy.
+
+let continueButton;
+let noticeResult;
+
+document.addEventListener("dialogaccept", event => {
+  if (
+    !continueButton ||
+    continueButton.disabled ||
+    !noticeResult?.getPropertyAsBool("rendered")
+  ) {
+    event.preventDefault();
+    return;
+  }
+  noticeResult.setPropertyAsBool("continued", true);
+});
+
+window.addEventListener("load", async () => {
+  try {
+    // The dialog custom element creates its buttons while the window loads.
+    // Querying it earlier leaves its internal button map uninitialized.
+    continueButton = document
+      .getElementById("goodbearSafeBrowsingNotice")
+      .getButton("accept");
+    continueButton.disabled = true;
+    noticeResult = window.arguments[0].QueryInterface(
+      Ci.nsIWritablePropertyBag2
+    );
+    await document.l10n.ready;
+    const ids = [
+      "goodbear-safebrowsing-notice-title",
+      "goodbear-safebrowsing-attribution",
+      "goodbear-safebrowsing-reliability",
+      "goodbear-safebrowsing-url-data",
+      "goodbear-safebrowsing-download-data",
+      "goodbear-safebrowsing-connection-data",
+      "goodbear-safebrowsing-settings",
+      "goodbear-safebrowsing-continue",
+    ];
+    const text = await document.l10n.formatValues(ids.map(id => ({ id })));
+    if (text.some((value, index) => !value || value === ids[index])) {
+      throw new Error("Safe Browsing notice localization is unavailable");
+    }
+    await document.l10n.translateFragment(document.documentElement);
+    await new Promise(resolve =>
+      window.requestAnimationFrame(() => window.requestAnimationFrame(resolve))
+    );
+    if (window.closed || document.hidden) {
+      return;
+    }
+    noticeResult.setPropertyAsBool("rendered", true);
+    continueButton.disabled = false;
+    continueButton.focus();
+  } catch {
+    // Do not claim that an untranslated or incomplete notice was displayed.
+    window.close();
+  }
+});
