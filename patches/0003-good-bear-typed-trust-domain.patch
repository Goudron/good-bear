+static Maybe<nsITransportSecurityInfo::GoodBearTrustDomain>
+IntToGoodBearTrustDomain(uint32_t aValue) {
+  switch (aValue) {
+    case static_cast<uint32_t>(
+        nsITransportSecurityInfo::GoodBearTrustDomain::Invalid):
+      return Some(nsITransportSecurityInfo::GoodBearTrustDomain::Invalid);
+    case static_cast<uint32_t>(
+        nsITransportSecurityInfo::GoodBearTrustDomain::Standard):
+      return Some(nsITransportSecurityInfo::GoodBearTrustDomain::Standard);
+    case static_cast<uint32_t>(
+        nsITransportSecurityInfo::GoodBearTrustDomain::RussianPKI):
+      return Some(nsITransportSecurityInfo::GoodBearTrustDomain::RussianPKI);
+  }
+  return Nothing();
+}
