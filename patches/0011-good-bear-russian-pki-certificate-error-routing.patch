new file mode 100644
index 0000000..32c5fab
--- /dev/null
+++ b/security/manager/ssl/generate_good_bear_russian_pki_anchors.py
@@ -0,0 +1,86 @@
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+"""Generate the scoped Good Bear anchor from a verified local build input.
+
+The production certificate is deliberately not committed to the source tree:
+its redistribution disposition is controlled import.  The host build wrapper
+sets GOODBEAR_RUSSIAN_PKI_BUILD_INPUT_DIR only after the M3 supply-chain gate
+has promoted the exact DER input.  This generator repeats the cryptographic
+identity check so an arbitrary local file cannot become a trust anchor.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+from pathlib import Path
+import textwrap
+
+
+ENVIRONMENT_NAME = "GOODBEAR_RUSSIAN_PKI_BUILD_INPUT_DIR"
+ROOT_RELATIVE_PATH = Path("trust_anchor/russian_trusted_root_ca_rsa_2022.der")
+ROOT_SHA256 = "d26d2d0231b7c39f92cc738512ba54103519e4405d68b5bd703e9788ca8ecf31"
+APPROVED_INTERMEDIATES = (
+    (
+        "kGoodBearRussianPKIApprovedIntermediateRSA2022",
+        Path("intermediate/russian_trusted_sub_ca_rsa_2022.der"),
+        "bbbde2103e790b999ec62bd03cf625a5a2e7c316e10afe6a490eedead8b3fd9b",
+    ),
+    (
+        "kGoodBearRussianPKIApprovedIntermediateRSA2024",
+        Path("intermediate/russian_trusted_sub_ca_rsa_2024.der"),
+        "2155785036c900dbb5f1bb2a1569c80c55595bd6bf94867a29bbddbc7d88a3f2",
+    ),
+)
+MAX_CERTIFICATE_BYTES = 64 * 1024
+
+
+def load_verified_certificate(relative_path: Path, expected_sha256: str, label: str) -> bytes:
+    input_dir = os.environ.get(ENVIRONMENT_NAME)
+    if not input_dir:
+        raise RuntimeError(f"{ENVIRONMENT_NAME} is required for a Good Bear build")
+    certificate_path = Path(input_dir).resolve() / relative_path
+    try:
+        certificate = certificate_path.read_bytes()
+    except OSError as exc:
+        raise RuntimeError(f"cannot read verified Good Bear {label}: {certificate_path}") from exc
+    if not certificate or len(certificate) > MAX_CERTIFICATE_BYTES:
+        raise RuntimeError(f"verified Good Bear {label} has an invalid size")
+    if hashlib.sha256(certificate).hexdigest() != expected_sha256:
+        raise RuntimeError(
+            f"verified Good Bear {label} does not match its pinned SHA-256"
+        )
+    return certificate
+
+
+def load_verified_root() -> bytes:
+    return load_verified_certificate(ROOT_RELATIVE_PATH, ROOT_SHA256, "root")
+
+
+def load_verified_intermediates() -> tuple[tuple[str, bytes], ...]:
+    return tuple(
+        (
+            name,
+            load_verified_certificate(relative_path, expected_sha256, name),
+        )
+        for name, relative_path, expected_sha256 in APPROVED_INTERMEDIATES
+    )
+
+
+def emit_array(output, name: str, certificate: bytes) -> None:
+    output.write(f"constexpr uint8_t {name}[] = {{\n")
+    hexified = ", ".join(f"0x{byte:02x}" for byte in certificate)
+    for line in textwrap.wrap(hexified, width=76):
+        output.write(f"    {line}\n")
+    output.write("};\n")
+
+
+def generate(output, *unused_args):
+    root = load_verified_root()
+    intermediates = load_verified_intermediates()
+    output.write("// Generated from a controlled, hash-pinned local M3 input.\n")
+    emit_array(output, "kGoodBearRussianPKIExactRoot", root)
+    for name, intermediate in intermediates:
+        emit_array(output, name, intermediate)
