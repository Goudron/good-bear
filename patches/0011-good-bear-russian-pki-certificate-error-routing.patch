@@ -0,0 +1,45 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef GoodBearRussianPKIAnchors_h
+#define GoodBearRussianPKIAnchors_h
+
+#include "mozilla/Span.h"
+#include "nsTArray.h"
+
+namespace mozilla::psm {
+
+// This include is produced only by generate_good_bear_russian_pki_anchors.py
+// from the hash-pinned M3 controlled-import input. It must never be replaced
+// with a source-tree certificate or an input fetched while the browser runs.
+#include "GoodBearRussianPKIAnchorsGenerated.inc"
+
+inline void GetGoodBearRussianPKIExactTrustAnchors(
+    nsTArray<nsTArray<uint8_t>>& aAnchors) {
+  aAnchors.Clear();
+  nsTArray<uint8_t> root;
+  root.AppendElements(kGoodBearRussianPKIExactRoot,
+                      sizeof(kGoodBearRussianPKIExactRoot));
+  aAnchors.AppendElement(std::move(root));
+}
+
+// These certificates are not anchors. They are reviewed, hash-pinned issuer
+// material supplied only when a valid Russian PKI server omits its
+// intermediate from the TLS handshake.
+inline void GetGoodBearRussianPKIApprovedIntermediates(
+    nsTArray<nsTArray<uint8_t>>& aIntermediates) {
+  aIntermediates.Clear();
+  nsTArray<uint8_t> rsa2022;
+  rsa2022.AppendElements(kGoodBearRussianPKIApprovedIntermediateRSA2022,
+                         sizeof(kGoodBearRussianPKIApprovedIntermediateRSA2022));
+  aIntermediates.AppendElement(std::move(rsa2022));
+  nsTArray<uint8_t> rsa2024;
+  rsa2024.AppendElements(kGoodBearRussianPKIApprovedIntermediateRSA2024,
+                         sizeof(kGoodBearRussianPKIApprovedIntermediateRSA2024));
+  aIntermediates.AppendElement(std::move(rsa2024));
+}
+
+}  // namespace mozilla::psm
+
+#endif  // GoodBearRussianPKIAnchors_h
