+  GoodBearTrustDomain trustDomain = GoodBearTrustDomain::Standard;
+  ASSERT_EQ(NS_OK, deserialized->GetGoodBearTrustDomain(&trustDomain));
+  ASSERT_EQ(GoodBearTrustDomain::Invalid, trustDomain);
+  ASSERT_EQ(NS_OK, deserialized->GetGoodBearRussianPKIRequired(&required));
+  ASSERT_TRUE(required);
