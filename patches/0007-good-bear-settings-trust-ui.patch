+});
+
+add_task(async function test_goodbear_settings_reset_failure_keeps_isolation() {
+  await withGoodBearPane(async context => {
+    const { pane, doc } = context;
+    await seedAssignments(pane);
+    const store = pane._manager.assignmentStore;
+    const write = store._write;
+    store._write = async () => {
+      throw new Error("Deliberate settings persistence failure");
+    };
+    try {
+      ok(
+        !(await answerReset(context, "https://one.example.test", 0)),
+        "Single reset reports failed persistence"
+      );
+      ok(
+        !(await answerReset(context, null, 0)),
+        "Clear-all reports failed persistence"
+      );
+      is(
+        store.assignments().length,
+        2,
+        "Assignments preserved by actual manager rollback"
+      );
+      is(
+        pane._manager.trustHistoryStore.entries().length,
+        2,
+        "Paired history restored"
+      );
+      ok(
+        !doc.getElementById("goodBearRussianPKIError").hidden,
+        "Failure is accessible and visible"
+      );
+      is(
+        doc.querySelectorAll("#goodBearRussianPKISites li").length,
+        2,
+        "UI does not advertise a failed deletion"
+      );
+    } finally {
+      store._write = write;
+    }
+  }, true);
+});
+
+add_task(
+  async function test_goodbear_settings_origin_validation_and_no_credentials() {
+    await withGoodBearPane(async ({ pane, doc }) => {
+      is(
+        pane._origin({ scheme: "https", host: "one.example.test", port: 443 }),
+        "https://one.example.test",
+        "Exact HTTPS origin formatted"
+      );
+      is(
+        pane._origin({ scheme: "https", host: "::1", port: 8443 }),
+        "https://[::1]:8443",
+        "IPv6 and explicit port retained"
+      );
+      for (const assignment of [
+        { scheme: "http", host: "one.example.test", port: 443 },
+        { scheme: "https", host: "user@one.example.test", port: 443 },
+        { scheme: "https", host: "one.example.test/path?secret", port: 443 },
+        { scheme: "https", host: "<script>", port: 443 },
+        { scheme: "https", host: "one.example.test", port: 0 },
+      ]) {
+        is(
+          pane._origin(assignment),
+          null,
+          "Malformed origin cannot become a rendered/reset target"
+        );
+      }
+      const credentials = doc.getElementById("goodBearRussianPKICredentials");
+      is(
+        credentials.getAttribute("data-l10n-id"),
+        "goodbear-russian-pki-settings-credentials-description",
+        "Honest disabled-credentials description is registered"
+      );
+      is(
+        doc.querySelectorAll("#goodBearRussianPKIPane input").length,
+        1,
+        "Pane has only the support toggle, no credential fields"
+      );
+      const messages = await doc.l10n.formatMessages([
+        {
+          id: "goodbear-russian-pki-settings-reset-origin",
+          args: { origin: "https://one.example.test" },
+        },
+      ]);
+      ok(
+        messages[0].value.includes("https://one.example.test"),
+        "Origin variable resolves through registered Fluent resource"
+      );
+    });
+  }
+);
