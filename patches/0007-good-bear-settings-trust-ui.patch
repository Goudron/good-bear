+    } finally {
+      await SpecialPowers.popPrefEnv();
+    }
+  }
+});
diff --git a/browser/components/preferences/tests/browser_goodbear_russian_pki.js b/browser/components/preferences/tests/browser_goodbear_russian_pki.js
