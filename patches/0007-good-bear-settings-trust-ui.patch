+  _getGoodBearRussianPKIDetails(browser = gBrowser.selectedBrowser) {
+    try {
+      const { state, secInfo } = browser.securityUI;
+      const { userContextId, privateBrowsingId } =
+        browser.browsingContext.originAttributes;
+      if (
+        !(state & Ci.nsIWebProgressListener.STATE_IS_SECURE) ||
+        state & Ci.nsIWebProgressListener.STATE_CERT_USER_OVERRIDDEN ||
+        secInfo?.goodBearTrustDomain !==
+          Ci.nsITransportSecurityInfo.RussianPKI ||
+        secInfo.errorCode !== 0 ||
+        !Number.isInteger(userContextId) ||
+        userContextId <= 0 ||
+        privateBrowsingId !== 0 ||
+        !browser.currentURI.schemeIs("https")
+      ) {
+        return null;
+      }
+      const innerWindowId =
+        browser.browsingContext.currentWindowGlobal.innerWindowId;
+      if (!Number.isSafeInteger(innerWindowId) || innerWindowId <= 0) {
+        return null;
+      }
+      // Only the verifier's successful path names the actual trust anchor.
+      // Never substitute the server-supplied handshakeCertificates array.
+      const chain = secInfo.succeededCertChain;
+      if (chain.length < 2 || !chain[0].equals(secInfo.serverCert)) {
+        return null;
+      }
+      const leaf = chain[0].subjectName;
+      const issuer = chain[0].issuerName;
+      const root = chain[chain.length - 1].subjectName;
+      const fingerprint = chain[chain.length - 1].sha256Fingerprint;
+      if (
+        [leaf, issuer, root].some(value => typeof value !== "string") ||
+        !/^(?:[0-9a-f]{2}:){31}[0-9a-f]{2}$/i.test(fingerprint)
+      ) {
+        return null;
+      }
+      const certificates = chain.map(cert => cert.getBase64DERString());
+      if (certificates.some(value => typeof value !== "string" || !value)) {
+        return null;
+      }
+      return Object.freeze({
+        browser,
+        secInfo,
+        innerWindowId,
+        documentURI: browser.currentURI.spec,
+        hostname: browser.currentURI.displayHost,
+        leaf,
+        issuer,
+        root,
+        fingerprint,
+        certificateURL:
+          "about:certificate?" +
+          certificates
+            .map(cert => `cert=${encodeURIComponent(cert)}`)
+            .join("&"),
+      });
+    } catch {
+      // Incomplete or stale native security information must clear the panel.
+      return null;
+    }
+  },
+
+  _updateGoodBearRussianPKIDetails(browser = gBrowser.selectedBrowser) {
+    this._goodBearRussianPKIDetails = null;
+    const panel = document.getElementById("goodbear-russian-pki-details");
+    if (!panel) {
+      return;
+    }
+    const details = this._getGoodBearRussianPKIDetails(browser);
+    panel.hidden = !details;
+    document.getElementById("goodbear-russian-pki-view-certificate").disabled =
+      !details;
+    for (const name of ["hostname", "leaf", "issuer", "root", "fingerprint"]) {
+      const field = document.getElementById(`goodbear-russian-pki-${name}`);
+      field.removeAttribute("data-l10n-id");
+      field.textContent = details?.[name] || "";
+      if (details && !details[name]) {
+        document.l10n.setAttributes(
+          field,
+          "identity-goodbear-russian-pki-empty-name"
+        );
+      }
+    }
+    this._goodBearRussianPKIDetails = details;
+  },
+
