@@ -0,0 +1,363 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+"use strict";
+
+const GB_PREF = "security.goodbear.russian_pki.enabled";
+const {
+  GoodBearRussianPKIContainer,
+  GoodBearRussianPKIContainerManager,
+  GoodBearRussianPKIAssignmentStore,
+  GoodBearRussianPKITrustHistoryStore,
+} = ChromeUtils.importESModule(
+  "resource:///modules/GoodBearRussianPKIContainer.sys.mjs"
+);
+
+async function withGoodBearPane(callback, fixture = false) {
+  const tab = await openPrefsTab("goodBearRussianPKI");
+  const win = tab.linkedBrowser.contentWindow;
+  const pane = win.gGoodBearRussianPKIPane;
+  await pane.ready;
+  await win.document.l10n.ready;
+  let directory;
+  try {
+    if (fixture) {
+      directory = PathUtils.join(
+        PathUtils.profileDir,
+        `goodbear-settings-${Services.uuid.generateUUID()}`
+      );
+      await IOUtils.makeDirectory(directory);
+      const assignments = new GoodBearRussianPKIAssignmentStore(
+        PathUtils.join(directory, "assignments.json")
+      );
+      const history = new GoodBearRussianPKITrustHistoryStore(
+        PathUtils.join(directory, "history.json")
+      );
+      await Promise.all([assignments.load(), history.load()]);
+      // Exercise the production transactional reset APIs with disposable stores.
+      // No fabricated native certificate-verification result is involved.
+      pane._manager = new GoodBearRussianPKIContainerManager(
+        {},
+        null,
+        assignments,
+        history
+      );
+      pane._renderAssignments();
+    }
+    await callback({
+      pane,
+      win,
+      doc: win.document,
+      browser: tab.linkedBrowser,
+    });
+  } finally {
+    BrowserTestUtils.removeTab(tab);
+    GoodBearRussianPKIContainer.assignmentStore._publishRuntimeAssignments();
+    if (directory) {
+      await IOUtils.remove(directory, { recursive: true });
+    }
+  }
+}
+
+async function seedAssignments(pane) {
+  for (const origin of [
+    "https://one.example.test",
+    "https://two.example.test:8443",
+  ]) {
+    await pane._manager.assignmentStore.assign(origin);
+    await pane._manager.trustHistoryStore.recordConfirmed(
+      origin,
+      "RUSSIAN_PKI"
+    );
+  }
+  pane._renderAssignments();
+}
+
+async function answerReset({ pane, browser }, origin, buttonNumClick) {
+  const prompt = PromptTestUtils.waitForPrompt(browser, {
+    modalType: Services.prompt.MODAL_TYPE_CONTENT,
+    promptType: "confirmEx",
+  });
+  const doc = browser.contentDocument;
+  const button =
+    origin === null
+      ? doc.getElementById("goodBearRussianPKIResetAll")
+      : [...doc.querySelectorAll("#goodBearRussianPKISites button")].find(
+          item =>
+            JSON.parse(item.getAttribute("data-l10n-args")).origin === origin
+        );
+  let result;
+  const reset = pane.reset;
+  pane.reset = function (...args) {
+    result = reset.apply(this, args);
+    return result;
+  };
+  try {
+    button.click();
+  } finally {
+    pane.reset = reset;
+  }
+  ok(result, "Native button dispatches the registered reset handler");
+  const dialog = await prompt;
+  is(dialog.args.defaultButtonNum, 1, "Cancel is the safe default");
+  ok(
+    !(await pane.reset(origin)),
+    "A pending confirmation cannot be submitted twice"
+  );
+  if (origin) {
+    ok(
+      dialog.args.text.includes(origin),
+      "Single-origin confirmation names the exact target"
+    );
+  }
+  await PromptTestUtils.handlePrompt(dialog, { buttonNumClick });
+  return result;
+}
+
+add_task(async function test_goodbear_settings_live_enable_and_locked_pref() {
+  await SpecialPowers.pushPrefEnv({ set: [[GB_PREF, false]] });
+  await withGoodBearPane(async ({ pane, doc }) => {
+    const checkbox = doc.getElementById("goodBearRussianPKIEnabled");
+    ok(!checkbox.checked, "Disabled native preference is displayed");
+    checkbox.click();
+    ok(
+      Services.prefs.getBoolPref(GB_PREF),
+      "Enabling writes only the existing scope preference"
+    );
+    Assert.greater(
+      GoodBearRussianPKIContainer.dedicatedUserContextId,
+      0,
+      "Manager observes enabling immediately"
+    );
+    const oldId = GoodBearRussianPKIContainer.dedicatedUserContextId;
+    checkbox.click();
+    ok(
+      !Services.prefs.getBoolPref(GB_PREF),
+      "Disabling takes effect immediately"
+    );
+    is(
+      GoodBearRussianPKIContainer.dedicatedUserContextId,
+      null,
+      "Disabled support publishes no scoped identity"
+    );
+    ok(
+      !Cc["@mozilla.org/psm;1"].getService(Ci.nsINSSComponent)
+        .isGoodBearRussianPKIContainer(oldId, false),
+      "Actual native scope authority rejects the revoked identity"
+    );
+    Services.prefs.setBoolPref(GB_PREF, true);
+    ok(checkbox.checked, "External preference changes update the open pane");
+    Services.prefs.lockPref(GB_PREF);
+    try {
+      pane._renderEnabled();
+      ok(checkbox.disabled, "Policy locked preference cannot be toggled");
+      const stored = Services.prefs.getBoolPref(GB_PREF);
+      checkbox.checked = !stored;
+      pane._setEnabled();
+      is(
+        Services.prefs.getBoolPref(GB_PREF),
+        stored,
+        "Forged change cannot bypass lock"
+      );
+      is(checkbox.checked, stored, "UI restores effective stored state");
+    } finally {
+      Services.prefs.unlockPref(GB_PREF);
+    }
+  });
+  await withGoodBearPane(async ({ doc }) => {
+    ok(
+      doc.getElementById("goodBearRussianPKIEnabled").checked,
+      "Reopened pane reads the persisted preference"
+    );
+  });
+  await SpecialPowers.popPrefEnv();
+});
+
+add_task(
+  async function test_goodbear_settings_single_reset_confirm_and_cancel() {
+    await withGoodBearPane(async context => {
+      const { pane, doc } = context;
+      await seedAssignments(pane);
+      ok(
+        !(await answerReset(context, "https://one.example.test", 1)),
+        "Cancel refuses removal"
+      );
+      ok(
+        pane._manager.assignmentStore.isAssigned("https://one.example.test"),
+        "Cancelled assignment stays"
+      );
+      ok(
+        pane._manager.trustHistoryStore.get("https://one.example.test"),
+        "Cancelled history stays"
+      );
+      ok(
+        await answerReset(context, "https://one.example.test", 0),
+        "Confirmed single removal succeeds"
+      );
+      ok(
+        !pane._manager.assignmentStore.isAssigned("https://one.example.test"),
+        "Exact assignment removed"
+      );
+      is(
+        pane._manager.trustHistoryStore.get("https://one.example.test"),
+        null,
+        "Paired history removed"
+      );
+      ok(
+        pane._manager.assignmentStore.isAssigned(
+          "https://two.example.test:8443"
+        ),
+        "Other origin and port retained"
+      );
+      is(
+        doc.querySelectorAll("#goodBearRussianPKISites li").length,
+        1,
+        "Only remaining assignment is shown"
+      );
+      ok(
+        // The insecure origin is the rejection input, never a navigation target.
+        // eslint-disable-next-line sdl/no-insecure-url
+        !(await pane.reset("http://one.example.test")),
+        "Unknown/insecure origin does not prompt or mutate"
+      );
+      ok(
+        !(await pane.reset("https://two.example.test:8443/private?secret")),
+        "A full URL cannot enter confirmation or reset"
+      );
+    }, true);
+  }
+);
+
+add_task(async function test_goodbear_settings_clear_all_confirm_and_cancel() {
+  await withGoodBearPane(async context => {
+    const { pane, doc } = context;
+    await seedAssignments(pane);
