--- /dev/null
+++ b/browser/components/contextualidentity/test/browser/browser_goodbear_nova_surfaces.js
@@ -0,0 +1,71 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+"use strict";
+
+const { GoodBearRussianPKIContainer } = ChromeUtils.importESModule(
+  "resource:///modules/GoodBearRussianPKIContainer.sys.mjs"
+);
+
+// Execute once for each declared OS/theme/scale/sidebar/window matrix row.
+// This checks actual DOM geometry; screenshots and Russian review are separate.
+add_task(async function test_nova_standard_marker_geometry_and_focus() {
+  await SpecialPowers.pushPrefEnv({
+    set: [["privacy.userContext.enabled", true]],
+  });
+  await GoodBearRussianPKIContainer.initialize();
+  const identity = GoodBearRussianPKIContainer.ensureContainer();
+  const { tab, browser } = await openTabInUserContext(
+    "https://example.com/browser/browser/components/contextualidentity/test/browser/empty_file.html",
+    identity.userContextId
+  );
+  try {
+    is(browser.securityUI.secInfo.goodBearTrustDomain,
+       Ci.nsITransportSecurityInfo.Standard, "Actual public TLS stays STANDARD");
+    const marker = document.getElementById("userContext-icons");
+    const label = document.getElementById("userContext-label");
+    await document.l10n.translateElements([marker, label]);
+    const rect = marker.getBoundingClientRect();
+    ok(BrowserTestUtils.isVisible(marker), "Isolation marker is rendered");
+    ok(rect.width > 0 && rect.height > 0, "Marker has actionable visible geometry");
+    ok(rect.left >= 0 && rect.right <= window.innerWidth, "Marker is not clipped by window");
+    ok(label.getBoundingClientRect().right <= rect.right + 1, "Russian label fits its marker");
+    ok(marker.getAttribute("aria-label"), "Isolation has an accessible name");
+    ok(document.getElementById("trust-goodbear-russian-pki-label").hidden,
+       "Container color does not assert Russian TLS trust");
+    gURLBar.focus();
+    is(document.activeElement, gURLBar.inputField, "Keyboard can reach the location bar");
+    const ordinary = await BrowserTestUtils.openNewForegroundTab({
+      gBrowser, url: "https://example.com/",
+    });
+    try {
+      ok(marker.hidden, "Switching documents clears managed marker");
+      ok(!marker.hasAttribute("aria-label"), "No stale accessible isolation state");
+    } finally {
+      BrowserTestUtils.removeTab(ordinary);
+    }
+  } finally {
+    BrowserTestUtils.removeTab(tab);
+    await SpecialPowers.popPrefEnv();
+  }
+});
+
+add_task(async function test_referrals_cannot_be_reenabled_by_preference() {
+  const { Referrals } = ChromeUtils.importESModule(
+    "moz-src:///browser/components/referrals/Referrals.sys.mjs"
+  );
+  await SpecialPowers.pushPrefEnv({ set: [["browser.referrals.enabled", true]] });
+  try {
+    ok(!Referrals.isEnabled, "Fork does not offer Mozilla product invitations");
+    is(Referrals.getReferralCode(), "", "No referral identifier is generated");
+    const handler = Cc["@mozilla.org/network/protocol/about;1?what=referrals"]
+      .getService(Ci.nsIAboutModule);
+    Assert.throws(() => handler.newChannel(Services.io.newURI("about:referrals"), null),
+      /NS_ERROR_NOT_AVAILABLE/, "Direct navigation is denied before an outbound channel");
+    const count = gBrowser.tabs.length;
+    Referrals.openReferralsTab(window, "about_dialog");
+    is(gBrowser.tabs.length, count, "Disabled entry point cannot open a supplier tab");
+  } finally {
+    await SpecialPowers.popPrefEnv();
+  }
+});
diff --git a/browser/components/contextualidentity/test/browser/browser_goodbear_russian_pki_security_ui.js b/browser/components/contextualidentity/test/browser/browser_goodbear_russian_pki_security_ui.js
