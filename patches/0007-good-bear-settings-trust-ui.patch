diff --git a/browser/components/preferences/goodBearRussianPKI.js b/browser/components/preferences/goodBearRussianPKI.js
new file mode 100644
--- /dev/null
+++ b/browser/components/preferences/goodBearRussianPKI.js
@@ -0,0 +1,334 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+var gGoodBearRussianPKIPane = {
+  _enabledPref: "security.goodbear.russian_pki.enabled",
+  // Observe publication, but read canonical assignments only from the manager.
+  _assignmentsPref: "network.goodbear.russian_pki.assigned_origins",
+  _manager: null,
+  _busy: false,
+  _loaded: false,
+  _alive: false,
+
+  init() {
+    this._alive = true;
+    Services.prefs.addObserver(this._enabledPref, this);
+    Services.prefs.addObserver(this._assignmentsPref, this);
+    window.addEventListener(
+      "unload",
+      () => {
+        this._alive = false;
+        Services.prefs.removeObserver(this._enabledPref, this);
+        Services.prefs.removeObserver(this._assignmentsPref, this);
+      },
+      { once: true }
+    );
+    document
+      .getElementById("goodBearRussianPKIEnabled")
+      .addEventListener("change", () => this._setEnabled());
+    document
+      .getElementById("goodBearRussianPKIResetAll")
+      .addEventListener("click", () => this.reset());
+    const credentials = document.getElementById("goodBearRussianPKICredentials");
+    MozXULElement.insertFTLIfNeeded("browser/browser.ftl");
+    document.l10n.setAttributes(credentials, "goodbear-password-vault-settings-description");
+    const passwordButton = document.createElementNS("http://www.w3.org/1999/xhtml", "button");
+    passwordButton.type = "button";
+    document.l10n.setAttributes(passwordButton, "goodbear-password-vault-open");
+    passwordButton.addEventListener("click", () => {
+      try {
+        ChromeUtils.importESModule("resource://gre/modules/GoodBearPasswordStores.sys.mjs")
+          .GoodBearPasswordStores.openVaultManagement(window.browsingContext.topChromeWindow);
+      } catch { this._showError(true, "goodbear-password-vault-unavailable"); }
+    });
+    credentials.after(passwordButton);
+    this._renderEnabled();
+    this.ready = this._initialize();
+  },
+
+  async _initialize() {
+    try {
+      this._manager ||= ChromeUtils.importESModule(
+        "resource:///modules/GoodBearRussianPKIContainer.sys.mjs"
+      ).GoodBearRussianPKIContainer;
+      await this._manager.initialize();
+      this._loaded = this._manager.routingStateLoaded;
+      if (!this._loaded ||
+          (Services.prefs.getBoolPref(this._enabledPref) && !this._scopeActive())) {
+        throw new Error("Managed scope initialization is incomplete");
+      }
+    } catch {
+      this._loaded = false;
+      // Failed initialization must not leave newly published authority alive.
+      // Full socket/ticket effects are owned by the native policy gates.
+      try {
+        this._manager?.stop();
+      } catch {
+        // A failed manager stop must not prevent direct native revocation.
+      }
+      try {
+        Cc["@mozilla.org/psm;1"]
+          .getService(Ci.nsINSSComponent)
+          .clearGoodBearRussianPKIContainerId();
+      } catch {
+        // Never report success when the native service is unavailable.
+      }
+    }
+    if (this._alive) {
+      this._renderEnabled();
+      this._renderAssignments();
+      this._showError(!this._loaded, "goodbear-russian-pki-settings-unavailable");
+    }
+  },
+
+  observe(subject, topic, pref) {
+    if (!this._alive) {
+      return;
+    }
+    if (pref === this._enabledPref) {
+      this._renderEnabled();
+    } else if (pref === this._assignmentsPref && this._loaded) {
+      this._renderAssignments();
+    }
+  },
+
+  _renderEnabled() {
+    const enabled = Services.prefs.getBoolPref(this._enabledPref);
+    const checkbox = document.getElementById("goodBearRussianPKIEnabled");
+    checkbox.checked = enabled;
+    checkbox.disabled =
+      !this._loaded || Services.prefs.prefIsLocked(this._enabledPref);
+    document.l10n.setAttributes(
+      document.getElementById("goodBearRussianPKIState"),
+      enabled
+        ? "goodbear-russian-pki-settings-enabled-state"
+        : "goodbear-russian-pki-settings-disabled-state"
+    );
+  },
+
+  _scopeActive() {
+    const id = this._manager?.dedicatedUserContextId;
+    return Number.isInteger(id) && id > 0 &&
+      Cc["@mozilla.org/psm;1"].getService(Ci.nsINSSComponent)
+        .isGoodBearRussianPKIContainer(id, false);
+  },
+
+  _setEnabled() {
+    let changed = false;
+    let enabling = false;
+    let previous;
+    try {
+      if (this._alive && this._loaded &&
+          !Services.prefs.prefIsLocked(this._enabledPref)) {
+        previous = Services.prefs.getBoolPref(this._enabledPref);
+        const enabled = document.getElementById(
+          "goodBearRussianPKIEnabled"
+        ).checked;
+        enabling = enabled;
+        if (!enabled) {
+          Cc["@mozilla.org/psm;1"]
+            .getService(Ci.nsINSSComponent)
+            .clearGoodBearRussianPKIContainerId();
+        }
+        Services.prefs.setBoolPref(this._enabledPref, enabled);
+        // A stored true alone is not successful scope publication. The real
+        // manager observer and native authority must both acknowledge it.
+        if (enabled && !this._scopeActive()) {
+          throw new Error("Managed scope publication failed");
+        }
+        this._showError(false);
+        changed = true;
+      }
+    } catch {
+      if (enabling) {
+        try {
+          Cc["@mozilla.org/psm;1"].getService(Ci.nsINSSComponent)
+            .clearGoodBearRussianPKIContainerId();
+          Services.prefs.setBoolPref(this._enabledPref, previous);
+        } catch {
+          // A failed rollback remains an error, never a success indication.
+        }
+      }
+      this._showError(true, "goodbear-russian-pki-settings-enable-failed");
+    }
+    // Always display the effective stored value, including locked/failed writes.
+    this._renderEnabled();
+    return changed;
+  },
+
+  _origin(assignment) {
+    if (
+      assignment?.scheme !== "https" ||
+      typeof assignment.host !== "string" ||
+      !Number.isInteger(assignment.port) ||
+      assignment.port < 1 ||
+      assignment.port > 65535
+    ) {
+      return null;
+    }
+    try {
+      const host = assignment.host.includes(":")
+        ? `[${assignment.host}]`
+        : assignment.host;
+      const uri = Services.io.newURI(`https://${host}:${assignment.port}/`);
+      if (
+        uri.asciiHost !== assignment.host ||
+        uri.userPass ||
+        (uri.port === -1 ? 443 : uri.port) !== assignment.port ||
+        uri.pathQueryRef !== "/"
+      ) {
+        return null;
+      }
+      return uri.prePath;
+    } catch {
+      return null;
+    }
+  },
+
+  _renderAssignments() {
+    const list = document.getElementById("goodBearRussianPKISites");
+    list.replaceChildren();
+    const origins = this._loaded
+      ? this._manager.assignmentStore
+          .assignments()
+          .map(assignment => this._origin(assignment))
+          .filter(Boolean)
+          .sort()
+      : [];
+    for (const origin of origins) {
+      const item = document.createElementNS(
+        "http://www.w3.org/1999/xhtml",
+        "li"
+      );
+      const button = document.createElementNS(
+        "http://www.w3.org/1999/xhtml",
+        "button"
+      );
+      button.type = "button";
+      document.l10n.setAttributes(
+        button,
+        "goodbear-russian-pki-settings-reset-origin",
+        { origin }
+      );
+      button.addEventListener("click", () => this.reset(origin));
+      item.append(button);
+      list.append(item);
+    }
+    document.getElementById("goodBearRussianPKIEmpty").hidden =
+      !!origins.length;
+    document.getElementById("goodBearRussianPKIResetAll").disabled =
+      !origins.length && !this._manager?.trustHistoryStore?.entries().length;
+    this._renderBusy();
+  },
+
+  _renderBusy() {
+    document.getElementById("goodBearRussianPKIAssignments").disabled =
+      !this._loaded || this._busy;
+    document
+      .getElementById("goodBearRussianPKISites")
+      .setAttribute("aria-busy", String(this._busy));
+  },
+
+  _showError(visible, id = "goodbear-russian-pki-settings-reset-failed") {
+    const error = document.getElementById("goodBearRussianPKIError");
+    if (visible) {
+      document.l10n.setAttributes(error, id);
+    }
+    error.hidden = !visible;
+  },
+
+  async reset(origin = null) {
+    if (!this._loaded || this._busy || !this._alive) {
+      return false;
+    }
+    if (
+      origin !== null &&
+      !this._manager.assignmentStore
+        .assignments()
+        .some(assignment => this._origin(assignment) === origin)
+    ) {
+      return false;
+    }
+    this._busy = true;
+    this._renderBusy();
+    this._showError(false);
+    try {
+      const args = origin === null ? {} : { origin };
+      const [title, message, confirm] = await document.l10n.formatValues([
+        { id: "goodbear-russian-pki-settings-sites-header" },
+        {
+          id:
+            origin === null
+              ? "goodbear-russian-pki-settings-reset-all-confirmation"
+              : "goodbear-russian-pki-settings-reset-origin-confirmation",
+          args,
+        },
+        {
+          id:
+            origin === null
+              ? "goodbear-russian-pki-settings-reset-all-confirm"
+              : "goodbear-russian-pki-settings-reset-origin",
+          args,
+        },
+      ]);
+      if (!this._alive) {
+        return false;
+      }
+      if (
+        ![title, message, confirm].every(
+          value => typeof value === "string" && value.trim()
+        )
+      ) {
+        throw new Error(
+          "Missing Good Bear assignment confirmation localization"
+        );
+      }
+      const flags =
+        (Services.prompt.BUTTON_POS_0 *
+          Services.prompt.BUTTON_TITLE_IS_STRING) |
+        (Services.prompt.BUTTON_POS_1 * Services.prompt.BUTTON_TITLE_CANCEL) |
+        Services.prompt.BUTTON_POS_1_DEFAULT;
+      const result = await Services.prompt.asyncConfirmEx(
+        window.browsingContext,
+        Services.prompt.MODAL_TYPE_CONTENT,
+        title,
+        message,
+        flags,
+        confirm,
+        null,
+        null,
+        null,
+        false
+      );
+      if (!this._alive || result.getProperty("buttonNumClicked") !== 0) {
+        return false;
+      }
+      const changed =
+        origin === null
+          ? await this._manager.resetAllAssignments()
+          : await this._manager.resetAssignment(origin);
+      if (this._alive) {
+        this._showError(!changed);
+      }
+      return changed;
+    } catch {
+      if (this._alive) {
+        this._showError(true);
+      }
+      return false;
+    } finally {
+      this._busy = false;
+      if (this._alive) {
+        this._renderAssignments();
+        const target = document.getElementById("goodBearRussianPKIResetAll");
+        const focusTarget = target.disabled
+          ? document.getElementById("goodBearRussianPKIEnabled")
+          : target;
+        focusTarget.focus();
+      }
+    }
+  },
+};
