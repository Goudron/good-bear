+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+"use strict";
+
+const GB101_ENABLED = "security.goodbear.russian_pki.enabled";
+const { AppConstants } = ChromeUtils.importESModule(
+  "resource://gre/modules/AppConstants.sys.mjs"
+);
+const GB101_HAS_SYNC = AppConstants.MOZ_SERVICES_SYNC;
+
+function gb101DeepElements(root) {
+  const result = [root, ...root.querySelectorAll("*")];
+  for (const element of [...result]) {
+    if (element.shadowRoot) {
+      result.push(...gb101DeepElements(element.shadowRoot));
+    }
+  }
+  return result.filter(element => element.nodeType === Node.ELEMENT_NODE);
+}
+
+function gb101Rendered(element) {
+  if (!element) {
+    return false;
+  }
+  const bounds = element.getBoundingClientRect();
+  return BrowserTestUtils.isVisible(element) && bounds.width > 0 && bounds.height > 0;
+}
+
+function gb101Controls(roots) {
+  return roots.flatMap(gb101DeepElements).filter(element =>
+    element.matches("input,button,select,textarea,checkbox,radio,menulist,a[href],moz-button,moz-checkbox,moz-toggle") &&
+    !element.disabled && gb101Rendered(element)
+  );
+}
+
+async function gb101WithPreferences(entry, hash, callback) {
+  const tab = await BrowserTestUtils.openNewForegroundTab(gBrowser, entry + hash);
+  const win = tab.linkedBrowser.contentWindow;
+  try {
+    await win.document.l10n.ready;
+    await TestUtils.waitForCondition(() => win.gCategoryInits?.size,
+      "Native preferences registered categories");
+    await callback(win, tab.linkedBrowser);
+  } finally {
+    BrowserTestUtils.removeTab(tab);
+  }
+}
+
+function gb101ContentRoots(win, category) {
+  const roots = [...win.document.querySelectorAll(
+    `[data-category="${category}"],setting-pane`
+  )].filter(element => element.localName !== "setting-pane" || element.name === category);
+  return roots;
+}
+
+async function gb101AssertCurrentContent(win, category) {
+  const roots = gb101ContentRoots(win, category);
+  Assert.ok(roots.length, `${category}: actual content owner exists`);
+  await TestUtils.waitForCondition(() => gb101Controls(roots).length > 0,
+    `${category}: a rendered actionable control, not only a navigation label`);
+  Assert.ok(roots.some(root => gb101DeepElements(root).some(element =>
+    gb101Rendered(element) && (element.textContent.trim() || element.ariaLabel)
+  )), `${category}: rendered content has text or an accessible name`);
+  const control = gb101Controls(roots)[0];
+  control.focus();
+  Assert.ok(control.matches(":focus, :focus-within") ||
+    control.getRootNode().activeElement === control,
+    `${category}: the real control accepts keyboard focus`);
+}
+
+async function gb101AssertContent(win, category) {
+  await win.gotoPref(category);
+  await gb101AssertCurrentContent(win, category);
+}
+
+add_task(async function test_all_shipped_sections_aliases_and_layouts_have_content() {
+  for (const redesign of [false, true]) {
+    await SpecialPowers.pushPrefEnv({ set: [["browser.settings-redesign.enabled", redesign]] });
+    try {
+      for (const entry of ["about:preferences", "about:settings"]) {
+        await gb101WithPreferences(entry, "", async (win, browser) => {
+          const doc = win.document;
+          const buttons = [...doc.querySelectorAll("#categories moz-page-nav-button")]
+            .filter(button => gb101Rendered(button) && !button.hidden);
+          const categories = buttons.map(button => button.view);
+          const requiredCategories = ["paneHome", "paneSearch", "panePrivacy", "paneGoodBearRussianPKI"];
+          requiredCategories.push(...(redesign ? ["paneAppearance", "paneAccessibility",
+            "paneDownloads", "paneLanguages", "paneTabsBrowsing", "panePasswordsAutofill",
+            "panePermissionsData", "paneAbout"] : ["paneGeneral"]));
+          if (redesign && GB101_HAS_SYNC) {
+            requiredCategories.push("paneSync");
+          }
+          for (const required of requiredCategories) {
+            Assert.ok(categories.includes(required), `${entry}: ${required} is shipped`);
+          }
+          const initialCategory = redesign
+            ? GB101_HAS_SYNC
+              ? "paneSync"
+              : "paneHome"
+            : "paneGeneral";
+          await TestUtils.waitForCondition(
+            () => win.gLastCategory.category === initialCategory,
+            `${entry}: initial category is fully initialized`
+          );
+          await gb101AssertCurrentContent(win, initialCategory);
+          if (!GB101_HAS_SYNC) {
+            Assert.ok(!categories.includes("paneSync"),
+              `${entry}: unavailable Sync has no navigation category`);
+            Assert.ok(!win.gCategoryInits.has("paneSync"),
+              `${entry}: unavailable Sync has no category initializer`);
+          }
+          for (const category of categories) {
+            await gb101AssertContent(win, category);
+          }
+          // Account/sync groups are policy-disabled; the redesigned section
+          // can retain local default-browser/import/profile/backup controls.
+          if (!Services.prefs.getBoolPref("identity.fxaccounts.enabled")) {
+            if (redesign && GB101_HAS_SYNC) {
+              await gb101AssertContent(win, "paneSync");
+              Assert.ok(gb101Rendered(doc.querySelector('setting-group[groupid="accountDisabled"]')),
+                "Redesign explicitly explains disabled account support");
+            } else {
+              Assert.ok(doc.getElementById("category-sync").hidden,
+                "Classic disabled supplier account section is hidden");
+            }
+            for (const group of doc.querySelectorAll('setting-group[groupid="account"],setting-group[groupid="sync"]')) {
+              Assert.ok(!gb101Rendered(group), "Disabled supplier account controls stay hidden");
+            }
+          }
+          await win.gotoPref("paneHome");
+          await win.gotoPref("panePrivacy");
+          let shown = BrowserTestUtils.waitForEvent(doc, "paneshown");
+          browser.goBack(); await shown;
+          await gb101AssertContent(win, "paneHome");
+          shown = BrowserTestUtils.waitForEvent(doc, "paneshown");
+          browser.goForward(); await shown;
+          await gb101AssertContent(win, "panePrivacy");
+          await win.gSearchResultsPane.initializeCategories();
+          win.gSearchResultsPane.searchInput.value = "PKI";
+          await win.gSearchResultsPane.searchFunction({ target: win.gSearchResultsPane.searchInput });
+          Assert.ok(gb101Rendered(doc.getElementById("goodBearRussianPKIEnabled")),
+            "Search exposes real Good Bear content and its checkbox");
+        });
+        for (let reopen = 0; reopen < 2; reopen++) {
+          await gb101WithPreferences(entry, "#goodBearRussianPKI", async win => {
+            await gb101AssertContent(win, "paneGoodBearRussianPKI");
+            await win.gGoodBearRussianPKIPane.ready;
+            Assert.ok(gb101Rendered(win.document.getElementById("goodBearRussianPKIEnabled")),
+              "Direct hash and reopen preserve a visible checkbox");
+          });
+        }
+      }
+    } finally {
+      await SpecialPowers.popPrefEnv();
+    }
+  }
+});
+
+add_task(async function test_checkbox_uses_actual_fresh_default_and_preserves_user_false() {
+  const hadUserValue = Services.prefs.prefHasUserValue(GB101_ENABLED);
+  const previous = Services.prefs.getBoolPref(GB101_ENABLED);
+  Services.prefs.clearUserPref(GB101_ENABLED);
+  try {
+    Assert.equal(Services.prefs.getDefaultBranch("").getBoolPref(GB101_ENABLED), true,
+      "Default-on is the actual native default branch, not a UI fallback");
+    Assert.ok(!Services.prefs.prefHasUserValue(GB101_ENABLED));
+    for (const redesign of [false, true]) {
+      await SpecialPowers.pushPrefEnv({ set: [["browser.settings-redesign.enabled", redesign]] });
+      try {
+        Services.prefs.clearUserPref(GB101_ENABLED);
+        await gb101WithPreferences("about:preferences", "#goodBearRussianPKI", async win => {
+          await gb101AssertContent(win, "paneGoodBearRussianPKI");
+          await win.gGoodBearRussianPKIPane.ready;
+          const checkbox = win.document.getElementById("goodBearRussianPKIEnabled");
+          Assert.ok(checkbox.checked && !checkbox.disabled);
+          checkbox.click();
+          Assert.equal(Services.prefs.getBoolPref(GB101_ENABLED), false);
+          Assert.ok(Services.prefs.prefHasUserValue(GB101_ENABLED));
+          Services.prefs.savePrefFile(null);
+          const prefs = await IOUtils.readUTF8(PathUtils.join(PathUtils.profileDir, "prefs.js"));
+          Assert.ok(prefs.includes('user_pref("security.goodbear.russian_pki.enabled", false);'),
+            "False is persisted for the subsequent real process-restart gate");
+        });
+        await gb101WithPreferences("about:settings", "#goodBearRussianPKI", async win => {
+          await gb101AssertContent(win, "paneGoodBearRussianPKI");
+          await win.gGoodBearRussianPKIPane.ready;
+          Assert.ok(!win.document.getElementById("goodBearRussianPKIEnabled").checked);
+          Assert.equal(Services.prefs.getBoolPref(GB101_ENABLED), false,
+            "Reinitialization never migrates an explicit false back to default-on");
+        });
+      } finally {
+        await SpecialPowers.popPrefEnv();
+      }
+    }
+  } finally {
+    if (hadUserValue) Services.prefs.setBoolPref(GB101_ENABLED, previous);
+    else Services.prefs.clearUserPref(GB101_ENABLED);
+  }
+});
+
+add_task(async function test_failed_goodbear_initialization_keeps_ordinary_content() {
+  for (const redesign of [false, true]) {
+    await SpecialPowers.pushPrefEnv({ set: [["browser.settings-redesign.enabled", redesign]] });
+    try {
+      await gb101WithPreferences("about:settings", "#home", async win => {
+        const load = win.loadGoodBearRussianPKIController;
+        win.loadGoodBearRussianPKIController = () => { throw Error("controlled missing Good Bear script"); };
+        try {
+          win.gCategoryInits.get("paneGoodBearRussianPKI")._initted = false;
+          await win.gotoPref("paneGoodBearRussianPKI");
+          await win.document.l10n.translateFragment(win.document.getElementById("goodBearRussianPKIPane"));
+          const error = win.document.getElementById("goodBearRussianPKIError");
+          Assert.ok(gb101Rendered(error) && error.textContent.trim(), "Local failure is rendered");
+          Assert.ok(win.document.getElementById("goodBearRussianPKIEnabled").disabled);
+          for (const category of ["paneHome", "paneSearch", "panePrivacy"]) {
+            await gb101AssertContent(win, category);
+          }
+        } finally {
+          win.loadGoodBearRussianPKIController = load;
