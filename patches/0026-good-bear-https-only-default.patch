# M11: make Good Bear HTTPS-only by default so Russian PKI routing begins
# with TLS even for HTTP links served without an HTTPS redirect.

diff --git a/browser/components/DesktopActorRegistry.sys.mjs b/browser/components/DesktopActorRegistry.sys.mjs
--- a/browser/components/DesktopActorRegistry.sys.mjs
+++ b/browser/components/DesktopActorRegistry.sys.mjs
@@ -341,8 +341,15 @@ let JSWINDOWACTORS = {
       events: {
         DOMContentLoaded: {},
       },
     },
-    matches: ["about:certerror?*", "about:neterror?*"],
+    // HTTPS-Only first attempts TLS and reports a failed connection via its
+    // own privileged error page.  Preserve the same native-PSM-only routing
+    // boundary there as on the ordinary certificate error pages.
+    matches: [
+      "about:certerror?*",
+      "about:neterror?*",
+      "about:httpsonlyerror?*",
+    ],
     allFrames: true,
     safeForUntrustedWebProcess: true,
   },

diff --git a/browser/app/profile/firefox.js b/browser/app/profile/firefox.js
--- a/browser/app/profile/firefox.js
+++ b/browser/app/profile/firefox.js
@@ -1606,7 +1606,13 @@ pref("security.certerrors.permanentOverride", true);
 pref("security.certerrors.mitm.priming.enabled", true);
 pref("security.certerrors.mitm.priming.endpoint", "https://mitmdetection.services.mozilla.com/");
 pref("security.certerrors.mitm.auto_enable_enterprise_roots", true);
 
+// Good Bear is security-first: never send a top-level HTTP request when its
+// HTTPS equivalent is available. The browser's built-in HTTPS-Only exception
+// UI remains the explicit recovery path for genuinely HTTP-only sites.
+pref("dom.security.https_only_mode", true);
+pref("dom.security.https_only_mode_pbm", true);
+
 // Whether the bookmark panel should be shown when bookmarking a page.
 pref("browser.bookmarks.editDialog.showForNewBookmarks", true);
 
