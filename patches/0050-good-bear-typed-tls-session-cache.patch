+TEST(TestTokensCache, CertificateExceptionNeverBecomesStandardOnResume)
+{
+  ClearAll();
+  using TrustDomain = nsITransportSecurityInfo::GoodBearTrustDomain;
+  using ErrorCategory = nsITransportSecurityInfo::OverridableErrorCategory;
+  RefPtr<CommonSocketControl> original = createDummySocketControl();
+  original->SetGoodBearTrustDomain(TrustDomain::Invalid);
+  original->SetStatusErrorBits(ErrorCategory::ERROR_TRUST);
+  auto token = MakeTestData(100);
+  ASSERT_NS_SUCCEEDED(mozilla::net::SSLTokensCache::Put(
+      "anon:example.com:443"_ns, token.Elements(), token.Length(), original,
+      PR_Now() + 3600LL * PR_USEC_PER_SEC));
+  auto resumed = SimulateResumedConnection("anon:example.com:443"_ns);
+  ASSERT_TRUE(resumed);
+  ASSERT_FALSE(resumed->IsCanceled());
+  nsCOMPtr<nsITransportSecurityInfo> info;
+  ASSERT_NS_SUCCEEDED(resumed->GetSecurityInfo(getter_AddRefs(info)));
+  TrustDomain domain = TrustDomain::Standard;
+  ASSERT_NS_SUCCEEDED(info->GetGoodBearTrustDomain(&domain));
+  ASSERT_EQ(domain, TrustDomain::Invalid);
+  ErrorCategory error = ErrorCategory::ERROR_UNSET;
+  ASSERT_NS_SUCCEEDED(info->GetOverridableErrorCategory(&error));
+  ASSERT_EQ(error, ErrorCategory::ERROR_TRUST);
+}
