+TEST(TestTokensCache, LegacyUnknownAndRussianMetadataCannotResume)
+{
+  using TrustDomain = nsITransportSecurityInfo::GoodBearTrustDomain;
+  // Mutate genuine compressed records, then exercise the same decoder and Get
+  // used by NSS and HTTP/3. Missing fields never become implicit Standard.
+  for (uint8_t mutation = 0; mutation < 5; ++mutation) {
+    SCOPED_TRACE(mutation);
+    ClearAll();
+    putToken("anon:example.com:443"_ns, 100);
+    auto records = mozilla::net::SSLTokensCache::SerializeForIPC();
+    ASSERT_EQ(records.Length(), 1u);
+    auto& encoded = records[0].compressedPayload;
+    ASSERT_GT(encoded.Length(), sizeof(uint32_t));
+    size_t rawLength = mozilla::LittleEndian::readUint32(encoded.Elements());
+    nsTArray<uint8_t> raw;
+    raw.SetLength(rawLength);
+    ASSERT_EQ(BrotliDecoderDecompress(encoded.Length() - sizeof(uint32_t),
+                                      encoded.Elements() + sizeof(uint32_t),
+                                      &rawLength, raw.Elements()),
+              BROTLI_DECODER_RESULT_SUCCESS);
+    ASSERT_EQ(rawLength, raw.Length());
+    ASSERT_GE(raw.Length(), 5u);
+    switch (mutation) {
+      case 0:
+        raw.TruncateLength(raw.Length() - 5);  // Legacy untyped payload.
+        break;
+      case 1:
+        raw.TruncateLength(raw.Length() - 1);  // Missing domain.
+        break;
+      case 2:
+        raw[raw.Length() - 5] = 0xff;  // Unknown version.
+        break;
+      case 3:
+        raw.LastElement() = 0xff;  // Unknown domain.
+        break;
+      case 4:
+        raw.LastElement() = static_cast<uint8_t>(TrustDomain::RussianPKI);
+        break;
+    }
+    size_t compressedLength = BrotliEncoderMaxCompressedSize(raw.Length());
+    nsTArray<uint8_t> compressed;
+    compressed.SetLength(compressedLength + sizeof(uint32_t));
+    mozilla::LittleEndian::writeUint32(compressed.Elements(), raw.Length());
+    ASSERT_TRUE(
+        BrotliEncoderCompress(1, BROTLI_DEFAULT_WINDOW, BROTLI_MODE_GENERIC,
+                              raw.Length(), raw.Elements(), &compressedLength,
+                              compressed.Elements() + sizeof(uint32_t)));
+    compressed.TruncateLength(compressedLength + sizeof(uint32_t));
+    nsTArray<uint8_t> decodedToken;
+    mozilla::net::SessionCacheInfo decodedInfo;
+    ASSERT_FALSE(mozilla::net::SSLTokensCache::DecodeCompressedPayload(
+        compressed, decodedToken, decodedInfo));
+    records[0].compressedPayload = std::move(compressed);
+    ClearAll();
+    mozilla::net::SSLTokensCache::DeserializeFromIPC(std::move(records), true);
+    decodedToken.AppendElement(42);
+    decodedInfo.mGoodBearTrustDomain = mozilla::Some(TrustDomain::Standard);
+    ASSERT_EQ(mozilla::net::SSLTokensCache::Get("anon:example.com:443"_ns,
+                                                decodedToken, decodedInfo),
+              NS_ERROR_NOT_AVAILABLE);
+    ASSERT_TRUE(decodedToken.IsEmpty());
+    ASSERT_FALSE(decodedInfo.mGoodBearTrustDomain);
+  }
+}
+
+TEST(TestTokensCache, RebuildRejectsUntypedOrRussianMetadata)
+{
+  using TrustDomain = nsITransportSecurityInfo::GoodBearTrustDomain;
+  const mozilla::Maybe<TrustDomain> domains[] = {
+      mozilla::Nothing(), mozilla::Some(TrustDomain::RussianPKI),
+      mozilla::Some(static_cast<TrustDomain>(0xff))};
+  for (auto domain : domains) {
+    RefPtr<CommonSocketControl> socket(
+        new CommonSocketControl("example.com"_ns, 443, 0));
+    mozilla::net::SessionCacheInfo info;
+    info.mGoodBearTrustDomain = domain;
+    socket->SetSessionCacheInfo(std::move(info));
+    socket->RebuildCertificateInfoFromSSLTokenCache();
+    ASSERT_TRUE(socket->IsCanceled());
+    ASSERT_EQ(socket->GetErrorCode(), SEC_ERROR_UNKNOWN_ISSUER);
+    nsCOMPtr<nsITransportSecurityInfo> restored;
+    ASSERT_NS_SUCCEEDED(socket->GetSecurityInfo(getter_AddRefs(restored)));
+    TrustDomain actual = TrustDomain::Standard;
+    ASSERT_NS_SUCCEEDED(restored->GetGoodBearTrustDomain(&actual));
+    ASSERT_EQ(actual, TrustDomain::Invalid);
+  }
+}
+
+TEST(TestTokensCache, RussianSessionNeverEntersTokenCache)
+{
+  ClearAll();
+  RefPtr<CommonSocketControl> socket = createDummySocketControl();
+  socket->SetGoodBearTrustDomain(
+      nsITransportSecurityInfo::GoodBearTrustDomain::RussianPKI);
+  auto token = MakeTestData(100);
+  ASSERT_TRUE(NS_FAILED(mozilla::net::SSLTokensCache::Put(
+      "anon:example.com:443"_ns, token.Elements(), token.Length(), socket,
+      PR_Now() + 3600LL * PR_USEC_PER_SEC)));
+  mozilla::net::SessionCacheInfo info;
+  ASSERT_EQ(
+      mozilla::net::SSLTokensCache::Get("anon:example.com:443"_ns, token, info),
+      NS_ERROR_NOT_AVAILABLE);
+}
