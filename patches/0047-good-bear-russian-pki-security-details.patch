+  "resource:///modules/GoodBearRussianPKIContainer.sys.mjs"
+);
+const TEST_URL =
+  "https://example.com/browser/browser/components/contextualidentity/test/browser/empty_file.html";
+
+add_task(
+  async function test_goodbear_marker_is_independent_of_standard_trust() {
+    await SpecialPowers.pushPrefEnv({
+      set: [["privacy.userContext.enabled", true]],
+    });
+    await GoodBearRussianPKIContainer.initialize();
+    const identity = GoodBearRussianPKIContainer.ensureContainer();
+    const { tab, browser } = await openTabInUserContext(
+      TEST_URL,
+      identity.userContextId
+    );
+    let ordinary;
+    try {
+      is(
+        browser.securityUI.secInfo.goodBearTrustDomain,
+        Ci.nsITransportSecurityInfo.Standard,
+        "Real STANDARD TLS remains STANDARD inside the managed container"
+      );
+      const marker = document.getElementById("userContext-icons");
+      const label = document.getElementById("userContext-label");
+      await document.l10n.translateElements([marker, label]);
+      ok(!marker.hidden, "The neutral container marker remains visible");
+      ok(
+        marker.classList.contains("identity-color-gray"),
+        "Neutral color is retained"
+      );
+      is(
+        label.getAttribute("data-l10n-id"),
+        "urlbar-goodbear-russian-pki-container-label",
+        "Visible container name is localized independently of TLS"
+      );
+      const [translation] = await document.l10n.formatMessages([
+        { id: "urlbar-goodbear-russian-pki-container-marker" },
+      ]);
+      for (const attribute of translation.attributes) {
+        is(
+          marker.getAttribute(attribute.name),
+          attribute.value,
+          "Isolation tooltip and accessible name use Fluent"
+        );
+      }
+      ok(
+        document.getElementById("trust-goodbear-russian-pki-label").hidden,
+        "A STANDARD chain does not acquire the Russian certificate badge"
+      );
+      ordinary = await BrowserTestUtils.openNewForegroundTab({
+        gBrowser,
+        url: TEST_URL,
+      });
+      ok(marker.hidden, "Ordinary context has no container marker");
+      ok(
+        !marker.hasAttribute("data-l10n-id"),
+        "Ordinary tab clears managed localization"
+      );
+      ok(
+        !marker.hasAttribute("aria-label"),
+        "Ordinary tab clears stale accessible name"
+      );
+    } finally {
+      if (ordinary) {
+        BrowserTestUtils.removeTab(ordinary);
+      }
+      BrowserTestUtils.removeTab(tab);
+      await SpecialPowers.popPrefEnv();
+    }
+  }
+);
+
+add_task(async function test_goodbear_verified_details_and_stale_viewer() {
+  for (const trustPanel of [false, true]) {
+    await SpecialPowers.pushPrefEnv({
+      set: [["browser.urlbar.trustPanel.featureGate", trustPanel]],
+    });
+    const win = await BrowserTestUtils.openNewBrowserWindow();
+    try {
+      const tab = await BrowserTestUtils.openNewForegroundTab({
+        gBrowser: win.gBrowser,
+        url: TEST_URL,
+      });
+      if (trustPanel) {
+        await win.gTrustPanel.showPopup();
+      } else {
+        win.gIdentityHandler._initializePopup();
+        win.gIdentityHandler.refreshIdentityPopup();
+      }
+      const handler = win.gIdentityHandler;
+      const doc = win.document;
+      const browser = tab.linkedBrowser;
+      is(
+        handler._getGoodBearRussianPKIDetails(browser),
+        null,
+        "Real STANDARD security info cannot show Russian PKI details"
+      );
+      const nativeInfo = browser.securityUI.secInfo;
+      // This is a UI rendering fixture using a real verified certificate path.
+      // It is not evidence that native TLS classified this server as Russian PKI.
+      const info = {
+        goodBearTrustDomain: Ci.nsITransportSecurityInfo.RussianPKI,
+        errorCode: 0,
+        serverCert: nativeInfo.serverCert,
+        succeededCertChain: nativeInfo.succeededCertChain,
+      };
+      Object.defineProperty(info, "handshakeCertificates", {
+        get() {
+          throw new Error("Unverified chain must never be read");
+        },
+      });
+      const fixture = {
+        securityUI: {
+          state: Ci.nsIWebProgressListener.STATE_IS_SECURE,
+          secInfo: info,
+        },
+        currentURI: browser.currentURI,
+        browsingContext: {
+          originAttributes: { userContextId: 1, privateBrowsingId: 0 },
+          currentWindowGlobal: browser.browsingContext.currentWindowGlobal,
+        },
+      };
+      handler._updateGoodBearRussianPKIDetails(fixture);
+      ok(
+        !doc.getElementById("goodbear-russian-pki-details").hidden,
+        "Both native popup variants render complete verified-path details"
+      );
+      is(
+        doc.getElementById("goodbear-russian-pki-leaf").textContent,
+        info.serverCert.subjectName,
+        "Leaf subject is displayed as text"
+      );
+      const anchor = info.succeededCertChain.at(-1);
+      is(
+        doc.getElementById("goodbear-russian-pki-root").textContent,
+        anchor.subjectName,
+        "Root is the verifier-selected path endpoint"
+      );
+      is(
+        doc.getElementById("goodbear-russian-pki-fingerprint").textContent,
+        anchor.sha256Fingerprint,
+        "Fingerprint belongs to that exact root"
+      );
+      const button = doc.getElementById(
+        "goodbear-russian-pki-view-certificate"
+      );
+      ok(
+        !button.disabled,
+        "Certificate action is a keyboard-accessible native button"
+      );
+      const tabCount = win.gBrowser.tabs.length;
+      button.doCommand();
+      is(
+        win.gBrowser.tabs.length,
+        tabCount,
+        "A fixture from a different document cannot open a certificate tab"
+      );
+      ok(
+        doc.getElementById("goodbear-russian-pki-details").hidden,
+        "Stale certificate details are cleared"
+      );
+      info.succeededCertChain = [];
+      handler._updateGoodBearRussianPKIDetails(fixture);
+      ok(button.disabled, "Missing verified path disables the viewer");
+      is(
+        doc.getElementById("goodbear-russian-pki-root").textContent,
+        "",
+        "Missing verified path never leaves an old anchor visible"
+      );
+    } finally {
+      await BrowserTestUtils.closeWindow(win);
+      await SpecialPowers.popPrefEnv();
+    }
+  }
+});
