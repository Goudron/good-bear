# Good Bear M4-04: complete X.509/TLS validation for exact scoped anchors
#
# Reuses the unchanged upstream CertVerifier with per-check exact DER anchors;
# preserves all normal TLS checks and never mutates NSS/profile/global trust.

--- /dev/null
+++ b/security/manager/ssl/GoodBearRussianPKIX509Verifier.h
@@ -0,0 +1,91 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef GoodBearRussianPKIX509Verifier_h
+#define GoodBearRussianPKIX509Verifier_h
+
+#include "CertVerifier.h"
+#include "EnterpriseRoots.h"
+#include "mozilla/Maybe.h"
+#include "mozpkix/Result.h"
+#include "nsTArray.h"
+
+namespace mozilla::psm {
+
+// Runs the normal upstream TLS server verifier with a local trust store whose
+// only additional roots are exact DER certificates already admitted by the M3
+// pin, provenance, role, and self-signature gates. This verifier is created for
+// one alternate check, so the roots never enter the profile or global NSS
+// trust store. M4-05 owns any safe cache/lifetime optimization.
+inline mozilla::pkix::Result VerifyGoodBearRussianPKISSLServerCert(
+    const CertVerifier& aVerificationSettings,
+    const nsTArray<uint8_t>& aPeerCert, mozilla::pkix::Time aTime,
+    void* aPinArg, const nsACString& aHostname,
+    /*out*/ nsTArray<nsTArray<uint8_t>>& aBuiltChain,
+    const nsTArray<nsTArray<uint8_t>>& aVerifiedExactTrustAnchors,
+    CertVerifier::Flags aFlags = 0,
+    const Maybe<nsTArray<nsTArray<uint8_t>>>& aExtraCertificates = Nothing(),
+    const Maybe<nsTArray<uint8_t>>& aStapledOCSPResponse = Nothing(),
+    const Maybe<nsTArray<uint8_t>>& aSctsFromTLS = Nothing(),
+    const Maybe<DelegatedCredentialInfo>& aDCInfo = Nothing(),
+    const OriginAttributes& aOriginAttributes = OriginAttributes(),
+    EVStatus* aEVStatus = nullptr,
+    CertVerifier::OCSPStaplingStatus* aOCSPStaplingStatus = nullptr,
+    KeySizeStatus* aKeySizeStatus = nullptr,
+    PinningTelemetryInfo* aPinningTelemetryInfo = nullptr,
+    CertificateTransparencyInfo* aCTInfo = nullptr,
+    bool* aIsBuiltChainRootBuiltInRoot = nullptr,
+    bool* aMadeOCSPRequests = nullptr,
+    IssuerSources* aIssuerSources = nullptr) {
+  if (aVerifiedExactTrustAnchors.IsEmpty()) {
+    return mozilla::pkix::Result::FATAL_ERROR_INVALID_ARGS;
+  }
+
+  nsTArray<EnterpriseCert> exactTrustAnchors;
+  for (const auto& anchorDER : aVerifiedExactTrustAnchors) {
+    if (anchorDER.IsEmpty()) {
+      return mozilla::pkix::Result::FATAL_ERROR_INVALID_ARGS;
+    }
+    exactTrustAnchors.EmplaceBack(anchorDER.Elements(), anchorDER.Length(),
+                                  true);
+  }
+
+  CertVerifier alternateVerifier(
+      aVerificationSettings.mOCSPDownloadConfig,
+      aVerificationSettings.mOCSPStrict ? CertVerifier::ocspStrict
+                                        : CertVerifier::ocspRelaxed,
+      aVerificationSettings.mOCSPTimeoutSoft,
+      aVerificationSettings.mOCSPTimeoutHard,
+      aVerificationSettings.mCertShortLifetimeInDays,
+      CertVerifier::CertificateTransparencyConfig(
+          aVerificationSettings.mCTConfig.mMode,
+          nsCString(aVerificationSettings.mCTConfig.mSkipForHosts),
+          aVerificationSettings.mCTConfig.mSkipForSPKIHashes.Clone()),
+      aVerificationSettings.mCRLiteMode, exactTrustAnchors);
+
+  mozilla::pkix::Result result = alternateVerifier.VerifySSLServerCert(
+      aPeerCert, aTime, aPinArg, aHostname, aBuiltChain, aFlags,
+      aExtraCertificates, aStapledOCSPResponse, aSctsFromTLS, aDCInfo,
+      aOriginAttributes, aEVStatus, aOCSPStaplingStatus, aKeySizeStatus,
+      aPinningTelemetryInfo, aCTInfo, aIsBuiltChainRootBuiltInRoot,
+      aMadeOCSPRequests, aIssuerSources);
+  if (result != mozilla::pkix::Success) {
+    return result;
+  }
+  if (aBuiltChain.IsEmpty()) {
+    return mozilla::pkix::Result::FATAL_ERROR_LIBRARY_FAILURE;
+  }
+  for (const auto& anchorDER : aVerifiedExactTrustAnchors) {
+    if (aBuiltChain.LastElement() == anchorDER) {
+      return mozilla::pkix::Success;
+    }
+  }
+
+  aBuiltChain.Clear();
+  return mozilla::pkix::Result::ERROR_UNKNOWN_ISSUER;
+}
+
+}  // namespace mozilla::psm
+
+#endif  // GoodBearRussianPKIX509Verifier_h
