+TEST_F(GoodBearRussianPKIX509Test,
+       CompleteUpstreamValidationAcceptsExactAnchorOnlyInScopedFlow) {
+  PKIXResult alternateResult = PKIXResult::FATAL_ERROR_INVALID_STATE;
+  auto result =
+      ClassifyRussianPKI("russian-leaf.pem"_ns, "test-russian.example"_ns,
+                         {"russian-intermediate.pem"}, alternateResult);
+
+  ASSERT_EQ(Success, alternateResult);
+  ASSERT_EQ(GoodBearTrustDomain::RussianPKI, result.mTrustDomain);
+  ASSERT_EQ(Success, result.mResult);
+  ASSERT_TRUE(result.ChannelUsable());
+}
+
+TEST_F(GoodBearRussianPKIX509Test,
+       AlternateVerifierDoesNotMutateOrdinaryOrGlobalTrust) {
+  ASSERT_NE(Success, VerifyStandardRussianPKI());
+  ASSERT_EQ(Success,
+            VerifyRussianPKI("russian-leaf.pem"_ns, "test-russian.example"_ns,
+                             {"russian-intermediate.pem"}));
+  ASSERT_NE(Success, VerifyStandardRussianPKI());
+}
+
+TEST_F(GoodBearRussianPKIX509Test, EmptyAnchorSetFailsClosed) {
+  nsTArray<uint8_t> leaf = ReadCertificateFixture("russian-leaf.pem"_ns);
+  nsTArray<nsTArray<uint8_t>> noAnchors;
+  nsTArray<nsTArray<uint8_t>> builtChain;
+  ASSERT_EQ(PKIXResult::FATAL_ERROR_INVALID_ARGS,
+            VerifyGoodBearRussianPKISSLServerCert(
+                *mVerifier, leaf, TimeFromEpochInSeconds(1787832000), nullptr,
+                "test-russian.example"_ns, builtChain, noAnchors,
+                CertVerifier::FLAG_LOCAL_ONLY));
+}
+
+TEST_F(GoodBearRussianPKIX509Test, SameNameFakeRootDoesNotMatchExactAnchor) {
+  PKIXResult alternateResult = Success;
+  auto result =
+      ClassifyRussianPKI("same-name-fake-leaf.pem"_ns,
