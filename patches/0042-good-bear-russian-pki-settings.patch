+add_task(async function test_goodbear_settings_reset_failure_keeps_isolation() {
+  await withGoodBearPane(async context => {
+    const { pane, doc } = context;
+    await seedAssignments(pane);
+    const store = pane._manager.assignmentStore;
+    const write = store._write;
+    store._write = async () => {
+      throw new Error("Deliberate settings persistence failure");
+    };
+    try {
+      ok(
+        !(await answerReset(context, "https://one.example.test", 0)),
+        "Single reset reports failed persistence"
+      );
+      ok(
+        !(await answerReset(context, null, 0)),
+        "Clear-all reports failed persistence"
+      );
+      is(
+        store.assignments().length,
+        2,
+        "Assignments preserved by actual manager rollback"
+      );
+      is(
+        pane._manager.trustHistoryStore.entries().length,
+        2,
+        "Paired history restored"
+      );
+      ok(
+        !doc.getElementById("goodBearRussianPKIError").hidden,
+        "Failure is accessible and visible"
+      );
+      is(
+        doc.querySelectorAll("#goodBearRussianPKISites li").length,
+        2,
+        "UI does not advertise a failed deletion"
+      );
+    } finally {
+      store._write = write;
+    }
+  }, true);
+});
