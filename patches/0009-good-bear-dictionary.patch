new file mode 100644
--- /dev/null
+++ b/browser/components/tests/browser/browser_goodbear_spellcheck.js
@@ -0,0 +1,115 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+"use strict";
+
+// Run on the current Russian repack with its bundled distribution extension.
+// Installing a temporary dictionary here would hide packaging/startup defects.
+add_task(async function test_shipped_russian_dictionary_and_release_regressions() {
+  const { AddonManager } = ChromeUtils.importESModule(
+    "resource://gre/modules/AddonManager.sys.mjs"
+  );
+  const addon = await AddonManager.getAddonByID(
+    "russian-spell-dictionary@valery-ledovskoy"
+  );
+  Assert.ok(addon?.isActive, "The shipped primary dictionary is active");
+  Assert.equal(addon.version, "1.0.9");
+  const engine = Cc["@mozilla.org/spellchecker/engine;1"].getService(
+    Ci.mozISpellCheckingEngine
+  );
+  await TestUtils.waitForCondition(
+    () => engine.getDictionaryList().includes("ru"),
+    "The bundled Russian dictionary registers without a network download"
+  );
+  const available = engine.getDictionaryList();
+  Assert.equal(available.filter(name => name === "ru").length, 1);
+  Assert.ok(available.includes("en-US"), "Built-in English is retained");
+  const previous = engine.dictionaries;
+  try {
+    engine.dictionaries = ["ru"];
+    Assert.ok(engine.check("карета"));
+    Assert.ok(!engine.check("корета"));
+    const csv = await (
+      await fetch(getRootDirectory(gTestPath) + "goodbear_dictionary_109.csv")
+    ).text();
+    for (const row of csv.trim().split("\n").slice(1)) {
+      const [word, target, , status, rank] = row.split(",");
+      if (status === "input-accepted-equivalence") {
+        Assert.ok(engine.check(word), `${word}: release equivalence retained`);
+      } else {
+        Assert.ok(!engine.check(word), `${word}: release typo rejected`);
+        if (Number(rank)) {
+          const position = engine.suggest(word).indexOf(target);
+          Assert.ok(position >= 0 && position < Number(rank),
+            `${word} -> ${target}: reviewed release suggestion bound`);
+        } else {
+          info(`${word}: release records a remaining suggestion gap`);
+        }
+      }
+    }
+    engine.dictionaries = ["en-US"];
+    Assert.ok(engine.check("hello"));
+    Assert.ok(!engine.check("helllo"));
+    engine.dictionaries = ["ru", "en-US"];
+    for (const word of ["карета", "hello"]) {
+      Assert.ok(engine.check(word), `${word}: correct mixed-language word`);
+    }
+    for (const word of ["корета", "helllo"]) {
+      Assert.ok(!engine.check(word), `${word}: mixed-language error`);
+    }
+  } finally {
+    engine.dictionaries = previous;
+  }
+});
+
+add_task(async function test_actual_editor_marks_mixed_language_errors() {
+  const html = '<meta charset="utf-8"><textarea lang="ru" spellcheck="true">' +
+    "карета корета hello helllo</textarea>";
+  await BrowserTestUtils.withNewTab(
+    "data:text/html;charset=utf-8," + encodeURIComponent(html), async browser => {
+      await SpecialPowers.spawn(browser, [], async () => {
+        const { maybeOnSpellCheck } = ChromeUtils.importESModule(
+          "resource://testing-common/AsyncSpellCheckTestHelper.sys.mjs"
+        );
+        const textarea = content.document.querySelector("textarea");
+        textarea.focus();
+        await new Promise(resolve => maybeOnSpellCheck(textarea, resolve));
+        const editor = SpecialPowers.wrap(textarea).editor;
+        const inline = editor.getInlineSpellChecker(true);
+        await inline.spellChecker.setCurrentDictionaries(["ru", "en-US"]);
+        inline.enableRealTimeSpell = true;
+        inline.spellCheckRange(null);
+        await new Promise(resolve => maybeOnSpellCheck(textarea, resolve));
+        const selection = editor.selectionController.getSelection(
+          Ci.nsISelectionController.SELECTION_SPELLCHECK
+        );
+        const marked = Array.from({ length: selection.rangeCount },
+          (_, index) => selection.getRangeAt(index).toString());
+        Assert.deepEqual(marked, ["корета", "helllo"],
+          "Real spelling ranges mark errors and leave correct words unmarked");
+      });
+    }
+  );
+});
+
+add_task(async function test_defaults_and_existing_profile_language_choices() {
+  Assert.equal(Services.prefs.getDefaultBranch("").getIntPref(
+    "layout.spellcheckDefault"), 1, "Actual fresh-profile default branch");
+  for (const languages of ["en-US", "ru,en-US"]) {
+    await SpecialPowers.pushPrefEnv({ set: [
+      ["spellchecker.dictionary", languages], ["layout.spellcheckDefault", 0],
+    ] });
+    try {
+      for (let reopen = 0; reopen < 2; reopen++) {
+        await BrowserTestUtils.withNewTab("about:preferences", async () => {
+          Assert.equal(Services.prefs.getStringPref("spellchecker.dictionary"), languages);
+          Assert.equal(Services.prefs.getIntPref("layout.spellcheckDefault"), 0);
+        });
+      }
+    } finally {
+      await SpecialPowers.popPrefEnv();
+    }
+  }
+  // Separate native restart/migrated-profile invocation must use the same
+  // persisted profile; opening another tab is not a process restart claim.
+});
