# M11-02: prove that the actual browser network boundary drops ordinary
# cookie, referrer, and opener state when a known origin is reopened in the
# managed Russian PKI container.

diff --git a/browser/components/contextualidentity/test/browser/browser.toml b/browser/components/contextualidentity/test/browser/browser.toml
