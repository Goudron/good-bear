+// fstec.ru omits the reviewed RSA-2024 issuing certificate from its live TLS
+// handshake. The alternate verifier must use only the hash-pinned issuer
+// material generated from the controlled M3 build input; it must not fetch
+// the AIA URL or broaden ordinary/global trust.
+TEST_F(GoodBearRussianPKIX509Test,
+       ProductionRSA2024IssuerCompletesFSTECMissingIntermediateChain) {
+  nsTArray<uint8_t> leaf =
+      ReadCertificateFixture("fstec-rsa2024-leaf.pem"_ns);
+  ASSERT_FALSE(leaf.IsEmpty());
+
+  nsTArray<nsTArray<uint8_t>> roots;
+  GetGoodBearRussianPKIExactTrustAnchors(roots);
+  ASSERT_EQ(1U, roots.Length());
+  nsTArray<nsTArray<uint8_t>> intermediates;
+  GetGoodBearRussianPKIApprovedIntermediates(intermediates);
+  ASSERT_GE(intermediates.Length(), 1U);
+
+  nsTArray<nsTArray<uint8_t>> builtChain;
+  ASSERT_EQ(Success,
+            VerifyGoodBearRussianPKISSLServerCert(
+                *mVerifier, leaf, TimeFromEpochInSeconds(1787832000),
+                nullptr, "fstec.ru"_ns, builtChain, roots,
+                CertVerifier::FLAG_LOCAL_ONLY,
+                Some(std::move(intermediates))));
+  ASSERT_EQ(3U, builtChain.Length());
+}
