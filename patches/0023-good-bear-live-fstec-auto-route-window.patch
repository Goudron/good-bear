+// <browser> is an XUL element, not a window-global object.  In live desktop
+// windows it has a top Chrome BrowsingContext but no ownerGlobal property.
+// Keep the lookup in one fail-closed helper so certificate-error recovery,
+// assigned-origin blocking, and the deferred callback use the same real
+// browser window without widening any trust decision.
+function getBrowserWindow(browser) {
+  const window =
+    browser?.browsingContext?.topChromeWindow ??
+    browser?.ownerGlobal ??
+    browser?.ownerDocument?.defaultView;
+  return window && !window.closed ? window : null;
+}
