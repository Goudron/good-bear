diff --git a/security/manager/ssl/tests/gtest/GoodBearSelectedChainTest.cpp b/security/manager/ssl/tests/gtest/GoodBearSelectedChainTest.cpp
new file mode 100644
--- /dev/null
+++ b/security/manager/ssl/tests/gtest/GoodBearSelectedChainTest.cpp
@@ -0,0 +1,138 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include <cstring>
+
+#include "CertVerifier.h"
+#include "EnterpriseRoots.h"
+#include "GoodBearRussianPKIAnchors.h"
+#include "GoodBearRussianPKIScopeLease.h"
+#include "ScopedNSSTypes.h"
+#include "cert.h"
+#include "gtest/gtest.h"
+#include "nsDirectoryServiceDefs.h"
+#include "nsDirectoryServiceUtils.h"
+#include "nsIFile.h"
+#include "nsIInputStream.h"
+#include "nsNetUtil.h"
+#include "nsStreamUtils.h"
+#include "nss.h"
+using namespace mozilla;
+using namespace mozilla::pkix;
+using namespace mozilla::psm;
+using Domain = nsITransportSecurityInfo::GoodBearTrustDomain;
+
+namespace {
+nsTArray<uint8_t> Fixture(const char* aName) {
+  nsCOMPtr<nsIFile> file;
+  if (NS_FAILED(NS_GetSpecialDirectory(NS_OS_CURRENT_WORKING_DIR,
+                                      getter_AddRefs(file))) ||
+      NS_FAILED(file->AppendNative(nsDependentCString(aName)))) {
+    return {};
+  }
+  nsCOMPtr<nsIInputStream> stream;
+  if (NS_FAILED(NS_NewLocalFileInputStream(getter_AddRefs(stream), file))) {
+    return {};
+  }
+  nsCString pem;
+  if (NS_FAILED(NS_ConsumeStream(stream, UINT32_MAX, pem))) { return {}; }
+  UniqueCERTCertificate cert(CERT_DecodeCertFromPackage(pem.BeginWriting(), pem.Length()));
+  return cert ? nsTArray<uint8_t>(cert->derCert.data, cert->derCert.len)
+              : nsTArray<uint8_t>();
+}
+}  // namespace
+
+TEST(psm_GoodBearSelectedChain, ExactRolesAndUnusedAlternativePath) {
+  nsTArray<nsTArray<uint8_t>> chain;
+  EXPECT_EQ(GetGoodBearSelectedAnchor(chain), GoodBearSelectedAnchor::MissingMetadata);
+  chain.AppendElement(nsTArray<uint8_t>{1});
+  chain.AppendElement(nsTArray<uint8_t>(kGoodBearRussianPKIExactRoot,
+                                      sizeof(kGoodBearRussianPKIExactRoot)));
+  EXPECT_EQ(GetGoodBearSelectedAnchor(chain), GoodBearSelectedAnchor::RussianRoot);
+  // A selected public root wins; unused Russian material never forces a
+  // different chain or a secondary verification.
+  chain.AppendElement(nsTArray<uint8_t>{2});
+  EXPECT_EQ(GetGoodBearSelectedAnchor(chain), GoodBearSelectedAnchor::Other);
+  chain.LastElement() = nsTArray<uint8_t>(kGoodBearRussianPKIApprovedIntermediateRSA2022,
+      sizeof(kGoodBearRussianPKIApprovedIntermediateRSA2022));
+  EXPECT_EQ(GetGoodBearSelectedAnchor(chain), GoodBearSelectedAnchor::ApprovedIntermediate);
+  chain.LastElement() = nsTArray<uint8_t>(kGoodBearRussianPKIApprovedIntermediateRSA2024,
+      sizeof(kGoodBearRussianPKIApprovedIntermediateRSA2024));
+  EXPECT_EQ(GetGoodBearSelectedAnchor(chain), GoodBearSelectedAnchor::ApprovedIntermediate);
+  chain.LastElement()[0] ^= 1;
+  EXPECT_EQ(GetGoodBearSelectedAnchor(chain), GoodBearSelectedAnchor::Other);
+  chain[0].Clear();
+  EXPECT_EQ(GetGoodBearSelectedAnchor(chain), GoodBearSelectedAnchor::MissingMetadata);
+}
+
+TEST(psm_GoodBearSelectedChain, EnterpriseSuccessAndInvalidLeafRestrictions) {
+  ASSERT_EQ(SECSuccess, NSS_NoDB_Init(nullptr));
+  const auto root = Fixture("russian-root.pem");
+  const auto intermediate = Fixture("russian-intermediate.pem");
+  ASSERT_FALSE(root.IsEmpty());
+  ASSERT_FALSE(intermediate.IsEmpty());
+  nsTArray<EnterpriseCert> enterprise;
+  enterprise.EmplaceBack(root.Elements(), root.Length(), true);
+  CertVerifier verifier(CertVerifier::ocspOff, CertVerifier::ocspRelaxed,
+      TimeDuration::FromSeconds(1), TimeDuration::FromSeconds(1), 10,
+      CertVerifier::CertificateTransparencyConfig(
+          CertVerifier::CertificateTransparencyMode::Disabled, nsCString(),
+          nsTArray<CopyableTArray<uint8_t>>()), CRLiteMode::Disabled, enterprise);
+  for (const char* name : {"russian-leaf.pem", "wrong-hostname-leaf.pem",
+                            "expired-leaf.pem", "bad-signature-leaf.pem"}) {
+    const auto leaf = Fixture(name);
+    ASSERT_FALSE(leaf.IsEmpty());
+    nsTArray<nsTArray<uint8_t>> extra;
+    extra.AppendElement(intermediate.Clone());
+    nsTArray<nsTArray<uint8_t>> built;
+    const nsCString host = strcmp(name, "expired-leaf.pem") == 0
+        ? "expired-russian.example"_ns
+        : strcmp(name, "bad-signature-leaf.pem") == 0
+              ? "bad-signature-russian.example"_ns : "test-russian.example"_ns;
+    const auto validationTime = strcmp(name, "expired-leaf.pem") == 0
+        ? TimeFromEpochInSeconds(2524608000)
+        : TimeFromEpochInSeconds(1787832000);
+    const auto validation = verifier.VerifySSLServerCert(
+        leaf, validationTime, nullptr,
+        host, built, CertVerifier::FLAG_LOCAL_ONLY,
+        Some(std::move(extra)));
+    const bool valid = strcmp(name, "russian-leaf.pem") == 0;
+    EXPECT_EQ(validation == Success, valid);
+    // TEST-ONLY role constructor: exact selected fixture root, not a release
+    // pref, arbitrary CA override, or production anchor replacement.
+    const auto identity = !built.IsEmpty() && built.LastElement() == root
+        ? GoodBearSelectedAnchor::RussianRoot
+        : GoodBearSelectedAnchor::MissingMetadata;
+    if (valid) { ASSERT_EQ(identity, GoodBearSelectedAnchor::RussianRoot); }
+    for (bool managed : {false, true}) {
+      int alternateCalls = 0;
+      const auto decision = EvaluateGoodBearSelectedChain(validation, identity,
+          true, false, managed, []() { return true; }, [&]() {
+            ++alternateCalls; return mozilla::pkix::Result::ERROR_BAD_SIGNATURE;
+          });
+      EXPECT_EQ(decision.ChannelUsable(), valid && managed);
+      EXPECT_EQ(decision.mContainerRequired, valid && !managed);
+      EXPECT_FALSE(decision.mAllowCertificateOverride);
+      EXPECT_EQ(alternateCalls,
+                validation == mozilla::pkix::Result::ERROR_UNKNOWN_ISSUER ? 1 : 0);
+    }
+  }
+}
+
+TEST(psm_GoodBearSelectedChain, DisableReenableAndTrustRotationRevokeOldLease) {
+  for (bool rotate : {false, true}) {
+    GoodBearRussianPKIScopeLeaseState state;
+    ASSERT_TRUE(state.Publish(17));
+    const auto lease = state.Capture(17, false);
+    if (rotate) { state.Rotate(); }
+    else { state.Publish(0); ASSERT_TRUE(state.Publish(17)); }
+    EXPECT_FALSE(state.Matches(lease, 17, false));
+    const auto decision = EvaluateGoodBearSelectedChain(Success,
+        GoodBearSelectedAnchor::RussianRoot, true, false, true,
+        [&]() { return state.Matches(lease, 17, false); },
+        []() { ADD_FAILURE(); return Success; });
+    EXPECT_FALSE(decision.ChannelUsable());
+    EXPECT_FALSE(decision.mContainerRequired);
+    EXPECT_FALSE(decision.mAllowCertificateOverride);
+  }
+}
