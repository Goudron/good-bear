@@ -0,0 +1,45 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+"use strict";
+// Actual profile-trust/selected-chain API regression. Controlled roots are
+// test CAs, not production Russian anchors; native policy roles are exercised
+// separately by the bounded gtest constructor. No runtime trust injection.
+do_get_profile();
+const certDB = Cc["@mozilla.org/security/x509certdb;1"].getService(Ci.nsIX509CertDB);
+function fixture(name, trust = ",,") {
+  return addCertFromFile(certDB, `goodbear-selected-chain/${name}.pem`, trust);
+}
+function verify(cert, hostname = "gb101.example") {
+  return new Promise(resolve => certDB.asyncVerifyCertAtTime(
+    cert, Ci.nsIX509CertDB.verifyUsageTLSServer, Ci.nsIX509CertDB.FLAG_LOCAL_ONLY,
+    hostname, 1791158400, [], {verifyCertFinished(error, chain) { resolve({error, chain}); }}
+  ));
+}
+add_task(async function selected_profile_chain_and_removal() {
+  Services.prefs.setIntPref("security.OCSP.enabled", 0);
+  const russian = fixture("controlled-russian-root", "C,,");
+  const publicRoot = fixture("controlled-public-root");
+  fixture("controlled-russian-intermediate");
+  fixture("controlled-public-intermediate");
+  const leaf = fixture("controlled-leaf");
+  try {
+    let result = await verify(leaf);
+    equal(result.error, 0, "normally trusted fixture succeeds without UNKNOWN_ISSUER");
+    equal(result.chain.at(-1).sha256Fingerprint, russian.sha256Fingerprint,
+          "actual selected root is exposed by verified-chain API");
+    notEqual((await verify(leaf, "wrong.example")).error, 0, "hostname remains enforced");
+    notEqual((await verify(fixture("controlled-expired-leaf"))).error, 0, "time remains enforced");
+    certDB.setCertTrust(russian, Ci.nsIX509Cert.CA_CERT, 0);
+    certDB.setCertTrust(publicRoot, Ci.nsIX509Cert.CA_CERT, Ci.nsIX509CertDB.TRUSTED_SSL);
+    result = await verify(leaf);
+    equal(result.error, 0, "the selected public path works independently");
+    equal(result.chain.at(-1).sha256Fingerprint, publicRoot.sha256Fingerprint,
+          "unused Russian path does not determine selected identity");
+    certDB.setCertTrust(publicRoot, Ci.nsIX509Cert.CA_CERT, 0);
+    notEqual((await verify(leaf)).error, 0, "root removal does not leave cached trust");
+  } finally {
+    certDB.setCertTrust(russian, Ci.nsIX509Cert.CA_CERT, 0);
+    certDB.setCertTrust(publicRoot, Ci.nsIX509Cert.CA_CERT, 0);
+    Services.prefs.clearUserPref("security.OCSP.enabled");
+  }
+});
