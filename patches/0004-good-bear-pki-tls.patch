+  ASSERT_TRUE(authority.Allows(AttributesFor(17)));
+
+  ASSERT_FALSE(authority.SetManagedContainer(0));
+  ASSERT_FALSE(authority.DedicatedUserContextId().isSome());
+  ASSERT_FALSE(authority.Allows(AttributesFor(17)));
+}
