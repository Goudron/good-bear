+  Standard,
+  RussianPKIRequired,
+  Invalid,
+};
+
+// A successful alternate check in an ordinary context is an address-only
+// routing signal, never a certificate exception.  In particular, a matching
+// upstream per-host override must not convert the failed ordinary channel
+// into a usable one before the managed container is opened.
+inline bool GoodBearOrdinaryClassificationAllowsCertificateOverrides(
+    GoodBearOrdinaryTrustClassification aClassification) {
+  return aClassification !=
+         GoodBearOrdinaryTrustClassification::RussianPKIRequired;
+}
+
+struct GoodBearOrdinaryVerificationResult {
+  GoodBearOrdinaryTrustClassification mClassification;
+  mozilla::pkix::Result mOriginalResult;
+
+  bool OrdinaryChannelUsable() const {
+    return mClassification == GoodBearOrdinaryTrustClassification::Standard;
+  }
+
+  nsITransportSecurityInfo::GoodBearTrustDomain TransportTrustDomain() const {
+    return OrdinaryChannelUsable()
+               ? nsITransportSecurityInfo::GoodBearTrustDomain::Standard
+               : nsITransportSecurityInfo::GoodBearTrustDomain::Invalid;
+  }
+};
+
+inline bool IsGoodBearRussianPKISecondaryVerificationEligible(
+    mozilla::pkix::Result aStandardResult) {
+  return aStandardResult == mozilla::pkix::Result::ERROR_UNKNOWN_ISSUER;
+}
+
+inline GoodBearOrdinaryVerificationResult
+ClassifyGoodBearOrdinaryServerCertificate(
+    mozilla::pkix::Result aStandardResult,
+    mozilla::FunctionRef<mozilla::pkix::Result()> aVerifyRussianPKI) {
+  if (aStandardResult == mozilla::pkix::Success) {
+    return {GoodBearOrdinaryTrustClassification::Standard, aStandardResult};
+  }
+
+  if (!IsGoodBearRussianPKISecondaryVerificationEligible(aStandardResult)) {
+    return {GoodBearOrdinaryTrustClassification::Invalid, aStandardResult};
+  }
+
+  if (aVerifyRussianPKI() == mozilla::pkix::Success) {
+    return {GoodBearOrdinaryTrustClassification::RussianPKIRequired,
+            aStandardResult};
+  }
+
+  return {GoodBearOrdinaryTrustClassification::Invalid, aStandardResult};
+}
+
+}  // namespace mozilla::psm
+
+#endif  // GoodBearRussianPKIClassification_h
diff --git a/security/manager/ssl/GoodBearRussianPKIContainerScope.h b/security/manager/ssl/GoodBearRussianPKIContainerScope.h
new file mode 100644
--- /dev/null
+++ b/security/manager/ssl/GoodBearRussianPKIContainerScope.h
@@ -0,0 +1,139 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef GoodBearRussianPKIContainerScope_h
+#define GoodBearRussianPKIContainerScope_h
+
+#include <stdint.h>
+
+#include "GoodBearRussianPKIClassification.h"
+#include "mozilla/FunctionRef.h"
+#include "mozilla/Maybe.h"
+#include "mozilla/OriginAttributes.h"
+#include "mozpkix/Result.h"
+#include "nsIScriptSecurityManager.h"
+#include "nsITransportSecurityInfo.h"
+#include "prerror.h"
+
+namespace mozilla::psm {
+
+// This is an immutable snapshot of the managed-container state used by a
+// scope-authority callback. A missing/default userContextId is never a
+// dedicated container, even when the feature is nominally enabled.
+struct GoodBearRussianPKIContainerScope final {
+  bool mEnabled = false;
+  mozilla::Maybe<uint32_t> mDedicatedUserContextId;
+
+  bool Allows(const mozilla::OriginAttributes& aOriginAttributes) const {
+    return mEnabled && mDedicatedUserContextId.isSome() &&
+           mDedicatedUserContextId.ref() !=
+               nsIScriptSecurityManager::DEFAULT_USER_CONTEXT_ID &&
+           aOriginAttributes.mPrivateBrowsingId == 0 &&
+           aOriginAttributes.mUserContextId == mDedicatedUserContextId.ref();
+  }
+};
+
+struct GoodBearContainerVerificationResult final {
+  nsITransportSecurityInfo::GoodBearTrustDomain mTrustDomain =
+      nsITransportSecurityInfo::GoodBearTrustDomain::Invalid;
+  mozilla::pkix::Result mResult =
+      mozilla::pkix::Result::FATAL_ERROR_INVALID_STATE;
+
+  bool ChannelUsable() const {
+    if (mResult != mozilla::pkix::Success) {
+      return false;
+    }
+    switch (mTrustDomain) {
+      case nsITransportSecurityInfo::GoodBearTrustDomain::Standard:
+      case nsITransportSecurityInfo::GoodBearTrustDomain::RussianPKI:
+        return true;
+      case nsITransportSecurityInfo::GoodBearTrustDomain::Invalid:
+        return false;
+    }
+    return false;
+  }
+};
+
+// The counters are supplied by the bounded owner of a verification policy
+// snapshot. They deliberately record paths, not certificate names, hosts, or
+// origin attributes. A later telemetry owner may export aggregate values, but
+// must never use them to make a trust decision.
+struct GoodBearRussianPKIVerificationCounters final {
+  uint64_t mStandardResults = 0;
+  uint64_t mSecondaryChecks = 0;
+  uint64_t mSecondarySuccesses = 0;
+
+  void RecordStandardResult() { ++mStandardResults; }
+  void RecordSecondaryCheck(mozilla::pkix::Result aResult) {
+    ++mSecondaryChecks;
+    if (aResult == mozilla::pkix::Success) {
+      ++mSecondarySuccesses;
+    }
+  }
+};
+
+// aScopeAllows must consult the current managed-container state. It is called
+// both before and after alternate verification so disablement, deletion, or
+// recreation while verification is in flight cannot authorize a stale
+// userContextId. M4-04 owns the implementation behind
+// aVerifyAgainstExactRussianPKIAnchors.
+inline GoodBearContainerVerificationResult
+ClassifyGoodBearContainerServerCertificate(
+    mozilla::pkix::Result aStandardResult,
+    const mozilla::OriginAttributes& aOriginAttributes,
+    mozilla::FunctionRef<bool(const mozilla::OriginAttributes&)> aScopeAllows,
+    mozilla::FunctionRef<mozilla::pkix::Result()>
+        aVerifyAgainstExactRussianPKIAnchors,
+    GoodBearRussianPKIVerificationCounters* aCounters = nullptr) {
+  if (aStandardResult == mozilla::pkix::Success) {
+    if (aCounters) {
+      aCounters->RecordStandardResult();
+    }
+    return {nsITransportSecurityInfo::GoodBearTrustDomain::Standard,
+            mozilla::pkix::Success};
+  }
+
+  if (!IsGoodBearRussianPKISecondaryVerificationEligible(aStandardResult) ||
+      !aScopeAllows(aOriginAttributes)) {
+    return {nsITransportSecurityInfo::GoodBearTrustDomain::Invalid,
+            aStandardResult};
+  }
+
+  mozilla::pkix::Result alternateResult =
+      aVerifyAgainstExactRussianPKIAnchors();
+  if (aCounters) {
+    aCounters->RecordSecondaryCheck(alternateResult);
+  }
+  if (alternateResult != mozilla::pkix::Success ||
+      !aScopeAllows(aOriginAttributes)) {
+    return {nsITransportSecurityInfo::GoodBearTrustDomain::Invalid,
+            aStandardResult};
+  }
+
+  return {nsITransportSecurityInfo::GoodBearTrustDomain::RussianPKI,
+          mozilla::pkix::Success};
+}
+
+// Preserve the scope at the start of the verification decision. A later scope
+// revocation must not turn a rejected alternate-trust attempt into permission
+// to resume the same connection through an existing certificate exception.
+// Ordinary non-Russian failures retain Firefox's own exception handling.
+inline PRErrorCode ResolveGoodBearCertificateOverride(
+    GoodBearOrdinaryTrustClassification aOrdinaryClassification,
+    bool aStartedInManagedContainer, mozilla::pkix::Result aStandardResult,
+    PRErrorCode aOriginalError,
+    mozilla::FunctionRef<PRErrorCode()> aApplyUpstreamOverride) {
+  if (aOriginalError == 0 ||
+      !GoodBearOrdinaryClassificationAllowsCertificateOverrides(
+          aOrdinaryClassification) ||
+      (aStartedInManagedContainer &&
+       IsGoodBearRussianPKISecondaryVerificationEligible(aStandardResult))) {
+    return aOriginalError;
+  }
+  return aApplyUpstreamOverride();
+}
+
+}  // namespace mozilla::psm
+
+#endif  // GoodBearRussianPKIContainerScope_h
diff --git a/security/manager/ssl/GoodBearRussianPKIScopeAuthority.cpp b/security/manager/ssl/GoodBearRussianPKIScopeAuthority.cpp
new file mode 100644
--- /dev/null
+++ b/security/manager/ssl/GoodBearRussianPKIScopeAuthority.cpp
@@ -0,0 +1,204 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "GoodBearRussianPKIScopeAuthority.h"
+#include "GoodBearRussianPKIScopeLease.h"
+
+#include <new>
+
+#include "mozilla/StaticPrefs_security.h"
+#include "nsIScriptSecurityManager.h"
+#include "nsXULAppAPI.h"
+
+namespace mozilla::psm {
+
+GoodBearRussianPKIScopeAuthority::GoodBearRussianPKIScopeAuthority()
+    : mScope("GoodBearRussianPKIScopeAuthority::mScope") {}
+
+bool GoodBearRussianPKIScopeAuthority::EnsureLeaseWriter(
+    ScopeSnapshot& aScope) {
+  if (aScope.mLeaseWriter) {
+    return true;
+  }
+  auto handle = ipc::shared_memory::CreateFreezable(
+      sizeof(GoodBearRussianPKIScopeLeaseState));
+  if (!handle) {
+    return false;
+  }
+  ipc::FreezableSharedMemoryMapping mapping(std::move(handle));
+  if (!mapping) {
+    return false;
+  }
+  new (mapping.DataAs<GoodBearRussianPKIScopeLeaseState>())
+      GoodBearRussianPKIScopeLeaseState();
+  auto [reader, writer] = std::move(mapping).FreezeWithMutableMapping();
+  if (!reader || !writer) {
+    return false;
+  }
+  aScope.mLeaseReaderHandle = std::move(reader);
+  aScope.mLeaseWriter = std::move(writer);
+  return true;
+}
+
+bool GoodBearRussianPKIScopeAuthority::SetManagedContainer(
+    uint32_t aUserContextId) {
+  if (!XRE_IsParentProcess()) {
+    return false;
+  }
+
+  auto scope = mScope.Lock();
+  if (!EnsureLeaseWriter(*scope)) {
+    scope->mDedicatedUserContextId.reset();
+    return false;
+  }
+
+  auto* state = scope->mLeaseWriter.DataAs<GoodBearRussianPKIScopeLeaseState>();
+  if (!StaticPrefs::security_goodbear_russian_pki_enabled() ||
+      aUserContextId == nsIScriptSecurityManager::DEFAULT_USER_CONTEXT_ID) {
+    state->Publish(0);
+    scope->mDedicatedUserContextId.reset();
+    return false;
+  }
+  if (!state->Publish(aUserContextId)) {
+    scope->mDedicatedUserContextId.reset();
+    return false;
+  }
+
+  scope->mDedicatedUserContextId = Some(aUserContextId);
+  return true;
+}
+
+void GoodBearRussianPKIScopeAuthority::ClearManagedContainer() {
+  if (!XRE_IsParentProcess()) {
+    return;
+  }
+
+  auto scope = mScope.Lock();
+  if (scope->mLeaseWriter) {
+    scope->mLeaseWriter.DataAs<GoodBearRussianPKIScopeLeaseState>()->Publish(0);
+  }
+  scope->mDedicatedUserContextId.reset();
+}
+
+void GoodBearRussianPKIScopeAuthority::InvalidateTrust() {
+  if (!XRE_IsParentProcess()) {
+    return;
+  }
+  auto scope = mScope.Lock();
+  if (scope->mLeaseWriter) {
+    scope->mLeaseWriter.DataAs<GoodBearRussianPKIScopeLeaseState>()->Rotate();
+  }
+}
+
+ipc::ReadOnlySharedMemoryHandle
+GoodBearRussianPKIScopeAuthority::CreateLeaseReader() {
+  if (!XRE_IsParentProcess()) {
+    return nullptr;
+  }
+  auto scope = mScope.Lock();
+  if (!EnsureLeaseWriter(*scope)) {
+    return nullptr;
+  }
+  return scope->mLeaseReaderHandle.Clone();
+}
+
+bool GoodBearRussianPKIScopeAuthority::InstallLeaseReader(
+    const ipc::ReadOnlySharedMemoryHandle& aHandle) {
+  if (!XRE_IsSocketProcess() ||
+      aHandle.Size() != sizeof(GoodBearRussianPKIScopeLeaseState)) {
+    return false;
+  }
+  auto scope = mScope.Lock();
+  // The Init IPC installs one reader before the process may use alternate
+  // trust. Replacing it could reinterpret a still-live socket's old lease.
+  if (scope->mLeaseReader) {
+    return false;
+  }
+  scope->mLeaseReader = aHandle.Map();
+  return bool(scope->mLeaseReader);
+}
+
+uint64_t GoodBearRussianPKIScopeAuthority::CaptureLease(
+    const OriginAttributes& aOriginAttributes) const {
+  if (!XRE_IsParentProcess() ||
+      !StaticPrefs::security_goodbear_russian_pki_enabled()) {
+    return 0;
+  }
+  auto scope = mScope.Lock();
+  if (!scope->mLeaseWriter) {
+    return 0;
+  }
+  return scope->mLeaseWriter.DataAs<GoodBearRussianPKIScopeLeaseState>()
+      ->Capture(aOriginAttributes.mUserContextId,
+                aOriginAttributes.mPrivateBrowsingId != 0);
+}
+
+bool GoodBearRussianPKIScopeAuthority::ValidateLease(
+    uint64_t aLease, const OriginAttributes& aOriginAttributes) const {
+  if (aLease == 0 || (!XRE_IsParentProcess() && !XRE_IsSocketProcess()) ||
+      (XRE_IsParentProcess() &&
+       !StaticPrefs::security_goodbear_russian_pki_enabled())) {
+    return false;
+  }
+  auto scope = mScope.Lock();
+  const auto* state =
+      XRE_IsParentProcess()
+          ? scope->mLeaseWriter.DataAs<GoodBearRussianPKIScopeLeaseState>()
+          : scope->mLeaseReader.DataAs<GoodBearRussianPKIScopeLeaseState>();
+  return state && state->Matches(aLease, aOriginAttributes.mUserContextId,
+                                 aOriginAttributes.mPrivateBrowsingId != 0);
+}
+
+void GoodBearRussianPKIScopeAuthority::SetAssignedOriginKeys(
+    const nsACString& aOriginKeys) {
+  if (!XRE_IsParentProcess()) {
+    return;
+  }
+
+  nsTArray<nsCString> assignedOriginKeys;
+  ParseString(aOriginKeys, '\n', assignedOriginKeys);
+  assignedOriginKeys.RemoveElementsBy(
+      [](const nsCString& aOriginKey) { return aOriginKey.IsEmpty(); });
+
+  auto scope = mScope.Lock();
+  scope->mAssignedOriginKeys = std::move(assignedOriginKeys);
+}
+
+bool GoodBearRussianPKIScopeAuthority::ShouldBlockOrdinaryRequest(
+    const nsACString& aOriginKey,
+    const OriginAttributes& aOriginAttributes) const {
+  if (!XRE_IsParentProcess() || aOriginAttributes.mPrivateBrowsingId != 0 ||
+      !StaticPrefs::security_goodbear_russian_pki_enabled()) {
+    return false;
+  }
+
+  auto scope = mScope.Lock();
+  if (scope->mDedicatedUserContextId.isSome() &&
+      aOriginAttributes.mUserContextId ==
+          scope->mDedicatedUserContextId.ref()) {
+    return false;
+  }
+  return scope->mAssignedOriginKeys.Contains(nsCString(aOriginKey));
+}
+bool GoodBearRussianPKIScopeAuthority::Allows(
+    const OriginAttributes& aOriginAttributes) const {
+  return CaptureLease(aOriginAttributes) != 0;
+}
+
+Maybe<uint32_t> GoodBearRussianPKIScopeAuthority::DedicatedUserContextId()
+    const {
+  if (!XRE_IsParentProcess()) {
+    return Nothing();
+  }
+
+  auto scope = mScope.Lock();
+  return scope->mDedicatedUserContextId;
+}
+
+GoodBearRussianPKIScopeAuthority& GetGoodBearRussianPKIScopeAuthority() {
+  static GoodBearRussianPKIScopeAuthority scopeAuthority;
+  return scopeAuthority;
+}
+
+}  // namespace mozilla::psm
diff --git a/security/manager/ssl/GoodBearRussianPKIScopeAuthority.h b/security/manager/ssl/GoodBearRussianPKIScopeAuthority.h
new file mode 100644
--- /dev/null
+++ b/security/manager/ssl/GoodBearRussianPKIScopeAuthority.h
@@ -0,0 +1,76 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef GoodBearRussianPKIScopeAuthority_h
+#define GoodBearRussianPKIScopeAuthority_h
+
+#include <stdint.h>
+
+#include "mozilla/DataMutex.h"
+#include "mozilla/Maybe.h"
+#include "mozilla/OriginAttributes.h"
+#include "nsString.h"
+#include "nsTArray.h"
+#include "mozilla/ipc/SharedMemoryMapping.h"
+
+namespace mozilla::psm {
+
+// Parent-process authority for the one managed Russian PKI container. The
+// identity is deliberately runtime-only: persisting a userContextId in a
+// preference would let a stale ID authorize a connection before the managed
+// contextual identity has been validated during startup.
+class GoodBearRussianPKIScopeAuthority final {
+ public:
+  GoodBearRussianPKIScopeAuthority();
+
+  // A caller must first validate that this ID belongs to the unique native
+  // contextual identity with the Good Bear managed purpose. An invalid update
+  // clears any previous ID instead of preserving stale authorization.
+  bool SetManagedContainer(uint32_t aUserContextId);
+  void ClearManagedContainer();
+  void InvalidateTrust();
+
+  // This reads the live static preference for every check. Therefore
+  // disablement wins even if a cached runtime ID has not yet been cleared by
+  // the parent-process manager.
+  bool Allows(const OriginAttributes& aOriginAttributes) const;
+
+  // Leases are runtime capabilities tied to one publication generation. Only
+  // the parent may capture them; both parent and socket process may validate.
+  uint64_t CaptureLease(const OriginAttributes& aOriginAttributes) const;
+  bool ValidateLease(uint64_t aLease,
+                     const OriginAttributes& aOriginAttributes) const;
+  ipc::ReadOnlySharedMemoryHandle CreateLeaseReader();
+  bool InstallLeaseReader(const ipc::ReadOnlySharedMemoryHandle& aHandle);
+
+  // The parent process publishes only canonical host:port assignment keys.
+  // These keys are routing state, not trust anchors: an assigned origin must
+  // be retried in the managed container rather than silently accepted by an
+  // ordinary connection.
+  void SetAssignedOriginKeys(const nsACString& aOriginKeys);
+  bool ShouldBlockOrdinaryRequest(
+      const nsACString& aOriginKey,
+      const OriginAttributes& aOriginAttributes) const;
+
+  Maybe<uint32_t> DedicatedUserContextId() const;
+
+ private:
+  struct ScopeSnapshot final {
+    Maybe<uint32_t> mDedicatedUserContextId;
+    nsTArray<nsCString> mAssignedOriginKeys;
+    ipc::SharedMemoryMapping mLeaseWriter;
+    ipc::ReadOnlySharedMemoryMapping mLeaseReader;
+    ipc::ReadOnlySharedMemoryHandle mLeaseReaderHandle;
+  };
+
+  static bool EnsureLeaseWriter(ScopeSnapshot& aScope);
+
+  mutable DataMutex<ScopeSnapshot> mScope;
+};
+
+GoodBearRussianPKIScopeAuthority& GetGoodBearRussianPKIScopeAuthority();
+
+}  // namespace mozilla::psm
+
+#endif  // GoodBearRussianPKIScopeAuthority_h
diff --git a/security/manager/ssl/GoodBearRussianPKIScopeLease.h b/security/manager/ssl/GoodBearRussianPKIScopeLease.h
new file mode 100644
--- /dev/null
+++ b/security/manager/ssl/GoodBearRussianPKIScopeLease.h
@@ -0,0 +1,75 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef GoodBearRussianPKIScopeLease_h
+#define GoodBearRussianPKIScopeLease_h
+
+#include <atomic>
+#include <stdint.h>
+
+namespace mozilla::psm {
+
+// The parent is the sole writer. Socket processes map this object read-only.
+// A single atomic word keeps the generation and contextual identity consistent.
+// No pointer, preference, persisted value or certificate name is an authority.
+class GoodBearRussianPKIScopeLeaseState final {
+ public:
+  static_assert(std::atomic<uint64_t>::is_always_lock_free,
+                "Scope revocation requires a process-shared lock-free load");
+  static constexpr uint64_t kExhausted = UINT64_MAX;
+
+  static constexpr uint64_t NextWord(uint64_t aPrevious,
+                                     uint32_t aUserContextId) {
+    const uint64_t generation = aPrevious >> 32;
+    if (aPrevious == kExhausted || generation >= UINT32_MAX - 1) {
+      return kExhausted;  // Never wrap and revive an earlier lease.
+    }
+    return ((generation + 1) << 32) | aUserContextId;
+  }
+
+  // The caller serializes all writes. Publishing zero revokes every old lease.
+  // Publication is the revocation linearization point; already completed I/O
+  // cannot be undone. Republish of the same live identity is not a revocation.
+  bool Publish(uint32_t aUserContextId) {
+    const uint64_t previous = mWord.load(std::memory_order_relaxed);
+    if (previous != kExhausted && aUserContextId != 0 &&
+        static_cast<uint32_t>(previous) == aUserContextId) {
+      return true;
+    }
+    const uint64_t next = NextWord(previous, aUserContextId);
+    mWord.store(next, std::memory_order_release);
+    return next != kExhausted && aUserContextId != 0;
+  }
+
+  // Trust changes revoke old sockets while retaining the current identity.
+  // One atomic publication prevents a transient old-generation resurrection.
+  void Rotate() {
+    const uint64_t previous = mWord.load(std::memory_order_relaxed);
+    mWord.store(NextWord(previous, static_cast<uint32_t>(previous)),
+                std::memory_order_release);
+  }
+
+  uint64_t Capture(uint32_t aUserContextId, bool aPrivateBrowsing) const {
+    if (aUserContextId == 0 || aPrivateBrowsing) {
+      return 0;
+    }
+    const uint64_t word = mWord.load(std::memory_order_acquire);
+    return word != 0 && word != kExhausted &&
+                   static_cast<uint32_t>(word) == aUserContextId
+               ? word
+               : 0;
+  }
+
+  bool Matches(uint64_t aLease, uint32_t aUserContextId,
+               bool aPrivateBrowsing) const {
+    return aLease != 0 && aLease == Capture(aUserContextId, aPrivateBrowsing);
+  }
+
+ private:
+  std::atomic<uint64_t> mWord{0};
+};
+
+}  // namespace mozilla::psm
+
+#endif  // GoodBearRussianPKIScopeLease_h
diff --git a/security/manager/ssl/GoodBearRussianPKIX509Verifier.h b/security/manager/ssl/GoodBearRussianPKIX509Verifier.h
new file mode 100644
--- /dev/null
+++ b/security/manager/ssl/GoodBearRussianPKIX509Verifier.h
@@ -0,0 +1,152 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef GoodBearRussianPKIX509Verifier_h
+#define GoodBearRussianPKIX509Verifier_h
+
+#include "CertVerifier.h"
+#include "EnterpriseRoots.h"
+#include "mozilla/Maybe.h"
+#include "mozilla/UniquePtr.h"
+#include "mozpkix/Result.h"
+#include "nsTArray.h"
+
+namespace mozilla::psm {
+
+// Owns one local, upstream CertVerifier for an immutable set of exact DER
+// anchors already admitted by the M3 pin, provenance, role, and self-signature
+// gates. It intentionally does not cache TLS verification decisions: every
+// call passes the current hostname, time, flags, OriginAttributes, OCSP/SCT
+// inputs, delegated credential, and peer chain to VerifySSLServerCert. The
+// only reused state is Firefox's own signature/trust/OCSP cache inside this
+// private verifier. The cache must be owned by one policy snapshot and
+// discarded when that snapshot changes; it must never be global or shared as a
+// substitute for the M4-03 before-and-after scope check.
+class GoodBearRussianPKIAlternateVerifierCache final {
+ public:
+  static mozilla::UniquePtr<GoodBearRussianPKIAlternateVerifierCache> Create(
+      const CertVerifier& aVerificationSettings,
+      const nsTArray<nsTArray<uint8_t>>& aVerifiedExactTrustAnchors) {
+    if (aVerifiedExactTrustAnchors.IsEmpty()) {
+      return nullptr;
+    }
+
+    nsTArray<EnterpriseCert> exactTrustAnchors;
+    nsTArray<nsTArray<uint8_t>> verifiedExactTrustAnchors;
+    for (const auto& anchorDER : aVerifiedExactTrustAnchors) {
+      if (anchorDER.IsEmpty()) {
+        return nullptr;
+      }
+      exactTrustAnchors.EmplaceBack(anchorDER.Elements(), anchorDER.Length(),
+                                    true);
+      nsTArray<uint8_t> anchorCopy;
+      anchorCopy.AppendElements(anchorDER);
+      verifiedExactTrustAnchors.AppendElement(std::move(anchorCopy));
+    }
+
+    return mozilla::UniquePtr<GoodBearRussianPKIAlternateVerifierCache>(
+        new GoodBearRussianPKIAlternateVerifierCache(
+            aVerificationSettings, std::move(exactTrustAnchors),
+            std::move(verifiedExactTrustAnchors)));
+  }
+
+  mozilla::pkix::Result VerifySSLServerCert(
+      const nsTArray<uint8_t>& aPeerCert, mozilla::pkix::Time aTime,
+      void* aPinArg, const nsACString& aHostname,
+      /*out*/ nsTArray<nsTArray<uint8_t>>& aBuiltChain,
+      CertVerifier::Flags aFlags = 0,
+      const Maybe<nsTArray<nsTArray<uint8_t>>>& aExtraCertificates = Nothing(),
+      const Maybe<nsTArray<uint8_t>>& aStapledOCSPResponse = Nothing(),
+      const Maybe<nsTArray<uint8_t>>& aSctsFromTLS = Nothing(),
+      const Maybe<DelegatedCredentialInfo>& aDCInfo = Nothing(),
+      const OriginAttributes& aOriginAttributes = OriginAttributes(),
+      EVStatus* aEVStatus = nullptr,
+      CertVerifier::OCSPStaplingStatus* aOCSPStaplingStatus = nullptr,
+      KeySizeStatus* aKeySizeStatus = nullptr,
+      PinningTelemetryInfo* aPinningTelemetryInfo = nullptr,
+      CertificateTransparencyInfo* aCTInfo = nullptr,
+      bool* aIsBuiltChainRootBuiltInRoot = nullptr,
+      bool* aMadeOCSPRequests = nullptr,
+      IssuerSources* aIssuerSources = nullptr) {
+    mozilla::pkix::Result result = mAlternateVerifier.VerifySSLServerCert(
+        aPeerCert, aTime, aPinArg, aHostname, aBuiltChain, aFlags,
+        aExtraCertificates, aStapledOCSPResponse, aSctsFromTLS, aDCInfo,
+        aOriginAttributes, aEVStatus, aOCSPStaplingStatus, aKeySizeStatus,
+        aPinningTelemetryInfo, aCTInfo, aIsBuiltChainRootBuiltInRoot,
+        aMadeOCSPRequests, aIssuerSources);
+    if (result != mozilla::pkix::Success) {
+      return result;
+    }
+    if (aBuiltChain.IsEmpty()) {
+      return mozilla::pkix::Result::FATAL_ERROR_LIBRARY_FAILURE;
+    }
+    for (const auto& anchorDER : mVerifiedExactTrustAnchors) {
+      if (aBuiltChain.LastElement() == anchorDER) {
+        return mozilla::pkix::Success;
+      }
+    }
+
+    aBuiltChain.Clear();
+    return mozilla::pkix::Result::ERROR_UNKNOWN_ISSUER;
+  }
+
+ private:
+  GoodBearRussianPKIAlternateVerifierCache(
+      const CertVerifier& aVerificationSettings,
+      nsTArray<EnterpriseCert>&& aExactTrustAnchors,
+      nsTArray<nsTArray<uint8_t>>&& aVerifiedExactTrustAnchors)
+      : mAlternateVerifier(
+            aVerificationSettings.mOCSPDownloadConfig,
+            aVerificationSettings.mOCSPStrict ? CertVerifier::ocspStrict
+                                              : CertVerifier::ocspRelaxed,
+            aVerificationSettings.mOCSPTimeoutSoft,
+            aVerificationSettings.mOCSPTimeoutHard,
+            aVerificationSettings.mCertShortLifetimeInDays,
+            CertVerifier::CertificateTransparencyConfig(
+                aVerificationSettings.mCTConfig.mMode,
+                nsCString(aVerificationSettings.mCTConfig.mSkipForHosts),
+                aVerificationSettings.mCTConfig.mSkipForSPKIHashes.Clone()),
+            aVerificationSettings.mCRLiteMode, aExactTrustAnchors),
+        mVerifiedExactTrustAnchors(std::move(aVerifiedExactTrustAnchors)) {}
+
+  CertVerifier mAlternateVerifier;
+  const nsTArray<nsTArray<uint8_t>> mVerifiedExactTrustAnchors;
+};
+
+inline mozilla::pkix::Result VerifyGoodBearRussianPKISSLServerCert(
+    const CertVerifier& aVerificationSettings,
+    const nsTArray<uint8_t>& aPeerCert, mozilla::pkix::Time aTime,
+    void* aPinArg, const nsACString& aHostname,
+    /*out*/ nsTArray<nsTArray<uint8_t>>& aBuiltChain,
+    const nsTArray<nsTArray<uint8_t>>& aVerifiedExactTrustAnchors,
+    CertVerifier::Flags aFlags = 0,
+    const Maybe<nsTArray<nsTArray<uint8_t>>>& aExtraCertificates = Nothing(),
+    const Maybe<nsTArray<uint8_t>>& aStapledOCSPResponse = Nothing(),
+    const Maybe<nsTArray<uint8_t>>& aSctsFromTLS = Nothing(),
+    const Maybe<DelegatedCredentialInfo>& aDCInfo = Nothing(),
+    const OriginAttributes& aOriginAttributes = OriginAttributes(),
+    EVStatus* aEVStatus = nullptr,
+    CertVerifier::OCSPStaplingStatus* aOCSPStaplingStatus = nullptr,
+    KeySizeStatus* aKeySizeStatus = nullptr,
+    PinningTelemetryInfo* aPinningTelemetryInfo = nullptr,
+    CertificateTransparencyInfo* aCTInfo = nullptr,
+    bool* aIsBuiltChainRootBuiltInRoot = nullptr,
+    bool* aMadeOCSPRequests = nullptr,
+    IssuerSources* aIssuerSources = nullptr) {
+  auto verifier = GoodBearRussianPKIAlternateVerifierCache::Create(
+      aVerificationSettings, aVerifiedExactTrustAnchors);
+  if (!verifier) {
+    return mozilla::pkix::Result::FATAL_ERROR_INVALID_ARGS;
+  }
+  return verifier->VerifySSLServerCert(
+      aPeerCert, aTime, aPinArg, aHostname, aBuiltChain, aFlags,
+      aExtraCertificates, aStapledOCSPResponse, aSctsFromTLS, aDCInfo,
+      aOriginAttributes, aEVStatus, aOCSPStaplingStatus, aKeySizeStatus,
+      aPinningTelemetryInfo, aCTInfo, aIsBuiltChainRootBuiltInRoot,
+      aMadeOCSPRequests, aIssuerSources);
+}
+
+}  // namespace mozilla::psm
