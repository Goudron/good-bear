+
+"use strict";
+
+// Packet/server evidence for Good Bear's global 0-RTT prohibition. The TLS
+// server accepts early data and classifies each received HTTP request as
+// `early` or post-handshake `std`. The second request is made after a session
+// ticket is warmed and deliberately carries ordinary-data markers. Even after
+// a user preference requests early data, no marked request may arrive early.
+
+const { HttpServer } = ChromeUtils.importESModule(
+  "resource://testing-common/httpd.sys.mjs"
+);
+const { setTimeout } = ChromeUtils.importESModule(
+  "resource://gre/modules/Timer.sys.mjs"
+);
+const { AppConstants } = ChromeUtils.importESModule(
+  "resource://gre/modules/AppConstants.sys.mjs"
+);
+
+const kHost = "0rtt-accept-h1.example.com";
+// nsITransportSecurityInfo::GoodBearTrustDomain::Standard.
+const kStandardTrustDomain = 1;
+let callbackServer;
+let earlyCount = 0;
+let standardCount = 0;
+let serverStarted = false;
+
+function callbackHandler(metadata) {
+  if (metadata.path === "/callback/request/early") {
+    earlyCount++;
+  } else if (metadata.path === "/callback/request/std") {
+    standardCount++;
+  }
+}
+
+function fetchResult(url) {
+  return new Promise((resolve, reject) => {
+    const channel = NetUtil.newChannel({
+      uri: url,
+      loadUsingSystemPrincipal: true,
+    }).QueryInterface(Ci.nsIHttpChannel);
+    channel.loadFlags =
+      Ci.nsIChannel.LOAD_INITIAL_DOCUMENT_URI | Ci.nsIRequest.LOAD_BYPASS_CACHE;
+    channel.setRequestHeader("Cookie", "ordinary=must-not-leak", false);
+    channel.setRequestHeader("X-Good-Bear-Ordinary", "must-not-leak", false);
+    channel.asyncOpen(
+      new ChannelListener(
+        request => {
+          try {
+            const response = request.QueryInterface(Ci.nsIHttpChannel);
+            resolve({
+              status: response.responseStatus,
+              resumed: response.securityInfo.resumed,
+              trustDomain: response.securityInfo.goodBearTrustDomain,
+            });
+          } catch (error) {
+            reject(error);
+          }
+        },
+        null,
+        CL_ALLOW_UNKNOWN_CL
+      )
+    );
+  });
+}
+
+add_setup({ skip_if: () => AppConstants.MOZ_SYSTEM_NSS }, async () => {
+  callbackServer = new HttpServer();
+  callbackServer.registerPrefixHandler("/callback/", callbackHandler);
+  callbackServer.start(-1);
+  Services.env.set(
+    "MOZ_ZERORTT_ACCEPT_CALLBACK_PORT",
+    callbackServer.identity.primaryPort
+  );
+  Services.env.set("MOZ_TLS_SERVER_0RTT", "1");
+  serverStarted = await asyncStartTLSTestServer(
+    "ZeroRttAcceptServer",
+    "../../../security/manager/ssl/tests/unit/test_faulty_server"
+  );
+  if (!serverStarted) {
+    return;
+  }
+  await Cc["@mozilla.org/network/ssl-tokens-cache;1"]
+    .getService(Ci.nsISSLTokensCache)
+    .asyncClearSSLExternalAndInternalSessionCache();
+  Services.prefs.setCharPref("network.dns.localDomains", kHost);
+  Services.prefs.setBoolPref("network.ssl_tokens_cache_enabled", true);
+  Services.prefs.setBoolPref("network.http.http3.enable", false);
+  Services.prefs.setBoolPref("network.http.happy_eyeballs_enabled", true);
+  Services.prefs.setIntPref("network.http.speculative-parallel-limit", 0);
+  Services.prefs.setBoolPref("network.dns.disableIPv6", true);
+  // The packet-observing test server listens only on loopback.  Do not let
+  // a developer's system proxy consume the request before it reaches it.
+  Services.prefs.setIntPref("network.proxy.type", 0);
+  // Good Bear's NSS preference observer must ignore this opt-in.
+  Services.prefs.setBoolPref("security.tls.enable_0rtt_data", true);
+  registerCleanupFunction(async () => {
+    for (const pref of [
+      "network.dns.localDomains",
+      "network.ssl_tokens_cache_enabled",
+      "network.http.http3.enable",
+      "network.http.happy_eyeballs_enabled",
+      "network.http.speculative-parallel-limit",
+      "network.dns.disableIPv6",
+      "network.proxy.type",
+      "security.tls.enable_0rtt_data",
+    ]) {
+      Services.prefs.clearUserPref(pref);
+    }
+    await callbackServer.stop();
+  });
+});
+
+add_task(
+  { skip_if: () => AppConstants.MOZ_SYSTEM_NSS || !serverStarted },
+  async function test_goodbear_never_sends_ordinary_request_data_as_0rtt() {
+    const url = `https://${kHost}:8443/`;
+    const first = await fetchResult(url);
+    Assert.equal(first.status, 200, "full handshake succeeds");
+    Assert.equal(
+      first.trustDomain,
+      kStandardTrustDomain,
+      "the fresh verified connection has an explicit Standard result"
+    );
+    Assert.equal(
+      first.resumed,
+      false,
+      "the cleared cache forces a fresh handshake"
+    );
+    Assert.equal(earlyCount, 0, "first request is never early data");
+    // The upstream ZeroRttAcceptServer fixture has a time-based anti-replay
+    // window and NSS publishes no ticket-ready event to this test. Match the
+    // fixture's warm-up window, then require actual PSK resumption below:
+    // waiting alone is never evidence that a usable ticket was received.
+    // eslint-disable-next-line mozilla/no-arbitrary-setTimeout
+    await new Promise(resolve => setTimeout(resolve, 1500));
+    Services.obs.notifyObservers(null, "net:cancel-all-connections");
+    // Connection cancellation is asynchronous, with no completion notification
+    // in this fixture. A reused connection fails the resumed assertion below.
+    // eslint-disable-next-line mozilla/no-arbitrary-setTimeout
+    await new Promise(resolve => setTimeout(resolve, 200));
+    const second = await fetchResult(url);
+    Assert.equal(second.status, 200, "resumed request succeeds");
+    Assert.equal(
+      second.trustDomain,
+      kStandardTrustDomain,
+      "the resumed connection preserves its explicit Standard result"
+    );
+    Assert.equal(
+      second.resumed,
+      true,
+      "a real resumed TLS session must exercise the early-data prohibition"
+    );
+    Assert.equal(
+      earlyCount,
+      0,
+      "TLS server observed no ordinary cookie or header in 0-RTT despite enabled preference"
+    );
+    Assert.equal(
+      standardCount,
+      2,
+      "both marked requests arrived after TLS validation"
+    );
+  }
+);
