+TEST(GoodBearRussianPKIScopeLeaseTest, UninitializedAndWrongScopesFailClosed)
+{
+  GoodBearRussianPKIScopeLeaseState state;
+  ASSERT_EQ(0U, state.Capture(17, false));
+  ASSERT_FALSE(state.Matches(0, 17, false));
+  ASSERT_TRUE(state.Publish(17));
+  const uint64_t lease = state.Capture(17, false);
+  ASSERT_NE(0U, lease);
+  ASSERT_TRUE(state.Matches(lease, 17, false));
+  ASSERT_FALSE(state.Matches(lease, 0, false));
+  ASSERT_FALSE(state.Matches(lease, 18, false));
+  ASSERT_FALSE(state.Matches(lease, 17, true));
+  ASSERT_FALSE(state.Matches(lease + (uint64_t{1} << 32), 17, false));
+}
+
+TEST(GoodBearRussianPKIScopeLeaseTest, RecreatedIdentityCannotReviveOldLease)
+{
+  GoodBearRussianPKIScopeLeaseState state;
+  ASSERT_TRUE(state.Publish(17));
+  const uint64_t oldLease = state.Capture(17, false);
+  ASSERT_FALSE(state.Publish(0));
+  ASSERT_FALSE(state.Matches(oldLease, 17, false));
+  ASSERT_TRUE(state.Publish(17));
+  ASSERT_FALSE(state.Matches(oldLease, 17, false));
+  const uint64_t newLease = state.Capture(17, false);
+  ASSERT_NE(oldLease, newLease);
+  ASSERT_TRUE(state.Matches(newLease, 17, false));
+  ASSERT_TRUE(state.Publish(23));
+  ASSERT_FALSE(state.Matches(newLease, 17, false));
+  ASSERT_FALSE(state.Matches(newLease, 23, false));
+}
