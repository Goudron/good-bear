+TEST(TestTokensCache, StandardTrustDomainSurvivesPersistenceAndRebuild)
+{
+  ClearAll();
+  nsCString path = GetTempCachePath("test_goodbear_typed_tls_cache.sqlite");
+  putToken("anon:example.com:443"_ns, 100);
+  mozilla::net::SSLTokensCache::TriggerWriteForTest(path);
+  ClearAll();
+  mozilla::net::SSLTokensCache::LoadForTest(path);
+
+  nsTArray<uint8_t> token;
+  mozilla::net::SessionCacheInfo info;
+  ASSERT_NS_SUCCEEDED(mozilla::net::SSLTokensCache::Get(
+      "anon:example.com:443"_ns, token, info));
+  using TrustDomain = nsITransportSecurityInfo::GoodBearTrustDomain;
+  ASSERT_TRUE(info.mGoodBearTrustDomain);
+  ASSERT_EQ(*info.mGoodBearTrustDomain, TrustDomain::Standard);
+  auto clone = info.Clone();
+  ASSERT_TRUE(clone.mGoodBearTrustDomain);
+  ASSERT_EQ(*clone.mGoodBearTrustDomain, TrustDomain::Standard);
+  RefPtr<CommonSocketControl> socket(
+      new CommonSocketControl("example.com"_ns, 443, 0));
+  socket->SetSessionCacheInfo(std::move(clone));
+  socket->RebuildCertificateInfoFromSSLTokenCache();
+  ASSERT_FALSE(socket->IsCanceled());
+  nsCOMPtr<nsITransportSecurityInfo> restored;
+  ASSERT_NS_SUCCEEDED(socket->GetSecurityInfo(getter_AddRefs(restored)));
+  TrustDomain domain = TrustDomain::Invalid;
+  ASSERT_NS_SUCCEEDED(restored->GetGoodBearTrustDomain(&domain));
+  ASSERT_EQ(domain, TrustDomain::Standard);
+  bool requiresRussianPKI = true;
+  ASSERT_NS_SUCCEEDED(
+      restored->GetGoodBearRussianPKIRequired(&requiresRussianPKI));
+  ASSERT_FALSE(requiresRussianPKI);
+}
