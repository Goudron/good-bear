+    const mozilla::net::SessionCacheInfo& aInfo, uint32_t /*aUserContextId*/) {
+  using TrustDomain = nsITransportSecurityInfo::GoodBearTrustDomain;
+  if (!aInfo.mGoodBearTrustDomain ||
+      (*aInfo.mGoodBearTrustDomain != TrustDomain::Standard &&
+       *aInfo.mGoodBearTrustDomain != TrustDomain::Invalid)) {
+    return true;
