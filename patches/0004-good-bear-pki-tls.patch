+TEST(psm_GoodBearRussianPKIVerifier,
+     SameValidRussianChainIsAcceptedOnlyInDedicatedContainer)
+{
+  constexpr uint32_t kDedicatedUserContextId = 17;
+  GoodBearRussianPKIContainerScope scope{true, Some(kDedicatedUserContextId)};
+  int alternateCalls = 0;
+  auto authorize = [&](const OriginAttributes& aOriginAttributes) {
+    return scope.Allows(aOriginAttributes);
+  };
+  auto exactRussianChainSucceeds = [&]() {
+    alternateCalls++;
+    return Success;
+  };
+
+  auto dedicated = ClassifyGoodBearContainerServerCertificate(
+      PKIXResult::ERROR_UNKNOWN_ISSUER,
+      ChannelAttributes(kDedicatedUserContextId), authorize,
+      exactRussianChainSucceeds);
+  ASSERT_EQ(GoodBearTrustDomain::RussianPKI, dedicated.mTrustDomain);
+  ASSERT_EQ(Success, dedicated.mResult);
+  ASSERT_TRUE(dedicated.ChannelUsable());
+  ASSERT_EQ(1, alternateCalls);
+
+  for (uint32_t userContextId : {0U, 4U, 18U}) {
+    auto outside = ClassifyGoodBearContainerServerCertificate(
+        PKIXResult::ERROR_UNKNOWN_ISSUER, ChannelAttributes(userContextId),
+        authorize, exactRussianChainSucceeds);
+    ASSERT_EQ(GoodBearTrustDomain::Invalid, outside.mTrustDomain);
+    ASSERT_EQ(PKIXResult::ERROR_UNKNOWN_ISSUER, outside.mResult);
+    ASSERT_FALSE(outside.ChannelUsable());
+  }
+  ASSERT_EQ(1, alternateCalls);
+}
