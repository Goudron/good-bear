+
+TEST_F(GoodBearRussianPKIScopeAuthorityTest, DefaultRuntimeScopeIsFailClosed) {
+  auto& authority = GetGoodBearRussianPKIScopeAuthority();
+
+  ASSERT_TRUE(StaticPrefs::security_goodbear_russian_pki_enabled());
+  ASSERT_FALSE(authority.DedicatedUserContextId().isSome());
+  ASSERT_FALSE(authority.Allows(AttributesFor(17)));
