+
+#ifndef GoodBearSelectedChainPolicy_h
+#define GoodBearSelectedChainPolicy_h
+
+#include "mozilla/FunctionRef.h"
+#include "mozpkix/Result.h"
+#include "nsITransportSecurityInfo.h"
+
+namespace mozilla::psm {
+
+// This identity describes ONLY the verifier-built chain. On validation
+// failure it may restrict overrides but cannot grant trust.
+enum class GoodBearSelectedAnchor : uint8_t {
+  MissingMetadata,
+  Other,
+  RussianRoot,
+  ApprovedIntermediate,
+};
+
+// Defensive result/IPC consumption. Failed validation can continue only via
+// a separately permitted ordinary exception with known non-Russian metadata.
+inline bool GoodBearSelectedChainResultConsistent(
+    GoodBearSelectedAnchor aAnchor,
+    nsITransportSecurityInfo::GoodBearTrustDomain aDomain,
+    bool aSucceeded, uint64_t aLease, bool aErrorIsZero) {
+  using Domain = nsITransportSecurityInfo::GoodBearTrustDomain;
+  if (!aSucceeded) {
+    return aDomain == Domain::Invalid &&
+           (!aErrorIsZero || aAnchor == GoodBearSelectedAnchor::Other);
+  }
+  return aErrorIsZero &&
+         ((aDomain == Domain::Standard && aAnchor == GoodBearSelectedAnchor::Other &&
+           aLease == 0) ||
+          (aDomain == Domain::RussianPKI && aAnchor == GoodBearSelectedAnchor::RussianRoot &&
+           aLease != 0));
+}
+
+struct GoodBearSelectedChainDecision {
+  mozilla::pkix::Result mValidationResult;
+  nsITransportSecurityInfo::GoodBearTrustDomain mTrustDomain;
+  bool mContainerRequired;
+  bool mAllowCertificateOverride;
+
+  bool ChannelUsable() const {
+    return mTrustDomain != nsITransportSecurityInfo::GoodBearTrustDomain::Invalid;
+  }
+};
+
+// Fixed identifiers only: never receive a host, origin, profile, peer, or URL.
+struct GoodBearVerificationDiagnosticFields {
+  const char* mPrimary;
+  const char* mSelected;
+  const char* mAlternate;
+  const char* mAccess;
+};
+inline GoodBearVerificationDiagnosticFields GoodBearVerificationDiagnostic(
+    bool aPrimaryValid, GoodBearSelectedAnchor aSelected,
+    bool aAlternateAttempted, bool aAlternateValid,
+    const GoodBearSelectedChainDecision& aDecision) {
+  using Domain = nsITransportSecurityInfo::GoodBearTrustDomain;
+  return {aPrimaryValid ? "valid" : "invalid",
+          aSelected == GoodBearSelectedAnchor::RussianRoot ? "russian-root"
+          : aSelected == GoodBearSelectedAnchor::Other     ? "other"
+          : aSelected == GoodBearSelectedAnchor::ApprovedIntermediate
+              ? "intermediate"
+              : "missing",
+          !aAlternateAttempted ? "not-run"
+          : aAlternateValid    ? "valid"
+                               : "invalid",
+          aDecision.mTrustDomain == Domain::Standard     ? "standard"
+          : aDecision.mTrustDomain == Domain::RussianPKI ? "russian"
+          : aDecision.mContainerRequired                 ? "required"
+                                                         : "denied"};
+}
+
+inline GoodBearSelectedChainDecision EvaluateGoodBearSelectedChain(
+    mozilla::pkix::Result aPrimaryResult, GoodBearSelectedAnchor aAnchor,
+    bool aEnabled, bool aPrivate, bool aStartedManaged,
+    mozilla::FunctionRef<bool()> aLiveLease,
+    mozilla::FunctionRef<mozilla::pkix::Result()> aVerifyAlternate) {
+  using Domain = nsITransportSecurityInfo::GoodBearTrustDomain;
+  using mozilla::pkix::Result;
+  using mozilla::pkix::Success;
+  GoodBearSelectedChainDecision denied{
+      aPrimaryResult, Domain::Invalid, false, false};
+  if (aPrimaryResult == Success) {
+    if (aAnchor == GoodBearSelectedAnchor::Other) {
+      return {Success, Domain::Standard, false, false};
+    }
+    if (aAnchor != GoodBearSelectedAnchor::RussianRoot || !aEnabled || aPrivate) {
+      return denied;
+    }
+    if (aStartedManaged) {
+      return aLiveLease()
+                 ? GoodBearSelectedChainDecision{Success, Domain::RussianPKI,
+                                                 false, false}
+                 : denied;
+    }
+    denied.mContainerRequired = true;
+    return denied;
+  }
+
+  // Even failed hostname validation can carry a built chain. Its identity
+  // only restricts exceptions; missing metadata never authorizes an override.
+  denied.mAllowCertificateOverride = aAnchor == GoodBearSelectedAnchor::Other;
+  if (aPrimaryResult != Result::ERROR_UNKNOWN_ISSUER || !aEnabled || aPrivate) {
+    return denied;
+  }
+  if (aStartedManaged) {
+    denied.mAllowCertificateOverride = false;
+    if (!aLiveLease()) {
+      return denied;
+    }
+  }
+  if (aVerifyAlternate() != Success) {
+    return denied;
+  }
+  denied.mAllowCertificateOverride = false;
+  if (!aStartedManaged) {
+    denied.mContainerRequired = true;
+    return denied;
+  }
+  return aLiveLease()
+             ? GoodBearSelectedChainDecision{Success, Domain::RussianPKI,
+                                             false, false}
+             : denied;
+}
+
+}  // namespace mozilla::psm
+#endif  // GoodBearSelectedChainPolicy_h
