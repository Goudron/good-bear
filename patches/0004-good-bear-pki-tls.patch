+  nsTArray<nsTArray<uint8_t>> roots;
+  roots.AppendElement(std::move(root));
+  auto cache =
+      GoodBearRussianPKIAlternateVerifierCache::Create(*mVerifier, roots);
+  ASSERT_TRUE(cache);
+
+  nsTArray<nsTArray<uint8_t>> intermediates;
+  intermediates.AppendElement(std::move(intermediate));
+  auto MakeExtraCertificates = [&]() {
+    nsTArray<nsTArray<uint8_t>> extraCertificates;
+    nsTArray<uint8_t> intermediateCopy;
+    intermediateCopy.AppendElements(intermediates[0]);
+    extraCertificates.AppendElement(std::move(intermediateCopy));
+    return Some(std::move(extraCertificates));
+  };
+  nsTArray<nsTArray<uint8_t>> builtChain;
+  ASSERT_EQ(Success,
+            cache->VerifySSLServerCert(
+                leaf, TimeFromEpochInSeconds(1787832000), nullptr,
+                "test-russian.example"_ns, builtChain,
+                CertVerifier::FLAG_LOCAL_ONLY, MakeExtraCertificates()));
+  ASSERT_EQ(3U, builtChain.Length());
+
+  builtChain.Clear();
+  ASSERT_EQ(PKIXResult::ERROR_BAD_CERT_DOMAIN,
+            cache->VerifySSLServerCert(
+                leaf, TimeFromEpochInSeconds(1787832000), nullptr,
+                "wrong-host.example"_ns, builtChain,
+                CertVerifier::FLAG_LOCAL_ONLY, MakeExtraCertificates()));
+  ASSERT_FALSE(builtChain.IsEmpty());
