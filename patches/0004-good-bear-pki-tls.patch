+  ASSERT_EQ(NS_OK, Preferences::SetBool(kEnabledPref, true));
+  ASSERT_TRUE(StaticPrefs::security_goodbear_russian_pki_enabled());
+  ASSERT_FALSE(authority.Allows(AttributesFor(17)));
+  ASSERT_FALSE(authority.ValidateLease(oldLease, AttributesFor(17)));
+  ASSERT_TRUE(authority.SetManagedContainer(17));
+  ASSERT_FALSE(authority.ValidateLease(oldLease, AttributesFor(17)));
+  ASSERT_TRUE(authority.ValidateLease(authority.CaptureLease(AttributesFor(17)),
