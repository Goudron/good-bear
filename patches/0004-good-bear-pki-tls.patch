new file mode 100644
--- /dev/null
+++ b/security/manager/ssl/tests/gtest/GoodBearTrustDomainTest.cpp
@@ -0,0 +1,112 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include <type_traits>
+
+#include "TransportSecurityInfo.h"
+#include "gtest/gtest.h"
+#include "mozilla/Maybe.h"
+#include "nsCOMPtr.h"
+#include "nsITransportSecurityInfo.h"
+#include "nsString.h"
+
+using namespace mozilla;
+using namespace mozilla::psm;
+
+using GoodBearTrustDomain = nsITransportSecurityInfo::GoodBearTrustDomain;
+
+static_assert(
+    std::is_same_v<std::underlying_type_t<GoodBearTrustDomain>, uint8_t>);
+static_assert(static_cast<uint8_t>(GoodBearTrustDomain::Invalid) == 0);
+static_assert(static_cast<uint8_t>(GoodBearTrustDomain::Standard) == 1);
+static_assert(static_cast<uint8_t>(GoodBearTrustDomain::RussianPKI) == 2);
+
+static RefPtr<TransportSecurityInfo> MakeSecurityInfo(
+    GoodBearTrustDomain aTrustDomain, bool aGoodBearRussianPKIRequired = false,
+    bool aPolicyDenied = false, int32_t aError = 0) {
+  nsCOMPtr<nsIX509Cert> serverCert;
+  return new TransportSecurityInfo(
+      0, aError, {}, serverCert, {}, Nothing(), Nothing(), Nothing(), Nothing(),
+      0, Nothing(), Nothing(), Nothing(), false, false, Nothing(), false,
+      EmptyCString(), false, false, EmptyCString(), aTrustDomain,
+      aGoodBearRussianPKIRequired, aPolicyDenied);
+}
+
+TEST(psm_GoodBearTrustDomain, TypedValuesSurviveImmutableSecurityInfo)
+{
+  for (GoodBearTrustDomain trustDomain : {
+           GoodBearTrustDomain::Invalid,
+           GoodBearTrustDomain::Standard,
+           GoodBearTrustDomain::RussianPKI,
+       }) {
+    RefPtr<TransportSecurityInfo> securityInfo = MakeSecurityInfo(trustDomain);
+    GoodBearTrustDomain actual = GoodBearTrustDomain::Invalid;
+    ASSERT_EQ(NS_OK, securityInfo->GetGoodBearTrustDomain(&actual));
+    ASSERT_EQ(trustDomain, actual);
+  }
+}
+
+TEST(psm_GoodBearTrustDomain, TypedValuesSurvivePersistentSerialization)
+{
+  for (GoodBearTrustDomain trustDomain : {
+           GoodBearTrustDomain::Invalid,
+           GoodBearTrustDomain::Standard,
+           GoodBearTrustDomain::RussianPKI,
+       }) {
+    nsCString serialized;
+    ASSERT_EQ(NS_OK, MakeSecurityInfo(trustDomain)->ToString(serialized));
+
+    nsCOMPtr<nsITransportSecurityInfo> deserialized;
+    ASSERT_EQ(NS_OK, TransportSecurityInfo::Read(serialized,
+                                                 getter_AddRefs(deserialized)));
+    GoodBearTrustDomain actual = GoodBearTrustDomain::Invalid;
+    ASSERT_EQ(NS_OK, deserialized->GetGoodBearTrustDomain(&actual));
+    ASSERT_EQ(trustDomain, actual);
+  }
+}
+
+TEST(psm_GoodBearTrustDomain,
+     RussianPKIRoutingHintSurvivesSerializationWithoutGrantingTrust)
+{
+  RefPtr<TransportSecurityInfo> securityInfo =
+      MakeSecurityInfo(GoodBearTrustDomain::Invalid, true);
+  bool required = false;
+  ASSERT_EQ(NS_OK, securityInfo->GetGoodBearRussianPKIRequired(&required));
+  ASSERT_TRUE(required);
+
+  nsCString serialized;
+  ASSERT_EQ(NS_OK, securityInfo->ToString(serialized));
+  nsCOMPtr<nsITransportSecurityInfo> deserialized;
+  ASSERT_EQ(NS_OK, TransportSecurityInfo::Read(serialized,
+                                               getter_AddRefs(deserialized)));
+  GoodBearTrustDomain trustDomain = GoodBearTrustDomain::Standard;
+  ASSERT_EQ(NS_OK, deserialized->GetGoodBearTrustDomain(&trustDomain));
+  ASSERT_EQ(GoodBearTrustDomain::Invalid, trustDomain);
+  ASSERT_EQ(NS_OK, deserialized->GetGoodBearRussianPKIRequired(&required));
+  ASSERT_TRUE(required);
+}
+
+TEST(psm_GoodBearTrustDomain, PolicyDenialIsPresentationOnlyAndPersists)
+{
+  for (auto domain :
+       {GoodBearTrustDomain::Invalid, GoodBearTrustDomain::Standard,
+        GoodBearTrustDomain::RussianPKI}) {
+    for (int32_t error : {0, -8179}) {
+      auto info = MakeSecurityInfo(domain, false, true, error);
+      nsCString serialized;
+      ASSERT_EQ(NS_OK, info->ToString(serialized));
+      nsCOMPtr<nsITransportSecurityInfo> restored;
+      ASSERT_EQ(NS_OK, TransportSecurityInfo::Read(serialized,
+                                                   getter_AddRefs(restored)));
+      bool denied = false, required = true;
+      ASSERT_EQ(NS_OK, restored->GetGoodBearRussianPKIPolicyDenied(&denied));
+      EXPECT_EQ(denied, domain == GoodBearTrustDomain::Invalid && error != 0);
+      ASSERT_EQ(NS_OK, restored->GetGoodBearRussianPKIRequired(&required));
+      EXPECT_FALSE(required);
+      GoodBearTrustDomain actual;
+      ASSERT_EQ(NS_OK, restored->GetGoodBearTrustDomain(&actual));
+      EXPECT_EQ(actual, domain);
+    }
+  }
+}
