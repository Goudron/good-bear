+class GoodBearRussianPKIX509Test : public ::testing::Test {
+ protected:
+  static void SetUpTestSuite() {
+    ASSERT_EQ(SECSuccess, NSS_NoDB_Init(nullptr));
+  }
+
+  void SetUp() override {
+    nsTArray<EnterpriseCert> thirdPartyCerts;
+    mVerifier = MakeUnique<CertVerifier>(
+        CertVerifier::ocspOff, CertVerifier::ocspRelaxed,
+        TimeDuration::FromSeconds(1), TimeDuration::FromSeconds(1), 10,
+        CertVerifier::CertificateTransparencyConfig(
+            CertVerifier::CertificateTransparencyMode::Disabled, nsCString(),
+            nsTArray<CopyableTArray<uint8_t>>()),
+        CRLiteMode::Disabled, thirdPartyCerts);
+  }
+
+  PKIXResult VerifyRussianPKI(
+      const nsACString& aLeafName, const nsACString& aHostname,
+      std::initializer_list<const char*> aIntermediateNames,
+      Time aTime = TimeFromEpochInSeconds(1787832000)) {
+    nsTArray<uint8_t> leaf = ReadCertificateFixture(aLeafName);
+    nsTArray<uint8_t> root = ReadCertificateFixture("russian-root.pem"_ns);
+    if (leaf.IsEmpty() || root.IsEmpty()) {
+      return PKIXResult::FATAL_ERROR_LIBRARY_FAILURE;
+    }
+
+    nsTArray<nsTArray<uint8_t>> roots;
+    roots.AppendElement(std::move(root));
+    nsTArray<nsTArray<uint8_t>> intermediates;
+    for (const char* name : aIntermediateNames) {
+      nsTArray<uint8_t> intermediate =
+          ReadCertificateFixture(nsDependentCString(name));
+      if (intermediate.IsEmpty()) {
+        return PKIXResult::FATAL_ERROR_LIBRARY_FAILURE;
+      }
+      intermediates.AppendElement(std::move(intermediate));
+    }
+    Maybe<nsTArray<nsTArray<uint8_t>>> extraCertificates =
+        intermediates.IsEmpty()
+            ? Nothing()
+            : Some(nsTArray<nsTArray<uint8_t>>(std::move(intermediates)));
+    nsTArray<nsTArray<uint8_t>> builtChain;
+    return VerifyGoodBearRussianPKISSLServerCert(
+        *mVerifier, leaf, aTime, nullptr, aHostname, builtChain, roots,
+        CertVerifier::FLAG_LOCAL_ONLY, extraCertificates);
+  }
+
+  PKIXResult VerifyStandardRussianPKI() {
+    nsTArray<uint8_t> leaf = ReadCertificateFixture("russian-leaf.pem"_ns);
+    nsTArray<uint8_t> intermediate =
+        ReadCertificateFixture("russian-intermediate.pem"_ns);
+    if (leaf.IsEmpty() || intermediate.IsEmpty()) {
+      return PKIXResult::FATAL_ERROR_LIBRARY_FAILURE;
+    }
+
+    nsTArray<nsTArray<uint8_t>> intermediates;
+    intermediates.AppendElement(std::move(intermediate));
+    nsTArray<nsTArray<uint8_t>> builtChain;
+    return mVerifier->VerifySSLServerCert(
+        leaf, TimeFromEpochInSeconds(1787832000), nullptr,
+        "test-russian.example"_ns, builtChain, CertVerifier::FLAG_LOCAL_ONLY,
+        Some(nsTArray<nsTArray<uint8_t>>(std::move(intermediates))));
+  }
+
+  GoodBearContainerVerificationResult ClassifyRussianPKI(
+      const nsACString& aLeafName, const nsACString& aHostname,
+      std::initializer_list<const char*> aIntermediateNames,
+      PKIXResult& aAlternateResult,
+      Time aTime = TimeFromEpochInSeconds(1787832000)) {
+    GoodBearRussianPKIContainerScope scope{true, Some(17U)};
+    return ClassifyGoodBearContainerServerCertificate(
+        PKIXResult::ERROR_UNKNOWN_ISSUER, ChannelAttributes(17),
+        [&](const OriginAttributes& aOriginAttributes) {
+          return scope.Allows(aOriginAttributes);
+        },
+        [&]() {
+          aAlternateResult =
+              VerifyRussianPKI(aLeafName, aHostname, aIntermediateNames, aTime);
+          return aAlternateResult;
+        });
+  }
+
+  UniquePtr<CertVerifier> mVerifier;
+};
