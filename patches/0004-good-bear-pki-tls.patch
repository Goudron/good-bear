+nsTArray<uint8_t> ReadCertificateFixture(const nsACString& aName) {
+  nsCOMPtr<nsIFile> file;
+  if (NS_FAILED(NS_GetSpecialDirectory(NS_OS_CURRENT_WORKING_DIR,
+                                       getter_AddRefs(file))) ||
+      NS_FAILED(file->AppendNative(aName))) {
+    return {};
+  }
+
+  nsCOMPtr<nsIInputStream> stream;
+  if (NS_FAILED(NS_NewLocalFileInputStream(getter_AddRefs(stream), file))) {
+    return {};
+  }
+  nsCString pem;
+  if (NS_FAILED(NS_ConsumeStream(stream, UINT32_MAX, pem))) {
+    return {};
+  }
+  UniqueCERTCertificate cert(
+      CERT_DecodeCertFromPackage(pem.BeginWriting(), pem.Length()));
+  if (!cert) {
+    return {};
+  }
+  return nsTArray<uint8_t>(cert->derCert.data, cert->derCert.len);
+}
