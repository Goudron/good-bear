+TEST_F(GoodBearRussianPKIScopeAuthorityTest,
+       DisablementRevokesOldLeaseAndReenableRequiresNewPublication) {
+  AutoRestoreEnabledPref restorePref;
+  auto& authority = GetGoodBearRussianPKIScopeAuthority();
+
+  ASSERT_TRUE(authority.SetManagedContainer(17));
+  ASSERT_TRUE(authority.Allows(AttributesFor(17)));
+
+  const uint64_t oldLease = authority.CaptureLease(AttributesFor(17));
+  ASSERT_EQ(NS_OK, Preferences::SetBool(kEnabledPref, false));
+  ASSERT_FALSE(StaticPrefs::security_goodbear_russian_pki_enabled());
+  ASSERT_FALSE(authority.Allows(AttributesFor(17)));
+  ASSERT_FALSE(authority.Allows(AttributesFor(18)));
