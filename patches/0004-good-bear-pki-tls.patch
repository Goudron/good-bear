+TEST_F(GoodBearRussianPKIScopeAuthorityTest,
+       ReadOnlyLeaseMappingObservesParentRevocationAndRecreation) {
+  auto& authority = GetGoodBearRussianPKIScopeAuthority();
+  auto readerHandle = authority.CreateLeaseReader();
+  ASSERT_TRUE(readerHandle);
+  auto reader = readerHandle.Map();
+  ASSERT_TRUE(reader);
+  const auto* state = reader.DataAs<GoodBearRussianPKIScopeLeaseState>();
+  ASSERT_EQ(0U, state->Capture(17, false));
+  ASSERT_TRUE(authority.SetManagedContainer(17));
+  const uint64_t oldLease = authority.CaptureLease(AttributesFor(17));
+  ASSERT_TRUE(state->Matches(oldLease, 17, false));
+  ASSERT_TRUE(authority.ValidateLease(oldLease, AttributesFor(17)));
+  // The original writer remains writable after FreezeWithMutableMapping.
+  authority.ClearManagedContainer();
+  ASSERT_FALSE(state->Matches(oldLease, 17, false));
+  ASSERT_FALSE(authority.ValidateLease(oldLease, AttributesFor(17)));
+  ASSERT_TRUE(authority.SetManagedContainer(17));
+  ASSERT_FALSE(state->Matches(oldLease, 17, false));
+  const uint64_t newLease = authority.CaptureLease(AttributesFor(17));
+  ASSERT_TRUE(state->Matches(newLease, 17, false));
+  ASSERT_FALSE(state->Matches(newLease, 17, true));
+}
