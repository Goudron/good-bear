+namespace {
+
+class GoodBearLeaseSocket final : public CommonSocketControl {
+ public:
+  GoodBearLeaseSocket() : CommonSocketControl("example.test"_ns, 443, 0) {}
+  void SetCertVerificationResult(PRErrorCode aError) override {
+    mCompletionError = aError;
+    ++mCompletionCount;
+    if (aError) {
+      SetCanceled(aError);
+    }
+  }
+  uint32_t mCompletionCount = 0;
+  PRErrorCode mCompletionError = 0;
+
+ private:
+  ~GoodBearLeaseSocket() override = default;
+};
+
+}  // namespace
+
+TEST_F(GoodBearRussianPKIScopeAuthorityTest,
+       QueuedRussianResultCannotCompleteAfterScopeRevocation) {
+  auto& authority = GetGoodBearRussianPKIScopeAuthority();
+  nsCOMPtr<nsIEventTarget> sts =
+      do_GetService(NS_SOCKETTRANSPORTSERVICE_CONTRACTID);
+  ASSERT_TRUE(sts);
+  for (uint32_t scenario = 0; scenario < 6; ++scenario) {
+    const bool recreate = scenario & 1;
+    const bool standard = scenario >= 2;
+    const bool mislabeledRussian = scenario >= 4;
+    const bool allowed = standard && !mislabeledRussian;
+    ASSERT_TRUE(authority.SetManagedContainer(17));
+    const uint64_t lease = authority.CaptureLease(AttributesFor(17));
+    RefPtr<GoodBearLeaseSocket> socket;
+    RefPtr<SSLServerCertVerificationResult> result;
+    ASSERT_EQ(NS_OK, SyncRunnable::DispatchToThread(
+                         sts, NS_NewRunnableFunction("CreateLeaseSocket", [&] {
+                           socket = new GoodBearLeaseSocket();
+                           socket->SetOriginAttributes(
+                               AttributesFor(standard ? 0 : 17));
+                           result = new SSLServerCertVerificationResult(socket);
+                         })));
+
+    Monitor barrier("GoodBearLeaseResultBarrier");
+    bool waiting = false;
+    bool release = false;
+    ASSERT_EQ(NS_OK,
+              sts->Dispatch(NS_NewRunnableFunction("HoldLeaseResult", [&] {
+                MonitorAutoLock lock(barrier);
+                waiting = true;
+                lock.Notify();
+                while (!release) {
+                  lock.Wait();
+                }
+              })));
+    {
+      MonitorAutoLock lock(barrier);
+      while (!waiting) {
+        lock.Wait();
+      }
+    }
+
+    // Inject an already-classified result, not a new fixture trust anchor.
+    // The actual production runnable is queued behind the deterministic hold.
+    nsTArray<nsTArray<uint8_t>> builtChain;
+    GetGoodBearRussianPKIExactTrustAnchors(builtChain);
+    if (standard && !mislabeledRussian) {
+      // Synthetic non-Russian result metadata for the delivery-only control.
+      // This test injects an already-classified result; it is not X.509 proof.
+      builtChain.LastElement().LastElement() ^= 1;
+    }
+    nsTArray<nsTArray<uint8_t>> peerChain;
+    peerChain.SetCapacity(builtChain.Length());
+    for (const auto& certificate : builtChain) {
+      nsTArray<uint8_t> certificateCopy;
+      certificateCopy.AppendElements(certificate);
+      peerChain.AppendElement(std::move(certificateCopy));
+    }
+    EXPECT_EQ(
+        NS_OK,
+        result->Dispatch(
+            std::move(builtChain), std::move(peerChain),
+            nsITransportSecurityInfo::CERTIFICATE_TRANSPARENCY_NOT_APPLICABLE,
+            EVStatus::NotEV, true,
+            standard
+                ? nsITransportSecurityInfo::GoodBearTrustDomain::Standard
+                : nsITransportSecurityInfo::GoodBearTrustDomain::RussianPKI,
+            false, standard ? 0 : lease, 0,
+            nsITransportSecurityInfo::OverridableErrorCategory::ERROR_UNSET,
+            false, 0, false));
+    authority.ClearManagedContainer();
+    if (recreate) {
+      EXPECT_TRUE(authority.SetManagedContainer(17));
+    }
+    {
+      MonitorAutoLock lock(barrier);
+      release = true;
+      lock.Notify();
+    }
+    EXPECT_EQ(NS_OK, SyncRunnable::DispatchToThread(
+                         sts, NS_NewRunnableFunction("CheckLeaseResult", [&] {
+                           EXPECT_EQ(1U, socket->mCompletionCount);
+                           EXPECT_EQ(allowed ? 0 : SEC_ERROR_UNKNOWN_ISSUER,
+                                     socket->mCompletionError);
+                           EXPECT_EQ(!allowed, socket->IsCanceled());
+                           EXPECT_EQ(allowed,
+                                     socket->MayCacheGoodBearSession());
+                           socket = nullptr;
+                         })));
+    result = nullptr;
+  }
+}
+
+TEST_F(GoodBearRussianPKIScopeAuthorityTest,
+       ActiveRussianSocketCannotUseRevokedOrRecreatedLease) {
+  auto& authority = GetGoodBearRussianPKIScopeAuthority();
+  ASSERT_TRUE(authority.SetManagedContainer(17));
+  RefPtr<GoodBearLeaseSocket> russian = new GoodBearLeaseSocket();
+  russian->SetOriginAttributes(AttributesFor(17));
+  russian->SetGoodBearScopeLease(authority.CaptureLease(AttributesFor(17)));
+  russian->SetGoodBearTrustDomain(
+      nsITransportSecurityInfo::GoodBearTrustDomain::RussianPKI);
+  ASSERT_FALSE(russian->IsCanceled());
+  ASSERT_FALSE(russian->MayCacheGoodBearSession());
+
+  RefPtr<GoodBearLeaseSocket> standard = new GoodBearLeaseSocket();
+  standard->SetOriginAttributes(AttributesFor(0));
+  standard->SetGoodBearTrustDomain(
+      nsITransportSecurityInfo::GoodBearTrustDomain::Standard);
+  ASSERT_TRUE(standard->MayCacheGoodBearSession());
+  authority.ClearManagedContainer();
+  ASSERT_TRUE(authority.SetManagedContainer(17));
+  // NSS read/write guards and QUIC input/output/reuse call this production
+  // gate.
+  ASSERT_TRUE(russian->IsCanceled());
+  ASSERT_EQ(SEC_ERROR_UNKNOWN_ISSUER, russian->GetErrorCode());
+  ASSERT_FALSE(russian->MayCacheGoodBearSession());
+  ASSERT_FALSE(standard->IsCanceled());
+  ASSERT_TRUE(standard->MayCacheGoodBearSession());
+}
+
+TEST(GoodBearRussianPKIScopeLeaseTest,
+     LegacyAlternateRootTokensRequireFreshVerification)
+{
+  mozilla::net::SessionCacheInfo info;
+  ASSERT_TRUE(CommonSocketControl::GoodBearCachedChainRequiresFreshVerification(
+      info, 0));
+  ASSERT_TRUE(CommonSocketControl::GoodBearCachedChainRequiresFreshVerification(
+      info, 17));
+  info.mGoodBearTrustDomain =
+      Some(nsITransportSecurityInfo::GoodBearTrustDomain::Invalid);
+  ASSERT_TRUE(
+      CommonSocketControl::GoodBearCachedChainRequiresFreshVerification(info,
+                                                                        0));
+  info.mSucceededCertChainBytes.emplace();
+  ASSERT_TRUE(CommonSocketControl::GoodBearCachedChainRequiresFreshVerification(
+      info, 17));
+  ASSERT_TRUE(
+      CommonSocketControl::GoodBearCachedChainRequiresFreshVerification(info,
+                                                                        0));
+  nsTArray<nsTArray<uint8_t>> chain;
+  GetGoodBearRussianPKIExactTrustAnchors(chain);
+  info.mSucceededCertChainBytes = Some(std::move(chain));
+  info.mGoodBearTrustDomain =
+      Some(nsITransportSecurityInfo::GoodBearTrustDomain::Standard);
+  ASSERT_TRUE(CommonSocketControl::GoodBearCachedChainRequiresFreshVerification(
+      info, 0));
+  ASSERT_TRUE(CommonSocketControl::GoodBearCachedChainRequiresFreshVerification(
+      info, 17));
+  // Classification comes from explicit metadata, never from this exclusion.
+  // Equal names or nearly equal certificates never identify the exact root.
+  info.mSucceededCertChainBytes->LastElement()[0] ^= 1;
+  ASSERT_FALSE(
+      CommonSocketControl::GoodBearCachedChainRequiresFreshVerification(info,
+                                                                        17));
+  ASSERT_FALSE(
+      CommonSocketControl::GoodBearCachedChainRequiresFreshVerification(info,
+                                                                        0));
+}
+
+TEST(GoodBearRussianPKIScopeLeaseTest,
+     MalformedPeerAttributesCannotRestoreToken)
+{
+  mozilla::net::SessionCacheInfo info;
+  nsTArray<uint8_t> token;
+  token.AppendElement(42);
+  ASSERT_EQ(NS_ERROR_NOT_AVAILABLE,
+            mozilla::net::SSLTokensCache::Get(
+                "tlsflags0x00000000:example.test:443^userContextId=invalid"_ns,
+                token, info));
+  ASSERT_TRUE(token.IsEmpty());
+}
+
+TEST_F(GoodBearRussianPKIScopeAuthorityTest,
+       TrustRotationInvalidatesSameHostReuseWithoutChangingManagedIdentity) {
+  auto& authority = GetGoodBearRussianPKIScopeAuthority();
+  ASSERT_TRUE(authority.SetManagedContainer(17));
+  const uint64_t oldLease = authority.CaptureLease(AttributesFor(17));
+  RefPtr<GoodBearLeaseSocket> socket = new GoodBearLeaseSocket();
+  socket->SetOriginAttributes(AttributesFor(17));
+  socket->SetGoodBearScopeLease(oldLease);
+  socket->SetGoodBearTrustDomain(nsITransportSecurityInfo::GoodBearTrustDomain::RussianPKI);
+  bool acceptable = false;
+  ASSERT_EQ(NS_OK, socket->IsAcceptableForHost("example.test"_ns, &acceptable));
+  ASSERT_TRUE(acceptable);
+  bool scopeAllowed = false;
+  ASSERT_EQ(NS_OK, socket->CheckGoodBearLiveScope(&scopeAllowed));
+  ASSERT_TRUE(scopeAllowed);
+  authority.InvalidateTrust();
+  ASSERT_EQ(Some(17U), authority.DedicatedUserContextId());
+  ASSERT_FALSE(authority.ValidateLease(oldLease, AttributesFor(17)));
+  ASSERT_NE(0U, authority.CaptureLease(AttributesFor(17)));
+  ASSERT_EQ(NS_OK, socket->IsAcceptableForHost("example.test"_ns, &acceptable));
+  ASSERT_FALSE(acceptable);
+  ASSERT_TRUE(socket->IsCanceled());
+  ASSERT_EQ(NS_OK, socket->CheckGoodBearLiveScope(&scopeAllowed));
+  ASSERT_FALSE(scopeAllowed);
+  ASSERT_FALSE(socket->MayCacheGoodBearSession());
+}

