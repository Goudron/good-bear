+TEST(GoodBearRussianPKIScopeLeaseTest, GenerationExhaustionNeverWraps)
+{
+  using State = GoodBearRussianPKIScopeLeaseState;
+  const uint64_t lastGeneration = (uint64_t{UINT32_MAX - 1} << 32) | 17;
+  ASSERT_EQ(State::kExhausted, State::NextWord(lastGeneration, 0));
+  ASSERT_EQ(State::kExhausted, State::NextWord(lastGeneration, 17));
+  ASSERT_EQ(State::kExhausted, State::NextWord(State::kExhausted, 17));
+  ASSERT_EQ(State::kExhausted, State::NextWord(State::kExhausted, 0));
+}
