+    );
+    is(scheduled.length, 1, "one blocking decision is scheduled");
+    ok(
+      scheduled[0][3].trustSourceChanged,
+      "the decision is explicitly marked as a trust-source change"
+    );
+    ok(!scheduled[0][3].autoOpen, "a prior STANDARD origin never auto-opens");
+    ok(
+      scheduled[0][3].hasRequestBody,
+      "a body-bearing method remains explicitly non-replayable"
+    );
+
+    policy._handleAddressOnlyChoice(
+      window,
+      browser,
+      origin,
+      GoodBearRussianPKIContainer.dedicatedUserContextId,
+      true,
+      true,
+      false,
+      true
+    );
+  } finally {
+    policy._scheduleAddressOnlyOpen = originalSchedule;
+    policy._promptAddressOnlyOpen = originalPrompt;
+    policy._openAddressOnlyInContainer = originalOpen;
+  }
+  is(backCalls, 1, "Back operates only on the original error tab");
+  is(opened.length, 0, "Back opens no isolated connection");
+  ok(!assignments.isAssigned(origin), "Back creates no assignment");
+  is(
+    history.get(origin).lastConfirmedDomain,
