+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+const {
+  GoodBearRussianPKIAssignmentStore,
+  GoodBearRussianPKIContainerManager,
+  GoodBearRussianPKILoadDecision,
+  GoodBearRussianPKITrustDomain,
+  GoodBearRussianPKITrustHistoryStore,
+  GoodBearRussianPKITrustTransition,
+} = ChromeUtils.importESModule(
+  "resource:///modules/GoodBearRussianPKIContainer.sys.mjs"
+);
+
+/** Provides the native publication boundary without production PSM state. */
+class FakeScopeAuthority {
+  setGoodBearRussianPKIContainerId() {
+    return true;
+  }
+
+  clearGoodBearRussianPKIContainerId() {}
+}
+
+async function withResetManager(callback) {
+  const basePath = PathUtils.join(
+    PathUtils.tempDir,
+    `goodbear-sticky-assignment-${Services.uuid.generateUUID()}`
+  );
+  const assignmentPath = `${basePath}.assignments`;
+  const identityPath = `${basePath}.identities`;
+  const historyPath = `${basePath}.history`;
+  const assignments = new GoodBearRussianPKIAssignmentStore(assignmentPath);
+  const history = new GoodBearRussianPKITrustHistoryStore(historyPath);
+  const identityService =
+    ContextualIdentityService.createNewInstanceForTesting(identityPath);
+  const manager = new GoodBearRussianPKIContainerManager(
+    identityService,
+    new FakeScopeAuthority(),
+    assignments,
+    history
+  );
+  await manager.initialize();
+  try {
+    await callback({ assignments, history, manager });
+  } finally {
+    manager.stop();
+    await Promise.all(
+      [assignmentPath, identityPath, historyPath].map(path =>
+        IOUtils.remove(path, { ignoreAbsent: true })
+      )
+    );
+  }
+}
+
+async function assignRussianPKIOrigin(manager, origin) {
+  ok(
+    await manager.completeFirstVisitRussianPKIAssignment(
+      origin,
+      GoodBearRussianPKITrustDomain.RussianPKI
+    ),
+    `${origin} is assigned only after a native Russian PKI result`
+  );
+}
+
+add_task(
+  async function test_assignment_stays_isolated_after_standard_observation() {
+    await withResetManager(async ({ assignments, history, manager }) => {
+      const origin = "https://sticky-standard.example.test/";
+      await assignRussianPKIOrigin(manager, origin);
+
+      ok(
+        !(await manager.recordOrdinaryStandardObservation(
+          origin,
+          GoodBearRussianPKITrustDomain.Standard
+        )),
+        "a later STANDARD observation cannot overwrite an assigned origin"
+      );
+      ok(
+        assignments.isAssigned(origin),
+        "the exact assignment remains present"
+      );
+      is(
+        history.get(origin).lastConfirmedDomain,
+        GoodBearRussianPKITrustDomain.RussianPKI,
+        "the prior Russian PKI routing observation remains unchanged"
+      );
+      is(
+        manager.getLoadDecision(origin, 0).type,
+        GoodBearRussianPKILoadDecision.Isolated,
+        "RUSSIAN_PKI to STANDARD never silently returns to the ordinary context"
+      );
+    });
+  }
+);
+
+add_task(async function test_one_origin_reset_removes_assignment_and_history() {
+  await withResetManager(async ({ assignments, history, manager }) => {
+    const resetOrigin = "https://reset-one.example.test/path";
+    const retainedOrigin = "https://retain-one.example.test/";
+    await assignRussianPKIOrigin(manager, resetOrigin);
+    await assignRussianPKIOrigin(manager, retainedOrigin);
+
+    ok(
+      await manager.resetAssignment(resetOrigin),
+      "one exact origin is reset as a paired routing-state operation"
+    );
+    ok(!assignments.isAssigned(resetOrigin), "the selected assignment is gone");
+    is(history.get(resetOrigin), null, "the selected history is also gone");
+    is(
+      manager.getLoadDecision(resetOrigin, 0).type,
+      GoodBearRussianPKILoadDecision.Ordinary,
+      "the next visit has no stale container routing decision"
+    );
+    ok(
+      await manager.recordOrdinaryStandardObservation(
+        resetOrigin,
+        GoodBearRussianPKITrustDomain.Standard
+      ),
+      "the next successful visit is freshly classified"
+    );
+    is(
+      history.get(resetOrigin).lastTransition,
+      GoodBearRussianPKITrustTransition.InitialStandard,
+      "fresh classification does not inherit the removed Russian PKI state"
+    );
+    ok(
+      assignments.isAssigned(retainedOrigin),
+      "resetting one origin does not weaken another assignment"
+    );
+  });
+});
+
+add_task(async function test_all_reset_removes_every_assignment_and_history() {
+  await withResetManager(async ({ assignments, history, manager }) => {
+    const firstOrigin = "https://reset-all-first.example.test/";
+    const secondOrigin = "https://reset-all-second.example.test/";
+    await assignRussianPKIOrigin(manager, firstOrigin);
+    await assignRussianPKIOrigin(manager, secondOrigin);
+
+    ok(
+      await manager.resetAllAssignments(),
+      "the full reset commits all routing-state removals together"
+    );
+    is(assignments.assignments().length, 0, "no assignment remains");
+    is(history.entries().length, 0, "no routing history remains");
+    for (const origin of [firstOrigin, secondOrigin]) {
+      is(
+        manager.getLoadDecision(origin, 0).type,
+        GoodBearRussianPKILoadDecision.Ordinary,
+        `${origin} is freshly classified on its next visit`
+      );
+    }
+  });
+});
+
+add_task(async function test_failed_reset_restores_the_exact_prior_pair() {
+  await withResetManager(async ({ assignments, history, manager }) => {
+    const origin = "https://failed-reset.example.test/";
+    await assignRussianPKIOrigin(manager, origin);
+    const previousHistory = history.get(origin);
+    const originalClear = assignments.clear;
+    assignments.clear = async () => false;
+    try {
+      ok(
+        !(await manager.resetAssignment(origin)),
+        "a failed authoritative assignment write rejects the reset"
+      );
+    } finally {
+      assignments.clear = originalClear;
+    }
+    ok(
+      assignments.isAssigned(origin),
+      "the assignment remains after the failed paired reset"
+    );
+    Assert.deepEqual(
+      history.get(origin),
+      previousHistory,
+      "the exact prior history is restored after the failed paired reset"
+    );
+    is(
+      manager.getLoadDecision(origin, 0).type,
+      GoodBearRussianPKILoadDecision.Isolated,
+      "a failed reset never leaks the assigned origin into the ordinary context"
+    );
+  });
+});
+
+add_task(async function test_failed_full_reset_restores_every_prior_pair() {
+  await withResetManager(async ({ assignments, history, manager }) => {
+    const firstOrigin = "https://failed-all-first.example.test/";
+    const secondOrigin = "https://failed-all-second.example.test/";
+    await assignRussianPKIOrigin(manager, firstOrigin);
+    await assignRussianPKIOrigin(manager, secondOrigin);
+    const previousHistory = history.entries();
+    const originalClearAll = assignments.clearAll;
+    assignments.clearAll = async () => false;
