+      "every prior history entry is restored after the failed full reset"
+    );
+    for (const origin of [firstOrigin, secondOrigin]) {
+      ok(
+        assignments.isAssigned(origin),
+        `${origin} remains assigned after the failed full reset`
+      );
+      is(
+        manager.getLoadDecision(origin, 0).type,
+        GoodBearRussianPKILoadDecision.Isolated,
+        `${origin} never leaks into the ordinary context after the failed full reset`
+      );
+    }
+  });
+});
