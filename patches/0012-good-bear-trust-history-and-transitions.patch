+      await manager.completeConfirmedStandardToRussianPKIAssignment(
+        origin,
+        GoodBearRussianPKITrustDomain.RussianPKI
+      ),
+      "explicit consent followed by native Russian PKI success commits"
+    );
+    ok(assignments.isAssigned(origin), "the exact origin becomes assigned");
+    const entry = history.get(origin);
+    is(
+      entry.lastConfirmedDomain,
+      GoodBearRussianPKITrustDomain.RussianPKI,
+      "history records the newly confirmed domain"
+    );
+    is(
+      entry.lastTransition,
+      GoodBearRussianPKITrustTransition.StandardToRussianPKI,
+      "history records only the expected transition"
+    );
+  });
+});
