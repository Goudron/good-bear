+add_task(async function test_transition_commit_fails_closed_and_rolls_back() {
+  await withTransitionManager(async ({ assignments, history, manager }) => {
+    const origin = "https://commit-failure.example.test/";
+    const unknown = "https://no-standard-history.example.test/";
+    await history.recordConfirmed(
+      origin,
+      GoodBearRussianPKITrustDomain.Standard
+    );
+
+    ok(
+      !(await manager.completeConfirmedStandardToRussianPKIAssignment(
+        unknown,
+        GoodBearRussianPKITrustDomain.RussianPKI
+      )),
+      "history cannot be skipped to manufacture transition consent"
+    );
+    ok(!assignments.isAssigned(unknown), "unknown origin remains unassigned");
+
+    const originalRecordConfirmed = history.recordConfirmed;
+    history.recordConfirmed = async () => false;
+    try {
+      ok(
+        !(await manager.completeConfirmedStandardToRussianPKIAssignment(
+          origin,
+          GoodBearRussianPKITrustDomain.RussianPKI
+        )),
+        "a paired history-write failure rejects the commit"
+      );
+    } finally {
+      history.recordConfirmed = originalRecordConfirmed;
+    }
+    ok(
+      !assignments.isAssigned(origin),
+      "no usable assignment survives the paired-write failure"
+    );
+    is(
+      history.get(origin).lastConfirmedDomain,
+      GoodBearRussianPKITrustDomain.Standard,
+      "the previous STANDARD state survives the failure"
+    );
+
+    const assignmentFailure = "https://assignment-failure.example.test/";
+    await history.recordConfirmed(
+      assignmentFailure,
+      GoodBearRussianPKITrustDomain.Standard
+    );
+    const previousEntry = history.get(assignmentFailure);
+    const originalAssign = assignments.assign;
+    assignments.assign = async () => false;
+    try {
+      ok(
+        !(await manager.completeConfirmedStandardToRussianPKIAssignment(
+          assignmentFailure,
+          GoodBearRussianPKITrustDomain.RussianPKI
+        )),
+        "an assignment-write failure rejects the paired transaction"
+      );
+    } finally {
+      assignments.assign = originalAssign;
+    }
+    ok(
+      !assignments.isAssigned(assignmentFailure),
+      "an assignment failure publishes no routing authority"
+    );
+    Assert.deepEqual(
+      history.get(assignmentFailure),
+      previousEntry,
+      "an assignment failure restores the exact prior history entry"
+    );
+  });
+});
