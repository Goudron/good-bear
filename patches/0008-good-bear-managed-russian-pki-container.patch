+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { ContextualIdentityService } from "moz-src:///toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs";
+
+// This value is an implementation identity, not presentation text. The only
+// authority for Russian PKI container scope is the real userContextId held by
+// the matching native contextual identity. M5-02 will own whether support is
+// enabled; M6 will own routing. Neither a name nor an icon authorizes trust.
+export const GOOD_BEAR_RUSSIAN_PKI_CONTAINER_PURPOSE =
+  "goodbear-russian-pki";
+
+const CONTAINER_NAME = "Российская PKI";
+const CONTAINER_ICON = "fence";
+const CONTAINER_COLOR = "gray";
+const CONTAINER_DELETED_TOPIC = "contextual-identity-deleted";
+
+function isUsableManagedIdentity(identity) {
+  return (
+    identity?.public === true &&
+    Number.isInteger(identity.userContextId) &&
+    identity.userContextId > 0 &&
+    identity.managedPurpose === GOOD_BEAR_RUSSIAN_PKI_CONTAINER_PURPOSE
+  );
+}
+
+export class GoodBearRussianPKIContainerManager {
+  constructor(identityService = ContextualIdentityService) {
+    this._identityService = identityService;
+    this._dedicatedUserContextId = null;
+    this._started = false;
+  }
+
+  start() {
+    if (!this._started) {
+      Services.obs.addObserver(this, CONTAINER_DELETED_TOPIC);
+      this._started = true;
+    }
+    return this.ensureContainer();
+  }
+
+  stop() {
+    if (this._started) {
+      Services.obs.removeObserver(this, CONTAINER_DELETED_TOPIC);
+      this._started = false;
+    }
+    this._dedicatedUserContextId = null;
+  }
+
+  observe(subject, topic) {
+    if (topic !== CONTAINER_DELETED_TOPIC) {
+      return;
+    }
+    const deletedId = subject?.wrappedJSObject?.userContextId;
+    if (deletedId === this._dedicatedUserContextId) {
+      // `remove` has already cleared state for the deleted OriginAttributes.
+      // The replacement necessarily gets a different userContextId, making
+      // stale in-flight IDs fail closed when the scope authority rechecks it.
+      this._dedicatedUserContextId = null;
+      this.ensureContainer();
+    }
+  }
+
+  get dedicatedUserContextId() {
+    return this._dedicatedUserContextId;
+  }
+
+  getScopeSnapshot() {
+    return this._dedicatedUserContextId === null
+      ? null
+      : Object.freeze({
+          purpose: GOOD_BEAR_RUSSIAN_PKI_CONTAINER_PURPOSE,
+          userContextId: this._dedicatedUserContextId,
+        });
+  }
+
+  ensureContainer() {
+    const matches = this._identityService
+      .getPublicIdentities()
+      .filter(isUsableManagedIdentity);
+
+    // A corrupt profile that claims the managed purpose twice is ambiguous.
+    // Do not select one, do not erase a possibly user-owned identity, and do
+    // not fall back to the ordinary context.
+    if (matches.length > 1) {
+      this._dedicatedUserContextId = null;
+      return null;
+    }
+
+    if (matches.length === 1) {
+      const identity = matches[0];
+      this._dedicatedUserContextId = identity.userContextId;
+      this._repairPresentation(identity);
+      return this._identityService.getPublicIdentityFromId(
+        identity.userContextId
+      );
+    }
+
+    const identity = this._identityService.createManagedIdentity(
+      CONTAINER_NAME,
+      CONTAINER_ICON,
+      CONTAINER_COLOR,
+      GOOD_BEAR_RUSSIAN_PKI_CONTAINER_PURPOSE
+    );
+    this._dedicatedUserContextId = identity.userContextId;
+    return identity;
+  }
+
+  _repairPresentation(identity) {
+    if (
+      identity.name !== CONTAINER_NAME ||
+      identity.icon !== CONTAINER_ICON ||
+      identity.color !== CONTAINER_COLOR
+    ) {
+      this._identityService.update(
+        identity.userContextId,
+        CONTAINER_NAME,
+        CONTAINER_ICON,
+        CONTAINER_COLOR
+      );
+    }
+  }
+}
+
+export const GoodBearRussianPKIContainer =
+  new GoodBearRussianPKIContainerManager();
