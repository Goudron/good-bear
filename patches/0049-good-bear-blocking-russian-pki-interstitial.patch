+add_task(
+  async function test_interstitial_navigation_and_scope_changes_revoke_consent() {
+    await SpecialPowers.pushPrefEnv({
+      set: [["security.goodbear.russian_pki.enabled", true]],
+    });
+    await GoodBearRussianPKIContainer.initialize();
+    try {
+      for (const change of [
+        "reload",
+        "same-document",
+        "history",
+        "pref",
+        "tab-select",
+      ]) {
+        await BrowserTestUtils.withNewTab(
+          "https://example.com/",
+          async browser => {
+            if (change === "history") {
+              BrowserTestUtils.startLoadingURIString(
+                browser,
+                "https://example.org/"
+              );
+              await BrowserTestUtils.browserLoaded(browser);
+            }
+            const surface = await openGoodBearInterstitial(browser);
+            if (change === "reload") {
+              const loaded = BrowserTestUtils.browserLoaded(browser);
+              browser.reload();
+              await loaded;
+            } else if (change === "same-document") {
+              await SpecialPowers.spawn(browser, [], () => {
+                content.location.hash = "new-document-state";
+              });
+            } else if (change === "history") {
+              const loaded = BrowserTestUtils.browserLoaded(browser);
+              browser.goBack();
+              await loaded;
+            } else if (change === "pref") {
+              Services.prefs.setBoolPref(
+                "security.goodbear.russian_pki.enabled",
+                false
+              );
+              Services.prefs.setBoolPref(
+                "security.goodbear.russian_pki.enabled",
+                true
+              );
+            } else {
+              const other = await BrowserTestUtils.openNewForegroundTab(
+                gBrowser,
+                "about:blank"
+              );
+              await BrowserTestUtils.switchTab(
+                gBrowser,
+                gBrowser.getTabForBrowser(browser)
+              );
+              BrowserTestUtils.removeTab(other);
+            }
+            await surface.pending;
+            Assert.deepEqual(
+              surface.calls,
+              [],
+              change + " permanently revokes consent"
+            );
+          }
+        );
+      }
+    } finally {
+      await SpecialPowers.popPrefEnv();
+    }
+  }
+);
