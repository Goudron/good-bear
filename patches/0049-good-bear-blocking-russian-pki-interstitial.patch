+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  ContextualIdentityService:
+    "resource://gre/modules/ContextualIdentityService.sys.mjs",
+  GoodBearRussianPKIContainer:
+    "resource:///modules/GoodBearRussianPKIContainer.sys.mjs",
+});
+
+const ENABLED_PREF = "security.goodbear.russian_pki.enabled";
+const IDENTITY_TOPICS = [
+  "contextual-identity-deleted",
+  "contextual-identity-created",
+  "contextual-identity-updated",
+];
+const MESSAGE_IDS = [
+  "goodbear-russian-pki-interstitial-title",
+  "goodbear-russian-pki-interstitial-description",
+  "goodbear-russian-pki-interstitial-body-title",
+  "goodbear-russian-pki-interstitial-body-description",
+  "goodbear-russian-pki-interstitial-trust-changed-title",
+  "goodbear-russian-pki-interstitial-trust-changed-description",
+  "goodbear-russian-pki-interstitial-open-isolated",
+  "goodbear-russian-pki-interstitial-go-back",
+  "goodbear-russian-pki-interstitial-view-certificate",
+];
+
+export const GoodBearRussianPKIInterstitial = {
+  // A tab-scoped chrome surface, never a new trust classifier. Callers already
+  // stopped the request and retain only its address, not its upload or state.
+  async open(
+    browser,
+    {
+      userContextId,
+      hasRequestBody,
+      trustSourceChanged,
+      onChoice,
+      viewCertificate = null,
+    }
+  ) {
+    const window = browser?.documentGlobal;
+    const context = browser?.browsingContext;
+    const windowGlobal = context?.currentWindowGlobal;
+    const innerWindowId = windowGlobal?.innerWindowId;
+    const manager = lazy.GoodBearRussianPKIContainer;
+    const sourceURI = browser?.currentURI?.spec;
+    let revoked = false;
+    let chosen = false;
+    let viewingCertificate = false;
+    let result = "cancel";
+    let dialog;
+    const listeners = [];
+
+    const current = () => {
+      const identity =
+        lazy.ContextualIdentityService.getPublicIdentityFromId(userContextId);
+      return (
+        !revoked &&
+        window &&
+        !window.closed &&
+        browser.isConnected &&
+        window.gBrowser.selectedBrowser === browser &&
+        browser.browsingContext === context &&
+        context === context.top &&
+        context.currentWindowGlobal === windowGlobal &&
+        windowGlobal?.innerWindowId === innerWindowId &&
+        !!innerWindowId &&
+        browser.currentURI?.spec === sourceURI &&
+        context.originAttributes.privateBrowsingId === 0 &&
+        context.originAttributes.userContextId === 0 &&
+        lazy.GoodBearRussianPKIContainer === manager &&
+        manager.dedicatedUserContextId === userContextId &&
+        Services.prefs.getBoolPref(ENABLED_PREF, false) &&
+        identity?.userContextId === userContextId &&
+        identity.managedPurpose === "goodbear-russian-pki"
+      );
+    };
+    const revoke = () => {
+      revoked = true;
+      result = "cancel";
+      dialog?.abort();
+    };
+    const tabSelect = () => {
+      if (window.gBrowser.selectedBrowser !== browser) {
+        revoke();
+      }
+    };
+    const identityObserver = {
+      observe(subject) {
+        const changedId = subject?.wrappedJSObject?.userContextId;
+        if (!changedId || changedId === userContextId) {
+          revoke();
+        }
+      },
+    };
+    const prefObserver = { observe: revoke };
+    const progress = {
+      onLocationChange(webProgress) {
+        if (webProgress.isTopLevel) {
+          // Includes same-document changes that TabDialogBox itself ignores.
+          revoke();
+        }
+      },
+      QueryInterface: ChromeUtils.generateQI([
+        "nsIWebProgressListener",
+        "nsISupportsWeakReference",
+      ]),
+    };
+
+    try {
+      if (typeof onChoice !== "function" || !current()) {
+        return "cancel";
+      }
+      Services.prefs.addObserver(ENABLED_PREF, prefObserver);
+      listeners.push(() =>
+        Services.prefs.removeObserver(ENABLED_PREF, prefObserver)
+      );
+      for (const topic of IDENTITY_TOPICS) {
+        Services.obs.addObserver(identityObserver, topic);
+        listeners.push(() =>
+          Services.obs.removeObserver(identityObserver, topic)
+        );
+      }
+      window.gBrowser.tabContainer.addEventListener("TabSelect", tabSelect);
+      listeners.push(() =>
+        window.gBrowser.tabContainer.removeEventListener("TabSelect", tabSelect)
+      );
+      const tab = window.gBrowser.getTabForBrowser(browser);
+      tab.addEventListener("TabClose", revoke);
+      listeners.push(() => tab.removeEventListener("TabClose", revoke));
+      browser.webProgress.addProgressListener(
+        progress,
+        Ci.nsIWebProgress.NOTIFY_LOCATION
+      );
+      listeners.push(() =>
+        browser.webProgress.removeProgressListener(progress)
+      );
+
+      const values = new window.Localization(
+        ["browser/browser.ftl"],
+        true
+      ).formatValuesSync(MESSAGE_IDS);
+      if (
+        values.length !== MESSAGE_IDS.length ||
+        values.some(
+          (value, index) =>
+            typeof value !== "string" ||
+            !value.trim() ||
+            value === MESSAGE_IDS[index]
+        )
+      ) {
+        return "cancel";
+      }
+      let messageIndex = 0;
+      if (trustSourceChanged) {
+        messageIndex = 4;
+      } else if (hasRequestBody) {
+        messageIndex = 2;
+      }
+      const model = {
+        title: values[messageIndex],
+        description: values[messageIndex + 1],
+        bodyDescription: trustSourceChanged && hasRequestBody ? values[3] : "",
+        openLabel: values[6],
+        backLabel: values[7],
+        certificateLabel: values[8],
+        canViewCertificate: typeof viewCertificate === "function",
+        async choose(action) {
+          if (chosen || viewingCertificate || !current()) {
+            revoke();
+            return false;
+          }
+          if (action === "certificate") {
+            if (typeof viewCertificate !== "function") {
+              return false;
+            }
+            viewingCertificate = true;
+            try {
+              // Opening the native viewer selects its tab; TabSelect revokes
+              // this consent permanently. No exemption and no revived token.
+              await viewCertificate(current);
+            } catch {
+              revoke();
+            } finally {
+              viewingCertificate = false;
+            }
+            return false;
+          }
+          if (action !== "open" && action !== "back") {
+            revoke();
+            return false;
+          }
+          chosen = true;
+          result = action;
+          return true;
+        },
+      };
+      const opened = window.gBrowser.getTabDialogBox(browser).open(
+        "chrome://browser/content/goodbearRussianPKIInterstitial.xhtml",
+        {
+          sizeTo: "available",
+          keepOpenSameOriginNav: false,
+          allowDuplicateDialogs: false,
+          hideContent: true,
+        },
+        model
+      );
+      dialog = opened.dialog;
+      if (!dialog || !current()) {
+        revoke();
+        return "cancel";
+      }
+      await opened.closedPromise;
+      if (!current() || (result !== "open" && result !== "back")) {
+        return "cancel";
+      }
+      const selected = result;
+      // Keep revocation observers until the action itself. Returning a bare
+      // consent flag and removing observers before the caller's await resumes
+      // would let disable/re-enable revive consent between two microtasks.
+      onChoice(selected, current);
+      return selected;
+    } catch {
+      revoke();
+      return "cancel";
+    } finally {
+      for (const cleanup of listeners.reverse()) {
+        cleanup();
+      }
+    }
+  },
+};
