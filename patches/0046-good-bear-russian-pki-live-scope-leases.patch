+TEST_F(GoodBearRussianPKIScopeAuthorityTest,
+       ActiveRussianSocketCannotUseRevokedOrRecreatedLease) {
+  auto& authority = GetGoodBearRussianPKIScopeAuthority();
+  ASSERT_TRUE(authority.SetManagedContainer(17));
+  RefPtr<GoodBearLeaseSocket> russian = new GoodBearLeaseSocket();
+  russian->SetOriginAttributes(AttributesFor(17));
+  russian->SetGoodBearScopeLease(authority.CaptureLease(AttributesFor(17)));
+  russian->SetGoodBearTrustDomain(
+      nsITransportSecurityInfo::GoodBearTrustDomain::RussianPKI);
+  ASSERT_FALSE(russian->IsCanceled());
+  ASSERT_FALSE(russian->MayCacheGoodBearSession());
+
+  RefPtr<GoodBearLeaseSocket> standard = new GoodBearLeaseSocket();
+  standard->SetOriginAttributes(AttributesFor(0));
+  standard->SetGoodBearTrustDomain(
+      nsITransportSecurityInfo::GoodBearTrustDomain::Standard);
+  ASSERT_TRUE(standard->MayCacheGoodBearSession());
+  authority.ClearManagedContainer();
+  ASSERT_TRUE(authority.SetManagedContainer(17));
+  // NSS read/write guards and QUIC input/output/reuse call this production
+  // gate.
+  ASSERT_TRUE(russian->IsCanceled());
+  ASSERT_EQ(SEC_ERROR_UNKNOWN_ISSUER, russian->GetErrorCode());
+  ASSERT_FALSE(russian->MayCacheGoodBearSession());
+  ASSERT_FALSE(standard->IsCanceled());
+  ASSERT_TRUE(standard->MayCacheGoodBearSession());
+}
