+  ASSERT_FALSE(authority.InstallLeaseReader(readerHandle));
+  ASSERT_FALSE(authority.InstallLeaseReader(nullptr));
+  ASSERT_TRUE(authority.Allows(AttributesFor(17)));
+  ASSERT_FALSE(authority.ValidateLease(0, AttributesFor(17)));
