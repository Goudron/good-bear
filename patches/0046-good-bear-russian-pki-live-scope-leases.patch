+
+bool GoodBearRussianPKIScopeAuthority::InstallLeaseReader(
+    const ipc::ReadOnlySharedMemoryHandle& aHandle) {
+  if (!XRE_IsSocketProcess() ||
+      aHandle.Size() != sizeof(GoodBearRussianPKIScopeLeaseState)) {
+    return false;
+  }
+  auto scope = mScope.Lock();
+  // The Init IPC installs one reader before the process may use alternate
+  // trust. Replacing it could reinterpret a still-live socket's old lease.
+  if (scope->mLeaseReader) {
+    return false;
+  }
+  scope->mLeaseReader = aHandle.Map();
+  return bool(scope->mLeaseReader);
+}
