+      GoodBearRussianPKIScopeLeaseState();
+  auto [reader, writer] = std::move(mapping).FreezeWithMutableMapping();
+  if (!reader || !writer) {
+    return false;
+  }
+  aScope.mLeaseReaderHandle = std::move(reader);
+  aScope.mLeaseWriter = std::move(writer);
+  return true;
+}
