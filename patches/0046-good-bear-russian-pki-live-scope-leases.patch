+TEST(GoodBearRussianPKIScopeLeaseTest,
+     MalformedPeerAttributesCannotRestoreToken)
+{
+  mozilla::net::SessionCacheInfo info;
+  nsTArray<uint8_t> token;
+  token.AppendElement(42);
+  ASSERT_EQ(NS_ERROR_NOT_AVAILABLE,
+            mozilla::net::SSLTokensCache::Get(
+                "tlsflags0x00000000:example.test:443^userContextId=invalid"_ns,
+                token, info));
+  ASSERT_TRUE(token.IsEmpty());
+}
