+
+bool CommonSocketControl::GoodBearCachedChainRequiresFreshVerification(
+    const mozilla::net::SessionCacheInfo& aInfo, uint32_t aUserContextId) {
+  // Earlier Good Bear caches did not persist the trust domain. Never resume a
+  // chain ending at the exact alternate root: obtain a fresh scoped decision.
+  // This is a cache exclusion, never a certificate acceptance decision.
+  if (!aInfo.mSucceededCertChainBytes ||
+      aInfo.mSucceededCertChainBytes->IsEmpty()) {
+    // A nondefault identity may be a retired managed container. Missing chain
+    // metadata cannot prove this is a Standard token. Ordinary default-context
+    // caching and complete Standard chains in other containers are unchanged.
+    return aUserContextId != 0;
+  }
+  const auto& root = aInfo.mSucceededCertChainBytes->LastElement();
+  return root.Length() == sizeof(mozilla::psm::kGoodBearRussianPKIExactRoot) &&
+         memcmp(root.Elements(), mozilla::psm::kGoodBearRussianPKIExactRoot,
+                root.Length()) == 0;
 }
 
