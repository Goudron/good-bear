+TEST(GoodBearRussianPKIScopeLeaseTest, UninitializedAndWrongScopesFailClosed)
+{
+  GoodBearRussianPKIScopeLeaseState state;
+  ASSERT_EQ(0U, state.Capture(17, false));
+  ASSERT_FALSE(state.Matches(0, 17, false));
+  ASSERT_TRUE(state.Publish(17));
+  const uint64_t lease = state.Capture(17, false);
+  ASSERT_NE(0U, lease);
+  ASSERT_TRUE(state.Matches(lease, 17, false));
+  ASSERT_FALSE(state.Matches(lease, 0, false));
+  ASSERT_FALSE(state.Matches(lease, 18, false));
+  ASSERT_FALSE(state.Matches(lease, 17, true));
+  ASSERT_FALSE(state.Matches(lease + (uint64_t{1} << 32), 17, false));
+}
+
+TEST(GoodBearRussianPKIScopeLeaseTest, RecreatedIdentityCannotReviveOldLease)
+{
+  GoodBearRussianPKIScopeLeaseState state;
+  ASSERT_TRUE(state.Publish(17));
+  const uint64_t oldLease = state.Capture(17, false);
+  ASSERT_FALSE(state.Publish(0));
+  ASSERT_FALSE(state.Matches(oldLease, 17, false));
+  ASSERT_TRUE(state.Publish(17));
+  ASSERT_FALSE(state.Matches(oldLease, 17, false));
+  const uint64_t newLease = state.Capture(17, false);
+  ASSERT_NE(oldLease, newLease);
+  ASSERT_TRUE(state.Matches(newLease, 17, false));
+  ASSERT_TRUE(state.Publish(23));
+  ASSERT_FALSE(state.Matches(newLease, 17, false));
+  ASSERT_FALSE(state.Matches(newLease, 23, false));
+}
+
+TEST(GoodBearRussianPKIScopeLeaseTest, GenerationExhaustionNeverWraps)
+{
+  using State = GoodBearRussianPKIScopeLeaseState;
+  const uint64_t lastGeneration = (uint64_t{UINT32_MAX - 1} << 32) | 17;
+  ASSERT_EQ(State::kExhausted, State::NextWord(lastGeneration, 0));
+  ASSERT_EQ(State::kExhausted, State::NextWord(lastGeneration, 17));
+  ASSERT_EQ(State::kExhausted, State::NextWord(State::kExhausted, 17));
+  ASSERT_EQ(State::kExhausted, State::NextWord(State::kExhausted, 0));
+}
+
+TEST_F(GoodBearRussianPKIScopeAuthorityTest,
+       ReadOnlyLeaseMappingObservesParentRevocationAndRecreation) {
+  auto& authority = GetGoodBearRussianPKIScopeAuthority();
+  auto readerHandle = authority.CreateLeaseReader();
+  ASSERT_TRUE(readerHandle);
+  auto reader = readerHandle.Map();
+  ASSERT_TRUE(reader);
+  const auto* state = reader.DataAs<GoodBearRussianPKIScopeLeaseState>();
+  ASSERT_EQ(0U, state->Capture(17, false));
+  ASSERT_TRUE(authority.SetManagedContainer(17));
+  const uint64_t oldLease = authority.CaptureLease(AttributesFor(17));
+  ASSERT_TRUE(state->Matches(oldLease, 17, false));
+  ASSERT_TRUE(authority.ValidateLease(oldLease, AttributesFor(17)));
+  // The original writer remains writable after FreezeWithMutableMapping.
+  authority.ClearManagedContainer();
+  ASSERT_FALSE(state->Matches(oldLease, 17, false));
+  ASSERT_FALSE(authority.ValidateLease(oldLease, AttributesFor(17)));
+  ASSERT_TRUE(authority.SetManagedContainer(17));
+  ASSERT_FALSE(state->Matches(oldLease, 17, false));
+  const uint64_t newLease = authority.CaptureLease(AttributesFor(17));
+  ASSERT_TRUE(state->Matches(newLease, 17, false));
+  ASSERT_FALSE(state->Matches(newLease, 17, true));
+}
