diff --git a/toolkit/components/url-classifier/LookupCache.cpp b/toolkit/components/url-classifier/LookupCache.cpp
index e754717..3109553 100644
--- a/toolkit/components/url-classifier/LookupCache.cpp
+++ b/toolkit/components/url-classifier/LookupCache.cpp
@@ -272,6 +272,20 @@ nsresult LookupCache::WriteFile() {
   return NS_OK;
 }
 
+GoodBearGoogleVerdictFreshness LookupCache::GoogleVerdictFreshness(
+    const Completion& aCompletion) const {
+  const CachedFullHashResponse* response =
+      mFullHashCache.Get(aCompletion.ToUint32());
+  if (!response) {
+    return {};
+  }
+  nsDependentCSubstring completion(
+      reinterpret_cast<const char*>(aCompletion.buf), COMPLETE_SIZE);
+  return response->fullHashes.Contains(completion)
+             ? response->mGoodBearFreshness
+             : GoodBearGoogleVerdictFreshness{};
+}
+
 nsresult LookupCache::CheckCache(const Completion& aCompletion, bool* aHas,
                                  bool* aConfirmed) {
   // Shouldn't call this function if prefix is not in the database.
@@ -296,6 +310,13 @@ nsresult LookupCache::CheckCache(const Completion& aCompletion, bool* aHas,
   // Check if we can find the fullhash in positive cache
   if (fullHashes.Get(completion, &expiryTimeSec)) {
     if (nowSec <= expiryTimeSec) {
+      if (RequiresFreshGoogleVerdict() &&
+          !fullHashResponse->mGoodBearFreshness.IsFresh()) {
+        // Keep the server-provided cache lifetime intact, but require a fresh
+        // completion before this Google-backed positive can enforce.
+        LOG(("Found a server-valid fullhash with stale source information"));
+        return NS_OK;
+      }
       // Url is NOT safe.
       *aConfirmed = true;
       LOG(("Found a valid fullhash in the positive cache"));
diff --git a/toolkit/components/url-classifier/LookupCache.h b/toolkit/components/url-classifier/LookupCache.h
index cba56db..6cec4f7 100644
--- a/toolkit/components/url-classifier/LookupCache.h
+++ b/toolkit/components/url-classifier/LookupCache.h
@@ -64,7 +64,25 @@ class LookupResult {
     return hex;
   }
 
-  bool Confirmed() const { return mConfirmed || mProtocolConfirmed; }
+  bool ConfirmedAt(const TimeStamp& aNow, int64_t aWallUsec) const {
+    return (mConfirmed || mProtocolConfirmed) &&
+           (!mGoodBearRequiresFreshGoogleVerdict ||
+            mGoodBearFreshness.IsFreshAt(aNow, aWallUsec));
+  }
+
+  bool Confirmed() const {
+    return (mConfirmed || mProtocolConfirmed) &&
+           (!mGoodBearRequiresFreshGoogleVerdict ||
+            mGoodBearFreshness.IsFresh());
+  }
+
+  bool ConfirmWithoutCompleter() {
+    if (!Complete() || mGoodBearRequiresFreshGoogleVerdict) {
+      return false;
+    }
+    mConfirmed = true;
+    return true;
+  }
 
   // True if we have a complete match for this hash in the table.
   bool Complete() const { return mPartialHashLength == COMPLETE_SIZE; }
@@ -87,6 +105,9 @@ class LookupResult {
 
   bool mProtocolV2;
 
+  bool mGoodBearRequiresFreshGoogleVerdict = false;
+  GoodBearGoogleVerdictFreshness mGoodBearFreshness;
+
  private:
   ~LookupResult() = default;
 };
@@ -190,6 +211,13 @@ class LookupCache {
 
   const nsCString& TableName() const { return mTableName; }
 
+  bool RequiresFreshGoogleVerdict() const {
+    return GoodBearRequiresFreshGoogleVerdict(mTableName, mProvider);
+  }
+
+  GoodBearGoogleVerdictFreshness GoogleVerdictFreshness(
+      const Completion& aCompletion) const;
+
   // The directory handle where we operate will
   // be moved away when a backup is made.
   nsresult UpdateRootDirHandle(nsCOMPtr<nsIFile>& aRootStoreDirectory);
