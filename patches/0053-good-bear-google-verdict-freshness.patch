diff --git a/toolkit/components/url-classifier/tests/gtest/TestGoodBearGoogleFreshness.cpp b/toolkit/components/url-classifier/tests/gtest/TestGoodBearGoogleFreshness.cpp
new file mode 100644
index 0000000..134bdbc
--- /dev/null
+++ b/toolkit/components/url-classifier/tests/gtest/TestGoodBearGoogleFreshness.cpp
@@ -0,0 +1,230 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+#include "Common.h"
+#include "GoodBearGoogleVerdictFreshness.h"
+#include "LookupCacheV4.h"
+
+using ::RefPtr;
+using mozilla::TimeDuration;
+using mozilla::TimeStamp;
+
+namespace {
+
+constexpr int64_t kGoodBearTestWall = INT64_C(2000000000000000);
+
+static RefPtr<LookupCacheV4> GoodBearFreshnessCache(
+    const nsACString& aTable, const nsACString& aProvider,
+    uint8_t aPrefixSize = PREFIX_SIZE) {
+  nsCOMPtr<nsIFile> directory = GetFile(nsTArray<nsString>{u"safebrowsing"_ns});
+  RefPtr<LookupCacheV4> cache = new LookupCacheV4(aTable, aProvider, directory);
+  EXPECT_NS_SUCCEEDED(cache->Init());
+  _PrefixArray prefixes = {
+      CreatePrefixFromURL("goodbear-freshness.example/", aPrefixSize)};
+  EXPECT_NS_SUCCEEDED(BuildCache(cache, prefixes));
+  return cache;
+}
+
+static Completion GoodBearFreshnessHash() {
+  Completion completion;
+  EXPECT_NS_SUCCEEDED(
+      completion.FromPlaintext("goodbear-freshness.example/"_ns));
+  return completion;
+}
+
+static void GoodBearCacheResponse(
+    LookupCacheV4* aCache, const GoodBearGoogleVerdictFreshness& aFreshness,
+    int64_t aNegativeDurationSec = 7200, int64_t aPositiveDurationSec = 3600) {
+  FullHashResponseMap responses;
+  auto hash = GoodBearFreshnessHash();
+  auto* response = responses.GetOrInsertNew(hash.ToUint32());
+  response->negativeCacheExpirySec =
+      PR_Now() / PR_USEC_PER_SEC + aNegativeDurationSec;
+  response->mGoodBearFreshness = aFreshness;
+  response->fullHashes.InsertOrUpdate(
+      CreatePrefixFromURL("goodbear-freshness.example/", COMPLETE_SIZE),
+      PR_Now() / PR_USEC_PER_SEC + aPositiveDurationSec);
+  EXPECT_NS_SUCCEEDED(aCache->AddFullHashResponseToCache(responses));
+}
+
+static void GoodBearExpectCached(LookupCacheV4* aCache, bool aConfirmed) {
+  bool has = false;
+  bool confirmed = false;
+  uint32_t length = 0;
+  auto hash = GoodBearFreshnessHash();
+  EXPECT_NS_SUCCEEDED(aCache->Has(hash, &has, &length, &confirmed));
+  EXPECT_TRUE(has);
+  EXPECT_EQ(confirmed, aConfirmed);
+  EXPECT_TRUE(aCache->IsInCache(hash.ToUint32()));
+}
+
+}  // namespace
+
+TEST(GoodBearGoogleFreshness, ExactThirtyMinuteBoundary)
+{
+  auto start = TimeStamp::Now();
+  GoodBearGoogleVerdictFreshness freshness{start, kGoodBearTestWall};
+  EXPECT_TRUE(freshness.IsFreshAt(start, kGoodBearTestWall));
+  EXPECT_TRUE(freshness.IsFreshAt(start + TimeDuration::FromSeconds(1799.999),
+                                  kGoodBearTestWall + INT64_C(1799999000)));
+  EXPECT_TRUE(freshness.IsFreshAt(start + TimeDuration::FromSeconds(1800),
+                                  kGoodBearTestWall + INT64_C(1800000000)));
+  EXPECT_FALSE(
+      freshness.IsFreshAt(start + TimeDuration::FromMilliseconds(1800001),
+                          kGoodBearTestWall + INT64_C(1800001000)));
+}
+
+TEST(GoodBearGoogleFreshness, UnknownOrBackwardTimeNeverConfirms)
+{
+  auto start = TimeStamp::Now();
+  GoodBearGoogleVerdictFreshness freshness{start, kGoodBearTestWall};
+  EXPECT_FALSE(
+      GoodBearGoogleVerdictFreshness{}.IsFreshAt(start, kGoodBearTestWall));
+  EXPECT_FALSE(freshness.IsFreshAt(TimeStamp{}, kGoodBearTestWall));
+  EXPECT_FALSE(freshness.IsFreshAt(start, kGoodBearTestWall - 1));
+  EXPECT_FALSE(freshness.IsFreshAt(start - TimeDuration::FromMilliseconds(1),
+                                   kGoodBearTestWall));
+}
+
+TEST(GoodBearGoogleFreshness, RollbackCannotExtendMonotonicAge)
+{
+  auto start = TimeStamp::Now();
+  GoodBearGoogleVerdictFreshness freshness{start, kGoodBearTestWall};
+  EXPECT_FALSE(freshness.IsFreshAt(start + TimeDuration::FromSeconds(1801),
+                                   kGoodBearTestWall + PR_USEC_PER_SEC));
+}
+
+TEST(GoodBearGoogleFreshness, SleepCannotExtendWallAge)
+{
+  auto start = TimeStamp::Now();
+  GoodBearGoogleVerdictFreshness freshness{start, kGoodBearTestWall};
+  EXPECT_FALSE(freshness.IsFreshAt(start + TimeDuration::FromSeconds(1),
+                                   kGoodBearTestWall + INT64_C(1801000000)));
+}
+
+TEST(GoodBearGoogleFreshness, DelayedFinalCallbackRechecksBothConfirmedPaths)
+{
+  auto start = TimeStamp::Now();
+  RefPtr<LookupResult> result = new LookupResult();
+  result->mGoodBearRequiresFreshGoogleVerdict = true;
+  result->mGoodBearFreshness = {start, kGoodBearTestWall};
+  result->mConfirmed = true;
+  EXPECT_TRUE(result->ConfirmedAt(start, kGoodBearTestWall));
+  EXPECT_FALSE(
+      result->ConfirmedAt(start + TimeDuration::FromMilliseconds(1800001),
+                          kGoodBearTestWall + INT64_C(1800001000)));
+  result->mConfirmed = false;
+  result->mProtocolConfirmed = true;
+  EXPECT_TRUE(result->ConfirmedAt(start, kGoodBearTestWall));
+  EXPECT_FALSE(
+      result->ConfirmedAt(start + TimeDuration::FromMilliseconds(1800001),
+                          kGoodBearTestWall + INT64_C(1800001000)));
+}
+
+TEST(GoodBearGoogleFreshness,
+     DirectThirtyTwoByteGoogleMatchNeedsFreshCompletion)
+{
+  RefPtr<LookupResult> result = new LookupResult();
+  result->mPartialHashLength = COMPLETE_SIZE;
+  result->mGoodBearRequiresFreshGoogleVerdict =
+      GoodBearRequiresFreshGoogleVerdict("goog-malware-proto"_ns, ""_ns);
+  EXPECT_FALSE(result->ConfirmWithoutCompleter());
+  EXPECT_FALSE(result->Confirmed());
+  EXPECT_FALSE(result->mConfirmed);
+}
+
+TEST(GoodBearGoogleFreshness, NonGoogleCompleterFallbackAndShortHashUnchanged)
+{
+  RefPtr<LookupResult> result = new LookupResult();
+  result->mPartialHashLength = PREFIX_SIZE;
+  EXPECT_FALSE(result->ConfirmWithoutCompleter());
+  result->mPartialHashLength = COMPLETE_SIZE;
+  EXPECT_TRUE(result->ConfirmWithoutCompleter());
+  EXPECT_TRUE(result->Confirmed());
+}
+
+TEST(GoodBearGoogleFreshness, ProviderAndStartupTableScope)
+{
+  EXPECT_TRUE(
+      GoodBearRequiresFreshGoogleVerdict("custom-proto"_ns, "google5"_ns));
+  EXPECT_TRUE(
+      GoodBearRequiresFreshGoogleVerdict("custom-proto"_ns, "google4"_ns));
+  EXPECT_TRUE(
+      GoodBearRequiresFreshGoogleVerdict("custom-shavar"_ns, "google"_ns));
+  EXPECT_TRUE(
+      GoodBearRequiresFreshGoogleVerdict("googpub-phish-proto"_ns, ""_ns));
+  EXPECT_FALSE(GoodBearRequiresFreshGoogleVerdict("moztest-malware-proto"_ns,
+                                                  "test"_ns));
+  EXPECT_FALSE(GoodBearRequiresFreshGoogleVerdict("mozstd-track-digest256"_ns,
+                                                  "mozilla"_ns));
+}
+
+TEST(GoodBearGoogleFreshness, FreshPositiveAndStalePositivePreserveServerCache)
+{
+  auto cache = GoodBearFreshnessCache("goog-malware-proto"_ns, "google5"_ns);
+  GoodBearCacheResponse(cache, GoodBearGoogleVerdictFreshness::BeforeRequest());
+  GoodBearExpectCached(cache, true);
+  GoodBearCacheResponse(cache,
+                        {TimeStamp::Now(), PR_Now() - INT64_C(1801000000)});
+  GoodBearExpectCached(cache, false);
+  // An independent full hash sharing this prefix still uses the original
+  // negative cache lifetime. A stale positive must not disable that cache.
+  auto otherHash = GoodBearFreshnessHash();
+  otherHash.buf[COMPLETE_SIZE - 1] ^= 1;
+  bool has = true;
+  bool confirmed = true;
+  uint32_t length = 0;
+  EXPECT_NS_SUCCEEDED(cache->Has(otherHash, &has, &length, &confirmed));
+  EXPECT_FALSE(has);
+  EXPECT_FALSE(confirmed);
+}
+
+TEST(GoodBearGoogleFreshness, UnknownOldMetadataAndFullLengthPrefixNeedResponse)
+{
+  auto cache =
+      GoodBearFreshnessCache("goog-malware-proto"_ns, ""_ns, COMPLETE_SIZE);
+  GoodBearCacheResponse(cache, {});
+  GoodBearExpectCached(cache, false);
+  EXPECT_TRUE(cache->RequiresFreshGoogleVerdict());
+}
+
+TEST(GoodBearGoogleFreshness, FreshnessLimitDoesNotShortenServerCacheLifetime)
+{
+  auto cache = GoodBearFreshnessCache("goog-malware-proto"_ns, "google5"_ns);
+  GoodBearGoogleVerdictFreshness stale{TimeStamp::Now(),
+                                       PR_Now() - INT64_C(1801000000)};
+  GoodBearCacheResponse(cache, stale, 60, 3600);
+  GoodBearExpectCached(cache, false);
+  EXPECT_TRUE(cache->GoogleVerdictFreshness(GoodBearFreshnessHash()) == stale);
+}
+
+TEST(GoodBearGoogleFreshness, CloningDoesNotRenewAgeOrChangeServerExpiry)
+{
+  auto source = GoodBearFreshnessCache("goog-malware-proto"_ns, "google5"_ns);
+  auto target = GoodBearFreshnessCache("goog-malware-proto"_ns, "google5"_ns);
+  GoodBearGoogleVerdictFreshness stale{TimeStamp::Now(),
+                                       PR_Now() - INT64_C(1801000000)};
+  GoodBearCacheResponse(source, stale);
+  target->CopyFullHashCache(source);
+  EXPECT_TRUE(target->GoogleVerdictFreshness(GoodBearFreshnessHash()) == stale);
+  GoodBearExpectCached(target, false);
+  CachedFullHashResponse original;
+  original.negativeCacheExpirySec = 999999;
+  original.mGoodBearFreshness = stale;
+  original.fullHashes.InsertOrUpdate("preserved-hash"_ns, 123456);
+  CachedFullHashResponse copy;
+  copy = original;
+  EXPECT_TRUE(copy == original);
+  EXPECT_EQ(copy.negativeCacheExpirySec, 999999);
+  EXPECT_EQ(copy.fullHashes.Get("preserved-hash"_ns), 123456);
+}
+
+TEST(GoodBearGoogleFreshness, NonGooglePositiveCacheRetainsItsServerLifetime)
+{
+  auto cache =
+      GoodBearFreshnessCache("mozstd-track-digest256"_ns, "mozilla"_ns);
+  GoodBearCacheResponse(cache, {});
+  GoodBearExpectCached(cache, true);
+  EXPECT_FALSE(cache->RequiresFreshGoogleVerdict());
+}
