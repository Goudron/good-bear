     }
   }
 
@@ -1375,6 +1379,11 @@ nsUrlClassifierHashCompleterBase::CompletionV4(const nsACString& aPartialHash,
   result->table = aTableName;
   result->prefix.Assign(aPartialHash);
   result->response.negativeCacheExpirySec = nowSec + aNegativeCacheDuration;
+  nsAutoCString provider;
+  nsUrlClassifierUtils::GetInstance()->GetProvider(aTableName, provider);
