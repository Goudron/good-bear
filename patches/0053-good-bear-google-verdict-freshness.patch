+++ b/toolkit/components/url-classifier/tests/gtest/moz.build
@@ -17,6 +17,7 @@ UNIFIED_SOURCES += [
     "TestClassifier.cpp",
     "TestFailUpdate.cpp",
     "TestFindFullHash.cpp",
+    "TestGoodBearGoogleFreshness.cpp",
