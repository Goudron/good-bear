diff --git a/browser/components/contextualidentity/test/browser/browser_goodbear_user_agent.js b/browser/components/contextualidentity/test/browser/browser_goodbear_user_agent.js
new file mode 100644
--- /dev/null
+++ b/browser/components/contextualidentity/test/browser/browser_goodbear_user_agent.js
@@ -0,0 +1,60 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+add_task(
+  async function test_navigator_user_agent_matches_native_firefox_token() {
+    await SpecialPowers.pushPrefEnv({
+      clear: [["general.useragent.override"]],
+      set: [["privacy.userContext.enabled", true]],
+    });
+    const nativeUserAgent = Services.io
+      .getProtocolHandler("http")
+      .QueryInterface(Ci.nsIHttpProtocolHandler).userAgent;
+    const majorVersion = Services.appinfo.platformVersion.match(/^\d+/)[0];
+    ok(
+      nativeUserAgent.endsWith(" Firefox/" + majorVersion + ".0"),
+      "native HTTP identity preserves the reduced Firefox version"
+    );
+    ok(
+      !/Good\s*Bear\//i.test(nativeUserAgent),
+      "the compatibility token does not expose public Good Bear branding"
+    );
+
+    for (const userContextId of [0, 1]) {
+      await BrowserTestUtils.withNewTab(
+        {
+          gBrowser,
+          opening() {
+            gBrowser.selectedTab = BrowserTestUtils.addTab(
+              gBrowser,
+              "https://example.com/browser/browser/components/contextualidentity/test/browser/empty_file.html",
+              { userContextId }
+            );
+          },
+        },
+        async browser => {
+          is(
+            browser.browsingContext.originAttributes.userContextId,
+            userContextId,
+            "the requested context is actually exercised"
+          );
+          const navigatorUserAgent = await SpecialPowers.spawn(
+            browser,
+            [],
+            () => {
+              return content.navigator.userAgent;
+            }
+          );
+          is(
+            navigatorUserAgent,
+            nativeUserAgent,
+            "navigator and HTTP agree in context " + userContextId
+          );
+        }
+      );
+    }
+  }
+);
