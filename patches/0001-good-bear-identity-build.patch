+++ b/netwerk/test/unit/test_goodbear_user_agent.js
@@ -0,0 +1,85 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+const { AppConstants: UserAgentAppConstants } = ChromeUtils.importESModule(
+  "resource://gre/modules/AppConstants.sys.mjs"
+);
+
+const { HttpServer: UserAgentHttpServer } = ChromeUtils.importESModule(
+  "resource://testing-common/httpd.sys.mjs"
+);
+const USER_AGENT_OVERRIDE_PREF = "general.useragent.override";
+let userAgentServer;
+let userAgentRequestNumber = 0;
+
+add_setup(function setup_user_agent_echo_server() {
+  do_get_profile();
+  Services.prefs.clearUserPref(USER_AGENT_OVERRIDE_PREF);
+  userAgentServer = new UserAgentHttpServer();
+  userAgentServer.registerPathHandler("/user-agent", (request, response) => {
+    response.setHeader("Content-Type", "text/plain", false);
+    response.setHeader("Cache-Control", "no-store", false);
+    response.write(request.getHeader("User-Agent"));
+  });
+  userAgentServer.start(-1);
+  registerCleanupFunction(async () => {
+    Services.prefs.clearUserPref(USER_AGENT_OVERRIDE_PREF);
+    await new Promise(resolve => userAgentServer.stop(resolve));
+  });
+});
+
+function receivedUserAgent() {
+  const channel = NetUtil.newChannel({
+    uri:
+      "http://127.0.0.1:" +
+      userAgentServer.identity.primaryPort +
+      "/user-agent?request=" +
+      ++userAgentRequestNumber,
+    loadUsingSystemPrincipal: true,
+  });
+  return new Promise(resolve => {
+    channel.asyncOpen(
+      new ChannelListener((request, body) => resolve(body), null)
+    );
+  });
+}
+
+function assertFirefoxCompatibilityUserAgent(userAgent) {
+  const majorVersion = UserAgentAppConstants.MOZ_APP_VERSION.match(/^\d+/)[0];
+  Assert.ok(
+    userAgent.endsWith(" Firefox/" + majorVersion + ".0"),
+    "the server receives the upstream reduced Firefox compatibility token"
+  );
+  Assert.ok(
+    !/Good\s*Bear\//i.test(userAgent),
+    "public product branding is absent from the technical User-Agent"
+  );
+}
+
+add_task(
+  async function test_native_http_user_agent_preserves_firefox_compatibility() {
+    Assert.equal(
+      Services.prefs.getPrefType(USER_AGENT_OVERRIDE_PREF),
+      Ci.nsIPrefBranch.PREF_INVALID,
+      "native compatibility must work without a production preference override"
+    );
+    assertFirefoxCompatibilityUserAgent(await receivedUserAgent());
+  }
+);
+
+add_task(
+  async function test_clearing_override_never_restores_goodbear_product_token() {
+    const temporaryOverride = "GoodBear-UA-Regression-Sentinel/0";
+    Services.prefs.setStringPref(USER_AGENT_OVERRIDE_PREF, temporaryOverride);
+    Assert.equal(
+      await receivedUserAgent(),
+      temporaryOverride,
+      "the negative control observes the actual network preference override"
+    );
+    Services.prefs.clearUserPref(USER_AGENT_OVERRIDE_PREF);
+    assertFirefoxCompatibilityUserAgent(await receivedUserAgent());
+  }
+);
