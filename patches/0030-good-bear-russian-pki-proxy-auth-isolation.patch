+// Proxy authentication is normally shared between origin-attribute contexts
+// to avoid extra prompts. The managed Good Bear Russian PKI container is an
+// explicit exception: it must never send proxy credentials that were learned
+// outside the container, nor make its own credentials available elsewhere.
+// Ask the native runtime authority rather than trusting a profile preference
+// or a contextual-identity label.
+static bool ShouldIsolateGoodBearRussianPKIProxyAuth(nsIChannel* aChan) {
+  if (!aChan) {
+    return true;
+  }
+
+  OriginAttributes originAttributes;
+  StoragePrincipalHelper::GetOriginAttributesForNetworkState(
+      aChan, originAttributes);
+  if (originAttributes.mUserContextId == 0) {
+    return false;
+  }
+
+  nsCOMPtr<nsINSSComponent> nssComponent(
+      do_GetService(PSM_COMPONENT_CONTRACTID));
+  if (!nssComponent) {
+    // Never fall back to the shared proxy-auth cache for an unvalidated
+    // container identity. This exceptional path may ask another container to
+    // authenticate again, but it cannot disclose a cached credential.
+    return true;
+  }
+
+  bool isManagedContainer = false;
+  nsresult rv = nssComponent->IsGoodBearRussianPKIContainer(
+      originAttributes.mUserContextId,
+      originAttributes.mPrivateBrowsingId != 0, &isManagedContainer);
+  return NS_FAILED(rv) || isManagedContainer;
+}
+
+static void GetAuthCacheOriginSuffix(nsIChannel* aChan, bool aProxyAuth,
+                                     nsACString& aSuffix) {
+  // Keep Firefox's existing cache sharing for every other context. A missing
+  // or failed native scope lookup makes a contextual identity isolated rather
+  // than allowing it to reuse shared proxy credentials.
+  if (!aProxyAuth || ShouldIsolateGoodBearRussianPKIProxyAuth(aChan)) {
+    GetOriginAttributesSuffix(aChan, aSuffix);
+  }
+}
