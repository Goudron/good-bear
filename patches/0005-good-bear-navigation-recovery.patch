+++ b/browser/components/contextualidentity/test/browser/browser_goodbear_https_recovery.js
@@ -0,0 +1,54 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+"use strict";
+
+const RECOVERY_PATH = "/browser/browser/components/contextualidentity/test/browser/goodbear_https_recovery.sjs";
+const RECOVERY_CONTROL = "http://example.com" + RECOVERY_PATH;
+
+add_task(async function test_certificate_failure_never_replays_http_after_upgrade() {
+  for (const only of [false, true]) {
+    await SpecialPowers.pushPrefEnv({ set: [
+      ["dom.security.https_only_mode", only],
+      ["dom.security.https_first", !only],
+      ["dom.security.https_only_mode_send_http_background_request", false],
+    ] });
+    try {
+      // Port all six upstream bad-cert cases to observable failure assertions.
+      for (const host of ["nocert", "self-signed", "untrusted", "expired",
+                          "untrusted-expired", "no-subject-alt-name"]) {
+      await fetch(RECOVERY_CONTROL + "?reset");
+      await BrowserTestUtils.withNewTab("about:blank", async browser => {
+        const failed = BrowserTestUtils.waitForErrorPage(browser);
+        BrowserTestUtils.startLoadingURIString(browser,
+          `http://${host}.example.com` + RECOVERY_PATH + "?probe");
+        await failed;
+        await SpecialPowers.spawn(browser, [], () => {
+          ok(content.document.documentURI.startsWith("about:certerror") ||
+             content.document.documentURI.startsWith("about:neterror"),
+             "Retains precise TLS error; no HTTPS-Only HTTP continuation");
+        });
+        const events = await (await fetch(RECOVERY_CONTROL + "?count")).json();
+        is(events.length, 0, "Independent HTTP server received zero requests/body");
+      });
+      }
+    } finally {
+      await SpecialPowers.popPrefEnv();
+    }
+  }
+});
+
+add_task(async function test_http_observer_detects_real_requests() {
+  await SpecialPowers.pushPrefEnv({set:[
+    ["dom.security.https_only_mode", false], ["dom.security.https_first", false],
+  ]});
+  try {
+    await fetch(RECOVERY_CONTROL + "?reset");
+    await fetch(RECOVERY_CONTROL + "?positive", { method: "POST", body: "PUBLIC_TEST_ONLY" });
+    const events = await (await fetch(RECOVERY_CONTROL + "?count")).json();
+    is(events.length, 1, "Observer sees positive control");
+    is(events[0].method, "POST", "Observer identifies request method");
+    is(events[0].bodyBytes, 16, "Observer independently measures body bytes");
+  } finally {
+    await SpecialPowers.popPrefEnv();
+  }
+});
diff --git a/browser/components/contextualidentity/test/browser/browser_goodbear_russian_pki_navigation_network.js b/browser/components/contextualidentity/test/browser/browser_goodbear_russian_pki_navigation_network.js
