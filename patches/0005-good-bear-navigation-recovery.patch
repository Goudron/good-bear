diff --git a/browser/actors/GoodBearRussianPKICertificateErrorChild.sys.mjs b/browser/actors/GoodBearRussianPKICertificateErrorChild.sys.mjs
new file mode 100644
--- /dev/null
+++ b/browser/actors/GoodBearRussianPKICertificateErrorChild.sys.mjs
@@ -0,0 +1,121 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+function hasRequestBody(httpChannel, method) {
+  if (method !== "GET" && method !== "HEAD") {
+    return true;
+  }
+  try {
+    // Presence only: never read, clone or serialize the upload stream.
+    return (
+      httpChannel.QueryInterface(Ci.nsIUploadChannel).uploadStream !== null
+    );
+  } catch {
+    return true;
+  }
+}
+
+function getAssignedPolicyRoutingCandidate(docShell) {
+  const channel = docShell.failedChannel;
+  if (
+    !channel ||
+    channel.status !== Cr.NS_ERROR_BLOCKED_BY_POLICY ||
+    channel.loadInfo?.externalContentPolicyType !==
+      Ci.nsIContentPolicy.TYPE_DOCUMENT ||
+    channel.loadInfo.originAttributes?.privateBrowsingId !== 0 ||
+    channel.loadInfo.originAttributes?.userContextId !== 0
+  ) {
+    return null;
+  }
+  try {
+    const http = channel.QueryInterface(Ci.nsIHttpChannel);
+    const method = http.requestMethod?.toUpperCase();
+    if (channel.URI?.scheme !== "https" || !channel.URI.asciiHost || !method) {
+      return null;
+    }
+    return {
+      url: channel.URI.spec,
+      method,
+      hasRequestBody: hasRequestBody(http, method),
+    };
+  } catch {
+    return null;
+  }
+}
+
+function getRussianPKIRoutingCandidate(docShell) {
+  const failedChannel = docShell.failedChannel;
+  if (!failedChannel) {
+    return null;
+  }
+
+  const securityInfo = failedChannel.securityInfo;
+  // This flag is authored only by native PSM after exact-anchor verification.
+  // It deliberately accompanies a failed TLS result, never a usable channel.
+  // Do not couple routing to errorCodeString: it is presentation metadata
+  // produced after PSM's verification result and may vary with the error-page
+  // mapping. This is a failed-TLS routing hint, never channel authority.
+  // The parent rechecks the live managed scope before any address transfer.
+  if (!securityInfo?.goodBearRussianPKIRequired) {
+    return null;
+  }
+
+  let httpChannel;
+  try {
+    httpChannel = failedChannel.QueryInterface(Ci.nsIHttpChannel);
+  } catch {
+    return null;
+  }
+
+  const uri = failedChannel.URI;
+  const method = httpChannel.requestMethod?.toUpperCase();
+  if (!uri || uri.scheme !== "https" || !uri.asciiHost || !method) {
+    return null;
+  }
+  return {
+    url: uri.spec,
+    method,
+    hasRequestBody: hasRequestBody(httpChannel, method),
+  };
+}
+
+export class GoodBearRussianPKICertificateErrorChild extends JSWindowActorChild {
+  receiveMessage(message) {
+    if (message.name !== "GoodBear:GetFailedChannelCertificates") {
+      return null;
+    }
+    const candidate = getRussianPKIRoutingCandidate(this.docShell);
+    if (
+      !candidate ||
+      candidate.url !== message.data?.url ||
+      this.manager.innerWindowId !== message.data?.innerWindowId
+    ) {
+      return null;
+    }
+    // These are the peer's actual handshake certificates for native viewing,
+    // not a claim that the ordinary-context chain was successfully verified.
+    const certificates =
+      this.docShell.failedChannel.securityInfo.handshakeCertificates;
+    return certificates?.length
+      ? certificates.map(cert => cert.getBase64DERString())
+      : null;
+  }
+
+  handleEvent(event) {
+    if (event.type !== "DOMContentLoaded" || event.target !== this.document) {
+      return;
+    }
+    const candidate = getRussianPKIRoutingCandidate(this.docShell);
+    if (candidate) {
+      this.sendAsyncMessage("GoodBear:RussianPKICertificateError", candidate);
+      return;
+    }
+    const assignedCandidate = getAssignedPolicyRoutingCandidate(this.docShell);
+    if (assignedCandidate) {
+      this.sendAsyncMessage("GoodBear:AssignedPolicyError", assignedCandidate);
+    }
+  }
+}
+
+export { getRussianPKIRoutingCandidate, getAssignedPolicyRoutingCandidate };
diff --git a/browser/actors/GoodBearRussianPKICertificateErrorParent.sys.mjs b/browser/actors/GoodBearRussianPKICertificateErrorParent.sys.mjs
new file mode 100644
--- /dev/null
+++ b/browser/actors/GoodBearRussianPKICertificateErrorParent.sys.mjs
@@ -0,0 +1,93 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const lazy = {};
+
+ChromeUtils.defineESModuleGetters(lazy, {
+  GoodBearRussianPKINavigationPolicy: "resource:///modules/BrowserGlue.sys.mjs",
+});
+
+export class GoodBearRussianPKICertificateErrorParent extends JSWindowActorParent {
+  getCertificateViewer(url) {
+    const windowGlobal = this.manager;
+    const innerWindowId = windowGlobal.innerWindowId;
+    const browser = this.browsingContext.embedderElement;
+    if (
+      !this._candidateURL ||
+      url !== this._candidateURL ||
+      this.browsingContext !== this.browsingContext.top ||
+      this.browsingContext.currentWindowGlobal !== windowGlobal
+    ) {
+      return null;
+    }
+    return async isCurrent => {
+      if (
+        !isCurrent() ||
+        this.browsingContext.currentWindowGlobal !== windowGlobal
+      ) {
+        return;
+      }
+      const certificates = await this.sendQuery(
+        "GoodBear:GetFailedChannelCertificates",
+        {
+          url,
+          innerWindowId,
+        }
+      );
+      if (
+        !isCurrent() ||
+        this.manager !== windowGlobal ||
+        this.browsingContext.currentWindowGlobal !== windowGlobal ||
+        windowGlobal.innerWindowId !== innerWindowId ||
+        this.browsingContext.embedderElement !== browser ||
+        !Array.isArray(certificates) ||
+        !certificates.length ||
+        certificates.some(cert => typeof cert !== "string" || !cert)
+      ) {
+        return;
+      }
+      windowGlobal.getActor("NetError").viewCertificate(certificates);
+    };
+  }
+
+  receiveMessage(message) {
+    if (
+      message.name !== "GoodBear:RussianPKICertificateError" &&
+      message.name !== "GoodBear:AssignedPolicyError"
+    ) {
+      return;
+    }
+    // Only a top-level privileged certificate error can request the new
+    // context. A subframe may never cause a container navigation.
+    if (this.browsingContext !== this.browsingContext.top) {
+      return;
+    }
+    const browser = this.browsingContext.embedderElement;
+    if (this.browsingContext.currentWindowGlobal !== this.manager) {
+      return;
+    }
+    if (message.name === "GoodBear:AssignedPolicyError") {
+      // A policy-stopped request is not a certificate verification result.
+      this._candidateURL = null;
+      lazy.GoodBearRussianPKINavigationPolicy.openAddressOnlyAfterAssignedPolicyError(
+        browser,
+        message.data?.url,
+        message.data?.method,
+        message.data?.hasRequestBody !== false,
+        this.manager,
+        this.manager.innerWindowId
+      );
+      return;
+    }
+    this._candidateURL = message.data?.url;
+    lazy.GoodBearRussianPKINavigationPolicy.openAddressOnlyAfterRussianPKICertificateError(
+      browser,
+      message.data?.url,
+      message.data?.method,
+      message.data?.hasRequestBody !== false,
+      this.manager,
+      this.manager.innerWindowId
+    );
+  }
+}
