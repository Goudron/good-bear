diff --git a/browser/base/content/goodbearRussianPKIInterstitial.js b/browser/base/content/goodbearRussianPKIInterstitial.js
new file mode 100644
--- /dev/null
+++ b/browser/base/content/goodbearRussianPKIInterstitial.js
@@ -0,0 +1,51 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+document.mozSubdialogReady = new Promise(resolve => {
+  document.addEventListener(
+    "DOMContentLoaded",
+    () => {
+      const model = window.arguments?.[0];
+      if (!model || typeof model.choose !== "function") {
+        window.close();
+        resolve();
+        return;
+      }
+      for (const [id, value] of [
+        ["title", model.title],
+        ["description", model.description],
+        ["body-description", model.bodyDescription],
+        ["open", model.openLabel],
+        ["back", model.backLabel],
+        ["certificate", model.certificateLabel],
+      ]) {
+        document.getElementById("goodbear-interstitial-" + id).textContent =
+          value;
+      }
+      document.title = model.title;
+      document.getElementById("goodbear-interstitial-body-description").hidden =
+        !model.bodyDescription;
+      for (const action of ["back", "certificate", "open"]) {
+        const button = document.getElementById(
+          "goodbear-interstitial-" + action
+        );
+        button.disabled = action === "certificate" && !model.canViewCertificate;
+        button.addEventListener("click", async event => {
+          if (!event.isTrusted) {
+            return;
+          }
+          button.disabled = true;
+          if (await model.choose(action)) {
+            window.close();
+          } else if (action === "certificate" && !window.closed) {
+            button.disabled = !model.canViewCertificate;
+          }
+        });
+      }
+      document.getElementById("goodbear-interstitial-back").focus();
+      resolve();
+    },
+    { once: true }
+  );
+});
