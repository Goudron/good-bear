+  );
+  container.append(title, description, back);
+  document.body.replaceChildren(container);
+  try {
+    await document.l10n.translateElements([title, description, back]);
+    if ([title, description, back].some(element =>
+      !element.textContent.trim() ||
+      element.textContent.trim() === element.getAttribute("data-l10n-id")
+    )) {
+      throw new Error("Missing Good Bear policy message");
+    }
+  } catch {
+    // Last-resort ru-only recovery, not an English localization fallback.
+    // No certificate-validity claim is made when localization is unavailable.
+    for (const element of [title, description, back]) {
+      element.removeAttribute("data-l10n-id");
