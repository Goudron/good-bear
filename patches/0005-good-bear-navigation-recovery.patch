+// A TLS validation/access failure is not evidence that HTTP is safe. Keep the
+// native certificate/access error page, including missing typed metadata. A
+// successful Russian PKI channel likewise never grants a downgrade. This uses
+// native result fields, not the presentation-only policy-denied flag.
+static bool GoodBearBlocksHTTPSDowngrade(nsIChannel* aChannel) {
+  if (!aChannel) {
+    return false;
+  }
+  nsCOMPtr<nsITransportSecurityInfo> info;
+  if (NS_FAILED(aChannel->GetSecurityInfo(getter_AddRefs(info)))) {
+    return true;
+  }
+  if (!info) {
+    return false;  // No TLS result: retain ordinary connection-error recovery.
+  }
+  int32_t error = 0;
+  using Domain = nsITransportSecurityInfo::GoodBearTrustDomain;
+  Domain domain = Domain::Invalid;
+  return NS_FAILED(info->GetErrorCode(&error)) ||
+         NS_FAILED(info->GetGoodBearTrustDomain(&domain)) || error != 0 ||
+         domain != Domain::Standard;
+}

