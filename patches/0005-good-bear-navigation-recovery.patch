@@ -0,0 +1,34 @@
+const ORIGIN = "https://example.com";
+const PATH =
+  "/browser/browser/components/contextualidentity/test/browser/goodbear_russian_pki_navigation.sjs";
+
+function requestHeader(aRequest, name) {
+  return aRequest.hasHeader(name) ? aRequest.getHeader(name) : "";
+}
+
+function attribute(value) {
+  return String(value)
+    .replaceAll("&", "&amp;")
+    .replaceAll('"', "&quot;")
+    .replaceAll("<", "&lt;");
+}
+
+function handleRequest(aRequest, aResponse) {
+  const mode = new URLSearchParams(aRequest.queryString).get("mode");
+  if (mode === "redirect") {
+    aResponse.setStatusLine(aRequest.httpVersion, 302, "Found");
+    aResponse.setHeader("Location", `${ORIGIN}${PATH}?mode=report`, false);
+    return;
+  }
+
+  aResponse.setHeader("Content-Type", "text/html", false);
+  aResponse.setStatusLine(aRequest.httpVersion, 200, "OK");
+  aResponse.write(`<!doctype html>
+    <meta charset="utf-8">
+    <body data-cookie="${attribute(requestHeader(aRequest, "Cookie"))}"
+          data-referrer="${attribute(requestHeader(aRequest, "Referer"))}">
+      <script>
+        document.body.dataset.opener = window.opener ? "present" : "absent";
+      </script>
+    </body>`);
+}
