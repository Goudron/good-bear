+// The counters are supplied by the bounded owner of a verification policy
+// snapshot. They deliberately record paths, not certificate names, hosts, or
+// origin attributes. A later telemetry owner may export aggregate values, but
+// must never use them to make a trust decision.
+struct GoodBearRussianPKIVerificationCounters final {
+  uint64_t mStandardResults = 0;
+  uint64_t mSecondaryChecks = 0;
+  uint64_t mSecondarySuccesses = 0;
+
+  void RecordStandardResult() { ++mStandardResults; }
+  void RecordSecondaryCheck(mozilla::pkix::Result aResult) {
+    ++mSecondaryChecks;
+    if (aResult == mozilla::pkix::Success) {
+      ++mSecondarySuccesses;
+    }
+  }
+};
