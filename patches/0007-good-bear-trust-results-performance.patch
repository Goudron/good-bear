 TEST(psm_GoodBearRussianPKIVerifier,
+     SecondaryCheckCountersDoNotGrantOrReuseTrust)
+{
+  GoodBearRussianPKIContainerScope scope{true, Some(17U)};
+  GoodBearRussianPKIVerificationCounters counters;
+  auto authorize = [&](const OriginAttributes& aOriginAttributes) {
+    return scope.Allows(aOriginAttributes);
+  };
+
+  auto accepted = ClassifyGoodBearContainerServerCertificate(
+      PKIXResult::ERROR_UNKNOWN_ISSUER, ChannelAttributes(17), authorize,
+      []() { return Success; }, &counters);
+  ASSERT_EQ(GoodBearTrustDomain::RussianPKI, accepted.mTrustDomain);
+  ASSERT_EQ(0U, counters.mStandardResults);
+  ASSERT_EQ(1U, counters.mSecondaryChecks);
+  ASSERT_EQ(1U, counters.mSecondarySuccesses);
+
+  auto rejected = ClassifyGoodBearContainerServerCertificate(
+      PKIXResult::ERROR_UNKNOWN_ISSUER, ChannelAttributes(18), authorize,
+      []() { return Success; }, &counters);
+  ASSERT_EQ(GoodBearTrustDomain::Invalid, rejected.mTrustDomain);
+  ASSERT_EQ(1U, counters.mSecondaryChecks);
+  ASSERT_EQ(1U, counters.mSecondarySuccesses);
+}
