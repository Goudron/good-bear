+add_task(async function test_localized_address_only_prompt_choices() {
+  const { sinon } = ChromeUtils.importESModule(
+    "resource://testing-common/Sinon.sys.mjs"
+  );
+  const l10n = new Localization(["browser/browser.ftl"], true);
+  const prompt = sinon.stub(Services.prompt, "confirmEx");
+  try {
+    for (const hasRequestBody of [false, true]) {
+      for (const trustSourceChanged of [false, true]) {
+        const expected = l10n.formatValuesSync([
+          trustSourceChanged
+            ? "goodbear-russian-pki-prompt-trust-changed-title"
+            : "goodbear-russian-pki-prompt-title",
+          {
+            "false,false": "goodbear-russian-pki-prompt-address",
+            "false,true": "goodbear-russian-pki-prompt-body",
+            "true,false": "goodbear-russian-pki-prompt-trust-changed-address",
+            "true,true": "goodbear-russian-pki-prompt-trust-changed-body",
+          }[`${trustSourceChanged},${hasRequestBody}`],
+          trustSourceChanged
+            ? "goodbear-russian-pki-prompt-open-isolated"
+            : "goodbear-russian-pki-prompt-open-address",
+          "goodbear-russian-pki-prompt-go-back",
+        ]);
+        ok(
+          expected.every(value => value?.trim()),
+          "all consent strings resolve"
+        );
+        for (const selected of [0, 1, 2]) {
+          prompt.resetHistory();
+          prompt.returns(selected);
+          is(
+            GoodBearRussianPKINavigationPolicy._promptAddressOnlyOpen(
+              window,
+              hasRequestBody,
+              trustSourceChanged
+            ),
+            selected,
+            "localized prompt preserves open, back and dismissal results"
+          );
+          const args = prompt.firstCall.args;
+          Assert.deepEqual(
+            [args[1], args[2], args[4], args[5]],
+            expected,
+            "native prompt receives Fluent values for this security decision"
+          );
+          is(
+            args.length,
+            9,
+            "no URL or request state is added to prompt arguments"
+          );
+        }
+      }
+    }
+  } finally {
+    prompt.restore();
+  }
+});
+
+add_task(
+  async function test_prompt_localization_failure_never_opens_destination() {
+    const policy = GoodBearRussianPKINavigationPolicy;
+    const originalOpen = policy._openAddressOnlyInContainer;
+    let opened = 0;
+    let wentBack = 0;
+    policy._openAddressOnlyInContainer = () => opened++;
+    const browser = { goBack: () => wentBack++ };
+    try {
+      for (const failedValues of [
+        null,
+        [],
+        ["title", null, "open", "back"],
+        ["title", " ", "open", "back"],
+      ]) {
+        const promptWindow = {
+          Localization: class {
+            formatValuesSync() {
+              if (failedValues === null) {
+                throw new Error("test-only localization failure");
+              }
+              return failedValues;
+            }
+          },
+        };
+        for (const hasRequestBody of [false, true]) {
+          for (const trustSourceChanged of [false, true]) {
+            policy._handleAddressOnlyChoice(
+              promptWindow,
+              browser,
+              "https://must-not-open.example.test/",
+              17,
+              true,
+              hasRequestBody,
+              false,
+              trustSourceChanged
+            );
+          }
+        }
+      }
+      is(
+        opened,
+        0,
+        "a missing localized choice never authorizes any navigation"
+      );
+      is(
+        wentBack,
+        0,
+        "localization failure does not manufacture a Back decision"
+      );
+    } finally {
+      policy._openAddressOnlyInContainer = originalOpen;
+    }
+  }
+);
