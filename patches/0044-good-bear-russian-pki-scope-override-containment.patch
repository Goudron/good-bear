 TEST(psm_GoodBearRussianPKIVerifier,
+     ScopeRevocationCannotResumeThroughExistingCertificateOverride)
+{
+  for (bool recreateContainer : {false, true}) {
+    GoodBearRussianPKIContainerScope scope{true, Some(17U)};
+    auto attributes = ChannelAttributes(17);
+    const bool startedInManagedContainer = scope.Allows(attributes);
+    ASSERT_TRUE(startedInManagedContainer);
+    auto result = ClassifyGoodBearContainerServerCertificate(
+        PKIXResult::ERROR_UNKNOWN_ISSUER, attributes,
+        [&](const OriginAttributes& aOriginAttributes) {
+          return scope.Allows(aOriginAttributes);
+        },
+        [&]() {
+          if (recreateContainer) {
+            scope.mDedicatedUserContextId = Some(23U);
+          } else {
+            scope.mEnabled = false;
+          }
+          return Success;
+        });
+    ASSERT_FALSE(result.ChannelUsable());
+
+    bool overrideCalled = false;
+    PRErrorCode finalError = ResolveGoodBearCertificateOverride(
+        GoodBearOrdinaryTrustClassification::Invalid, startedInManagedContainer,
+        result.mResult, SEC_ERROR_UNKNOWN_ISSUER, [&]() -> PRErrorCode {
+          overrideCalled = true;
+          return 0;  // Firefox found a matching saved exception.
+        });
+    ASSERT_FALSE(overrideCalled);
+    ASSERT_EQ(SEC_ERROR_UNKNOWN_ISSUER, finalError);
+  }
+}
+
+TEST(psm_GoodBearRussianPKIVerifier,
+     ScopeRevocationBeforeAlternateCheckCannotUseCertificateOverride)
+{
+  GoodBearRussianPKIContainerScope scope{true, Some(17U)};
+  auto attributes = ChannelAttributes(17);
+  const bool startedInManagedContainer = scope.Allows(attributes);
+  scope.mEnabled = false;
+  bool alternateCalled = false;
+  auto result = ClassifyGoodBearContainerServerCertificate(
+      PKIXResult::ERROR_UNKNOWN_ISSUER, attributes,
+      [&](const OriginAttributes& aOriginAttributes) {
+        return scope.Allows(aOriginAttributes);
+      },
+      [&]() {
+        alternateCalled = true;
+        return Success;
+      });
+  ASSERT_FALSE(alternateCalled);
+  ASSERT_FALSE(result.ChannelUsable());
+  bool overrideCalled = false;
+  ASSERT_EQ(SEC_ERROR_UNKNOWN_ISSUER,
+            ResolveGoodBearCertificateOverride(
+                GoodBearOrdinaryTrustClassification::Invalid,
+                startedInManagedContainer, result.mResult,
+                SEC_ERROR_UNKNOWN_ISSUER, [&]() -> PRErrorCode {
+                  overrideCalled = true;
+                  return 0;
+                }));
+  ASSERT_FALSE(overrideCalled);
+}
+
+TEST(psm_GoodBearRussianPKIVerifier,
+     OrdinaryInvalidCertificatesRetainUpstreamOverridePolicy)
+{
+  bool overrideCalled = false;
+  auto ordinary = ClassifyGoodBearOrdinaryServerCertificate(
+      PKIXResult::ERROR_UNKNOWN_ISSUER,
+      []() { return PKIXResult::ERROR_BAD_SIGNATURE; });
+  ASSERT_EQ(0, ResolveGoodBearCertificateOverride(
+                   ordinary.mClassification, false, ordinary.mOriginalResult,
+                   SEC_ERROR_UNKNOWN_ISSUER, [&]() -> PRErrorCode {
+                     overrideCalled = true;
+                     return 0;
+                   }));
+  ASSERT_TRUE(overrideCalled);
+  overrideCalled = false;
+  ASSERT_EQ(SEC_ERROR_UNKNOWN_ISSUER,
+            ResolveGoodBearCertificateOverride(
+                ordinary.mClassification, false, ordinary.mOriginalResult,
+                SEC_ERROR_UNKNOWN_ISSUER, [&]() -> PRErrorCode {
+                  overrideCalled = true;
+                  return SEC_ERROR_UNKNOWN_ISSUER;
+                }));
+  ASSERT_TRUE(overrideCalled);
+}
+
+TEST(psm_GoodBearRussianPKIVerifier,
+     StandardSuccessAndRussianRoutingNeverConsultCertificateOverrides)
+{
+  bool overrideCalled = false;
+  auto savedOverride = [&]() -> PRErrorCode {
+    overrideCalled = true;
+    return 0;
+  };
+  ASSERT_EQ(0, ResolveGoodBearCertificateOverride(
+                   GoodBearOrdinaryTrustClassification::Standard, false,
+                   Success, 0, savedOverride));
+  ASSERT_FALSE(overrideCalled);
+  auto ordinary = ClassifyGoodBearOrdinaryServerCertificate(
+      PKIXResult::ERROR_UNKNOWN_ISSUER, []() { return Success; });
+  ASSERT_EQ(SEC_ERROR_UNKNOWN_ISSUER,
+            ResolveGoodBearCertificateOverride(
+                ordinary.mClassification, false, ordinary.mOriginalResult,
+                SEC_ERROR_UNKNOWN_ISSUER, savedOverride));
+  ASSERT_FALSE(overrideCalled);
+}
