  "rebase_audit": {
    "from_version": "155.0.1",
    "from_revision": "fb95137a04eb8fe1196cb12f26b100c1e060295c",
    "to_version": "156.0",
    "to_revision": "3bf8f468258c2181f455e23d4ffcd6acb8f4cdb1",
    "evidence_kind": "static_named_owner_diff_only_not_runtime_outbound_evidence",
    "owner_dispositions": {
      "browser/moz.configure": {
        "disposition": "preserve_upstream_with_good_bear_overrides",
        "review": "Preserve new package-manifest defines and package input configuration. Keep Good Bear MOZ_SERVICES_HEALTHREPORT, MOZ_SERVICES_SYNC and MOZ_NORMANDY disabled; the new packaging code introduces no hosted endpoint."
      },
      "browser/app/profile/firefox.js": {
        "disposition": "preserve_upstream_with_good_bear_overrides",
        "review": "Explicitly disable the new enabled Relay promo and FxA client-info ping. New Smart Window AITab and agent-toolbar defaults are false and its development viewer URL is empty; browser.smartwindow.enabled remains false. Removed World Cup and lightweight-theme endpoints require no replacement. FxA pairing-version and VPN l10n/hasSeenFeature controls do not override Good Bear account, pairing, IP Protection and endpoint disables. Stable-channel net-error search CTA remains false; Nimbus rollouts and remote messaging remain disabled. Local tab, startup, URL-bar and autocomplete changes are preserved."
      },
      "modules/libpref/init/all.js": {
        "disposition": "preserve_upstream_with_good_bear_overrides",
        "review": "Dynamic remote-agent startup defaults false; retain its new connection prompt and banner safeguards. ML autofill twoHead and timeoutMS are subordinate settings, not disabled features: Windows useml defaults true for non-release/non-esr channels, including goodbear, so explicitly override useml=false while the model supplier is unpinned. Keep local address/card autofill and upstream accessibility behavior; new CVV autofill defaults false."
      },
      "services/settings/Utils.sys.mjs": {
        "disposition": "preserve_upstream_security_behavior",
        "review": "Preserve moving request-option destructuring before the fallback callback. The one-retry proxy fallback still respects bypassProxy, shutdown and offline state; this change does not authorize a supplier or relax endpoint disposition."
      },
      "services/settings/RemoteSettingsClient.sys.mjs": {
        "disposition": "preserve_upstream_security_behavior",
        "review": "Preserve MissingSignatureError when no signature is usable, treat local verification exceptions as untrustworthy, and restore only verified prior records after failed updates; otherwise clear or restore the bundled dump and propagate failure. Retain upstream OneCRL/CRLite and intermediate security protection without disabling signature verification. Supplier review remains an explicit release blocker; source review does not prove fresh runtime revocation data."
      },
      "security/manager/ssl/RemoteSecuritySettings.sys.mjs": {
        "disposition": "preserve_upstream_security_behavior",
        "review": "The native security-state clients select onecrl, intermediates and cert-revocations with the onecrl.content-signature.mozilla.org signer. Correct the stale crlite-filters collection name in audit metadata only; preserve the native client, enabled preferences, signature checks and attachment validation. Supplier approval and fresh signed-update runtime evidence remain pending."
      }
    }
  },
