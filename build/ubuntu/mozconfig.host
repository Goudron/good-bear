# Local Ubuntu host configuration for Good Bear development builds.
#
# The host compiler remains the Ubuntu-selected clang.  WASM sandboxed
# libraries must use the project-pinned WASI SDK instead: the Ubuntu WASI
# libc++abi package does not provide the exception ABI required by RLBox's
# C++ sandbox libraries.
goodbear_root=$(cd "$topsrcdir/../../.." && pwd)
goodbear_wasi_sdk="$goodbear_root/artifacts/toolchains/current/wasi-sdk"

. $topsrcdir/build/goodbear/mozconfig
# Development and intermediate verification deliberately avoid cross-language
# or Rust link-time optimization. `--disable-release` enables Firefox's
# developer options, which also suppress the unconditional release-profile
# Rust LTO and enables Cargo's incremental cache. The single full-LTO release
# build is reserved for final M13 after all ordinary checks are green; see the
# product backlog build-time policy.
unset MOZ_LTO
ac_add_options --disable-release
ac_add_options --host=x86_64-unknown-linux-gnu
ac_add_options --with-l10n-base="$goodbear_root/source/l10n/firefox-l10n"
ac_add_options --with-wasi-sysroot="$goodbear_wasi_sdk/share/wasi-sysroot"
mk_add_options MOZ_CO_LOCALES=ru
# Keep every host build, including `mach gtest`, within the user-selected
# three-way compilation limit.
mk_add_options MOZ_PARALLEL_BUILD=4

# Keep compilation at Firefox's default en-US input. A non-en-US
# --enable-ui-locale belongs to the localized repack target, not a plain
# `mach build`: that target supplies jar_maker with the merged locale tree.
# The host workflow performs `installers-ru` after the internal base package;
# only that Russian artifact is a Good Bear output candidate.

export WASI_SYSROOT="$goodbear_wasi_sdk/share/wasi-sysroot"
export WASM_CC="$goodbear_wasi_sdk/bin/clang"
export WASM_CXX="$goodbear_wasi_sdk/bin/clang++"
export CBINDGEN="$goodbear_root/artifacts/toolchains/current/cbindgen/bin/cbindgen"
